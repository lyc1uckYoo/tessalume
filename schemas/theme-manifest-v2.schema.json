{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessalume.local/schemas/theme-manifest-v2.json",
  "title": "Tessalume open theme manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "engineVersion", "type", "capabilities", "entryPoints"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}$" },
    "author": { "type": "string", "maxLength": 100 },
    "description": { "type": "string", "maxLength": 500 },
    "engineVersion": { "const": 2 },
    "type": { "const": "advanced" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "style"],
      "properties": {
        "id": { "const": "flagship" },
        "version": { "const": "1.0" },
        "style": { "const": "shared" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": { "type": "boolean" },
        "dark": { "type": "boolean" }
      }
    },
    "entryPoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "css": { "type": "string", "minLength": 1 },
        "script": { "type": "string", "minLength": 1 }
      }
    },
    "previews": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "light": { "type": "string" },
        "dark": { "type": "string" }
      }
    },
    "assets": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "config": {
      "type": "object",
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "petOverlay": { "type": "boolean", "default": false }
      }
    }
  },
  "allOf": [
    { "properties": { "entryPoints": { "required": ["script"] } } }
  ]
}
