{
  "$schema": "../../../schemas/theme-manifest-v2.schema.json",
  "schemaVersion": 2,
  "id": "hiyuki.crimson-snow",
  "name": "绯雪 · 常世预见",
  "version": "1.0",
  "author": "lyc1uckYoo",
  "description": "基于 Tessalume 旗舰主题模板 1.0 的绯雪双形态主题。亮色以常世身、晨雪与守愿居合构成，暗色以冰蓝预求身、镜面时停与归刃展开；任务页保留愿望档案、常世/预求双卡，并加入专属预求铃阵与迅刀「灼霜」动效。",
  "engineVersion": 2,
  "type": "advanced",
  "template": {
    "id": "flagship",
    "version": "1.0",
    "style": "shared"
  },
  "capabilities": {
    "light": true,
    "dark": true
  },
  "entryPoints": {
    "css": "skin.css",
    "script": "theme.js"
  },
  "previews": {
    "light": "assets/hero-light.png",
    "dark": "assets/hero-dark.png"
  },
  "assets": {
    "hero-light": "assets/hero-light.png",
    "hero-dark": "assets/hero-dark.png",
    "sidebar-light": "assets/sidebar-light.png",
    "sidebar-dark": "assets/sidebar-dark.png",
    "chat-light": "assets/chat-light.png",
    "chat-dark": "assets/chat-dark.png",
    "task-left": "assets/task-left.png",
    "task-right-secondary": "assets/task-right-secondary.png",
    "task-right-primary": "assets/task-right-primary.png",
    "memory-light": "assets/memory-light.png",
    "memory-dark": "assets/memory-dark.png"
  },
  "config": {
    "title": "绯雪 · 常世预见",
    "subtitle": "在常世守住所珍视之人，于预见之境斩开所有未至的冬日。",
    "status": "PRESENT SELF · FORECLAIMED",
    "memory": "愿望不是需要遗忘的负担。把它系在刀鞘上，直到未来真正抵达。"
  },
  "compatibility": {
    "petOverlay": false
  }
}
