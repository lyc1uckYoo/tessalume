{
  "$schema": "../../../schemas/theme-manifest-v2.schema.json",
  "schemaVersion": 2,
  "id": "aemeath.star-voyage",
  "name": "爱弥斯 · 星海远航",
  "version": "1.0",
  "author": "lyc1uckYoo",
  "description": "以爱弥斯、电子幽灵与隧者兵装为核心的旗舰主题。亮色描绘星炬学院晨光远航，暗色进入隧者核心与深空链接；右下双卡上方加入真实机制同步面板，左下角呈现专属长剑「永远的启明星」。",
  "engineVersion": 2,
  "type": "advanced",
  "template": {
    "id": "flagship",
    "version": "1.0",
    "style": "shared"
  },
  "capabilities": {
    "light": true,
    "dark": true
  },
  "entryPoints": {
    "css": "skin.css",
    "script": "theme.js",
    "artworkDefaults": "artwork-defaults.json"
  },
  "previews": {
    "light": "assets/hero-light.png",
    "dark": "assets/hero-dark.png"
  },
  "assets": {
    "hero-light": "assets/hero-light.png",
    "hero-dark": "assets/hero-dark.png",
    "sidebar-light": "assets/sidebar-light.png",
    "sidebar-dark": "assets/sidebar-dark.png",
    "chat-light": "assets/chat-light.png",
    "chat-dark": "assets/chat-dark.png",
    "task-left": "assets/task-left.png",
    "task-left-dark": "assets/task-left-dark.png",
    "task-right-secondary": "assets/task-right-secondary.png",
    "task-right-secondary-dark": "assets/task-right-secondary-dark.png",
    "task-right-primary": "assets/task-right-primary.png",
    "task-right-primary-dark": "assets/task-right-primary-dark.png",
    "memory-light": "assets/memory-light.png",
    "memory-dark": "assets/memory-dark.png"
  },
  "config": {
    "title": "爱弥斯 · 星海远航",
    "subtitle": "把每一次告别折成航标，下一次相见就在星海尽处。",
    "status": "RA2362-G · GHOST LINK ONLINE",
    "memory": "她把未说完的话留进星图，也把属于隧者的深空回声带向新的航线。"
  },
  "compatibility": {
    "petOverlay": false
  }
}
