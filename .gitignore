# .NET and IDE state
.vs/
**/bin/
**/obj/
*.suo
*.user
*.userosscache
__pycache__/
*.py[cod]

# Build and test output
dist/
optimized-themes/
.test-output/
.qa/
/Compatibility/

# Local visual QA and working files
tmp/
artifacts/
previews/
!pets/**/previews/
!pets/**/previews/*.png
backups/
/Prompt.md
AGENTS.md

# Codex owns the pet project sources; generated candidates stay local until a
# reviewed package is explicitly promoted into pets/.
/pet-projects/*/build/
/pet-projects/*/tmp/
/pet-projects/**/__pycache__/
/pet-projects/**/*.pyc

# Local project records (intentionally excluded from the public repository)
docs/

# Every direct child of themes/ is a publishable theme package. Design sources
# and historical working copies inside a package are not release assets.
themes/*/.legacy/
themes/*/.references/
themes/*/.sources/

# OS metadata
Thumbs.db
Desktop.ini
.DS_Store
