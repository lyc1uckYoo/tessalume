<UserControl x:Class="Tessalume.App.Features.Personalization.DisplaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:personalization="clr-namespace:Tessalume.App.Features.Personalization"
             VerticalAlignment="Top"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">
    <StackPanel Margin="0,0,0,8">
        <personalization:DisplayPreferencesView x:Name="DisplayPreferencesControl"
                                                    PreferencesChanged="DisplayPreferences_Changed" />

        <Border Margin="0,16,0,0"
                Background="{DynamicResource PersonalizationNoticeGradient}"
                BorderBrush="{DynamicResource PersonalizationNoticeBorder}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="17,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource TealSoft}">
                    <Path Width="16" Height="16"
                          Data="M 12,2 L 20,6 L 20,12 C 20,17 16.8,20.3 12,22 C 7.2,20.3 4,17 4,12 L 4,6 Z M 9,12 L 11,14 L 15.5,9.5"
                          Stroke="{DynamicResource Teal}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Fill="Transparent" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="本机保存，即时生效" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="显示偏好会跟随当前主题保存在本机，不会改动主题包；图像构图仍在独立工作台中调整。"
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="11.5" LineHeight="18" Margin="0,3,16,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{DynamicResource SecondaryActionButton}"
                        Height="40" Padding="16,0" FontSize="12"
                        Content="调整主题图像  →" Click="ArtworkStudio_Click" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
