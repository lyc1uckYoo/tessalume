<UserControl x:Class="Tessalume.App.Features.Personalization.ExperienceProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">
    <Border Style="{DynamicResource ProductCard}" Padding="18">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource TealSoft}">
                    <TextBlock Text="◇" Foreground="{DynamicResource Teal}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="体验方案" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="一次保存主题、亮暗模式、两套图片参数以及显示偏好。" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource TealSoft}" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="完整快照" Foreground="{DynamicResource Teal}" FontSize="9.5" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="已保存方案" Foreground="{DynamicResource MutedText}" FontSize="9.5" FontWeight="SemiBold" Margin="1,0,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProfileComboBox" Height="34" Style="{DynamicResource SettingsComboBox}" DisplayMemberPath="Name" SelectionChanged="Profile_SelectionChanged" AutomationProperties.Name="已保存体验方案" />
                        <Button x:Name="ApplyButton" Grid.Column="2" Style="{DynamicResource HomeCrispButton}" Height="34" Padding="14,0" Content="一键应用" Click="Apply_Click" />
                        <Button x:Name="DeleteButton" Grid.Column="4" Style="{DynamicResource QuietActionButton}" Height="34" Padding="12,0" Content="删除" Click="Delete_Click" />
                    </Grid>
                    <TextBlock x:Name="ProfileSummaryText" Text="选择方案后显示包含的主题与模式" Foreground="{DynamicResource SubtleText}" FontSize="9.5" Margin="1,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="保存当前完整体验" Foreground="{DynamicResource MutedText}" FontSize="9.5" FontWeight="SemiBold" Margin="1,0,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="ProfileNameBox" Height="34" Padding="10,5" VerticalContentAlignment="Center" Background="{DynamicResource Surface}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource Border}" CaretBrush="{DynamicResource Accent}" AutomationProperties.Name="体验方案名称" />
                        <Button x:Name="SaveButton" Grid.Column="2" Style="{DynamicResource SecondaryActionButton}" Height="34" Padding="14,0" Content="保存方案" Click="Save_Click" />
                    </Grid>
                    <TextBlock Text="同名保存会更新方案；主题升级后仍保留本地图片和个人参数。" Foreground="{DynamicResource SubtleText}" FontSize="9.5" Margin="1,6,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
