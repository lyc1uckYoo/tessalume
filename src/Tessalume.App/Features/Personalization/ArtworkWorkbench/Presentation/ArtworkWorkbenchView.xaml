<UserControl x:Class="Tessalume.App.Features.Personalization.ArtworkWorkbench.Presentation.ArtworkWorkbenchView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tessalume.App.Features.Personalization.ArtworkWorkbench.Presentation"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             SizeChanged="Root_SizeChanged"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <Style x:Key="WorkbenchToggleButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="Background" Value="{DynamicResource SettingsControlSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkbenchSegmentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="inactive" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="active">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverSurface}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="WorkspaceGrid" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CanvasColumn" Width="1.5*" />
                <ColumnDefinition x:Name="WorkspaceGapColumn" Width="12" />
                <ColumnDefinition x:Name="InspectorColumn" Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="WorkspaceGapRow" Height="0" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="CanvasCard"
                    Grid.Column="0"
                    Background="{DynamicResource SurfaceElevated}"
                    BorderBrush="{DynamicResource SettingsControlBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{DynamicResource SettingsControlSurface}"
                            BorderBrush="{DynamicResource SettingsControlBorder}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="4">
                        <Grid x:Name="WorkbenchContextPanel" Height="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="0.72*" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>
                            <UniformGrid Columns="3">
                                <Button x:Name="HeroRegionButton" Style="{StaticResource WorkbenchSegmentButton}" Tag="active" CommandParameter="hero" Content="首页横幅" Click="Region_Click" Margin="0,0,3,0" AutomationProperties.Name="编辑首页横幅" />
                                <Button x:Name="SidebarRegionButton" Style="{StaticResource WorkbenchSegmentButton}" Tag="inactive" CommandParameter="sidebar" Content="左栏图片" Click="Region_Click" Margin="0,0,3,0" AutomationProperties.Name="编辑左栏图片" />
                                <Button x:Name="ChatRegionButton" Style="{StaticResource WorkbenchSegmentButton}" Tag="inactive" CommandParameter="chat" Content="聊天背景" Click="Region_Click" AutomationProperties.Name="编辑聊天背景" />
                            </UniformGrid>
                            <UniformGrid Grid.Column="2" Columns="2">
                                <Button x:Name="LightModeButton" Style="{StaticResource WorkbenchSegmentButton}" Content="亮色" Click="EditingMode_Click" Tag="active" CommandParameter="light" ToolTip="编辑亮色参数" AutomationProperties.Name="编辑亮色参数" />
                                <Button x:Name="DarkModeButton" Style="{StaticResource WorkbenchSegmentButton}" Content="暗色" Click="EditingMode_Click" Tag="inactive" CommandParameter="dark" ToolTip="编辑暗色参数" AutomationProperties.Name="编辑暗色参数" />
                            </UniformGrid>
                            <Border x:Name="SyncStatusBadge"
                                    Grid.Column="4"
                                    Background="{DynamicResource SurfaceElevated}"
                                    BorderBrush="{DynamicResource SettingsControlBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="9,0"
                                    AutomationProperties.Name="工作台应用状态"
                                    AutomationProperties.LiveSetting="Polite">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="13" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Ellipse x:Name="SyncStatusDot" Width="6" Height="6" Fill="{DynamicResource SubtleText}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SyncStatusText" Grid.Column="1" Text="未连接" Foreground="{DynamicResource PrimaryText}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="SyncStatusDetailText" Grid.Column="2" Text="仍可编辑与预览" Foreground="{DynamicResource MutedText}" FontSize="8.5" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CanvasTitleText" Text="首页横幅 · 亮色" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Margin="8,0,0,0" Background="{DynamicResource SkySoft}" CornerRadius="7" Padding="7,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="CanvasSourceText" Text="主题原图" Foreground="{DynamicResource Sky}" FontSize="9" FontWeight="SemiBold" />
                                </Border>
                                <Border x:Name="CompositionSourceBadge" Visibility="Collapsed" Margin="6,0,0,0" Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="7,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="CompositionSourceText" Text="主题推荐构图" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="SemiBold" />
                                </Border>
                                <Border x:Name="PreviewFailureBadge"
                                        Visibility="Collapsed"
                                        Margin="6,0,0,0"
                                        Background="{DynamicResource DangerSoft}"
                                        BorderBrush="{DynamicResource Danger}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="7,3"
                                        VerticalAlignment="Center"
                                        AutomationProperties.LiveSetting="Assertive">
                                    <TextBlock x:Name="PreviewFailureText" Text="预览失败" Foreground="{DynamicResource Danger}" FontSize="9" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="CanvasHintText" Text="拖动取景框调整最终构图" Foreground="{DynamicResource MutedText}" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="UndoButton" Style="{DynamicResource SettingsMiniButton}" Width="32" Height="30" Content="↶" Click="Undo_Click" ToolTip="撤销（Ctrl+Z）" AutomationProperties.Name="撤销图像修改" />
                            <Button x:Name="RedoButton" Style="{DynamicResource SettingsMiniButton}" Width="32" Height="30" Content="↷" Click="Redo_Click" Margin="5,0,0,0" ToolTip="重做（Ctrl+Y）" AutomationProperties.Name="重做图像修改" />
                            <ToggleButton x:Name="GuideToggleButton" Style="{StaticResource WorkbenchToggleButton}" Width="32" Height="30" IsChecked="True" Checked="GuideToggle_Changed" Unchecked="GuideToggle_Changed" Margin="5,0,0,0" Content="⌗" ToolTip="显示或隐藏辅助线" AutomationProperties.Name="显示辅助线" />
                            <Button x:Name="CompareButton" Style="{DynamicResource HomeCrispButton}" MinWidth="92" Height="30" Padding="8,0" Content="查看原图" Margin="5,0,0,0" PreviewMouseLeftButtonDown="Compare_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Compare_PreviewMouseLeftButtonUp" LostMouseCapture="Compare_LostMouseCapture" PreviewKeyDown="Compare_PreviewKeyDown" PreviewKeyUp="Compare_PreviewKeyUp" LostKeyboardFocus="Compare_LostKeyboardFocus" ToolTip="按住临时查看主题原始资产；不会保存变化" AutomationProperties.Name="按住查看主题原图" AutomationProperties.HelpText="按住 Space、Enter 或鼠标左键查看主题原始资产，松开恢复当前调整" />
                        </StackPanel>
                    </Grid>

                    <local:ArtworkCanvasControl x:Name="PreviewCanvas" Grid.Row="4" MinHeight="340" />

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ContainButton" Style="{DynamicResource HomeCrispButton}" Height="30" Padding="9,0" Content="完整显示" Click="Fit_Click" ToolTip="让完整图片进入目标区域" AutomationProperties.Name="显示完整图片" />
                            <Button x:Name="CoverButton" Style="{DynamicResource HomeCrispButton}" Height="30" Padding="9,0" Content="填满区域" Click="Fill_Click" Margin="5,0,0,0" ToolTip="使用 cover 填满目标区域" AutomationProperties.Name="填满目标区域" />
                            <Button x:Name="CenterImageButton" Style="{DynamicResource HomeCrispButton}" Height="30" Padding="9,0" Content="居中" Click="Center_Click" Margin="5,0,0,0" ToolTip="将图片主体居中" AutomationProperties.Name="居中图片" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="MappingHintText" Text="最终构图与运行时同步" Foreground="{DynamicResource SubtleText}" FontSize="8.8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="9,0" />
                        <Border x:Name="SurfaceMetricsBadge"
                                Grid.Column="2"
                                Background="{DynamicResource AmberSoft}"
                                BorderBrush="{DynamicResource Amber}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,5"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="预览区域尺寸来源">
                            <TextBlock x:Name="SurfaceMetricsText"
                                       Text="标准预览"
                                       Foreground="{DynamicResource Amber}"
                                       FontFamily="Cascadia Mono"
                                       FontSize="8.5"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Style="{DynamicResource SettingsMiniButton}" Width="30" Height="30" Content="−" Click="ZoomOut_Click" ToolTip="缩小 5%" AutomationProperties.Name="缩小图片" />
                            <Button Style="{DynamicResource SettingsMiniButton}" Width="30" Height="30" Content="+" Click="ZoomIn_Click" Margin="5,0,0,0" ToolTip="放大 5%" AutomationProperties.Name="放大图片" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer x:Name="InspectorScroller"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          FocusVisualStyle="{x:Null}">
                <local:ArtworkInspectorView x:Name="Inspector" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
