<UserControl x:Class="Tessalume.App.Features.Personalization.ArtworkWorkbench.Presentation.ArtworkInspectorView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="286"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <Style x:Key="InspectorLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InspectorValue" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource SettingsControlSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorder}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="ToolTip" Value="输入精确值；Enter 提交，Esc 取消" />
            <EventSetter Event="GotKeyboardFocus" Handler="ValueEditor_GotKeyboardFocus" />
            <EventSetter Event="LostKeyboardFocus" Handler="ValueEditor_LostKeyboardFocus" />
            <EventSetter Event="PreviewKeyDown" Handler="ValueEditor_PreviewKeyDown" />
        </Style>
        <Style x:Key="InspectorSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}" />
            <Setter Property="AutoToolTipPlacement" Value="TopLeft" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" VerticalAlignment="Center">
                            <Border Height="5"
                                    Background="{DynamicResource SettingsTrack}"
                                    CornerRadius="2.5"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track"
                                   Height="22"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5"
                                                        Background="{DynamicResource Accent}"
                                                        CornerRadius="2.5"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{DynamicResource Surface}"
                                                             Stroke="{DynamicResource Accent}"
                                                             StrokeThickness="2" />
                                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  IsTabStop="False"
                                                  Background="Transparent"
                                                  BorderThickness="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="ValueChanged" Handler="Slider_ValueChanged" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Slider_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Slider_PreviewMouseLeftButtonUp" />
            <EventSetter Event="LostMouseCapture" Handler="Slider_LostMouseCapture" />
            <EventSetter Event="GotKeyboardFocus" Handler="Slider_GotKeyboardFocus" />
            <EventSetter Event="LostKeyboardFocus" Handler="Slider_LostKeyboardFocus" />
        </Style>
        <Style x:Key="InspectorTabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="active">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource HoverSurface}" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabSurface" Property="Opacity" Value="0.72" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InspectorActionButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="ActionSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionSurface" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActionSurface" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InspectorAccentActionButton" TargetType="Button" BasedOn="{StaticResource InspectorActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceElevated}"
            BorderBrush="{DynamicResource SettingsControlBorder}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="参数调整" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedParameterText" Text="当前参数：图片大小" Foreground="{DynamicResource MutedText}" FontSize="9.8" Margin="0,3,0,0" />
                    <TextBlock x:Name="ParameterOriginText" Text="当前值跟随主题推荐" Foreground="{DynamicResource SubtleText}" FontSize="9.2" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock x:Name="SourceBadgeText" Text="主题原图" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="SemiBold" MaxWidth="86" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>

            <Border Height="1" Background="{DynamicResource SettingsControlBorder}" Margin="0,11" />

            <Border Background="{DynamicResource SettingsControlSurface}" BorderBrush="{DynamicResource SettingsControlBorder}" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,12">
                <UniformGrid Columns="3">
                    <Button x:Name="CompositionGroupButton" Style="{StaticResource InspectorTabButton}" Height="36" Tag="active" CommandParameter="composition" Content="构图" Click="Group_Click" AutomationProperties.Name="显示构图参数" />
                    <Button x:Name="BasicGroupButton" Style="{StaticResource InspectorTabButton}" Height="36" Tag="inactive" CommandParameter="basic" Content="明暗" Click="Group_Click" Margin="4,0" AutomationProperties.Name="显示明暗参数" />
                    <Button x:Name="EffectsGroupButton" Style="{StaticResource InspectorTabButton}" Height="36" Tag="inactive" CommandParameter="effects" Content="效果" Click="Group_Click" AutomationProperties.Name="显示效果参数" />
                </UniformGrid>
            </Border>

            <StackPanel x:Name="BasicPanel" Visibility="Collapsed">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                    <TextBlock Text="亮度" Style="{StaticResource InspectorLabel}" />
                    <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource InspectorSlider}" Tag="brightness" Minimum="20" Maximum="180" Value="100" AutomationProperties.Name="图像亮度" />
                    <TextBox x:Name="BrightnessValue" Grid.Column="2" Style="{StaticResource InspectorValue}" Tag="brightness" Text="100%" AutomationProperties.Name="亮度精确值" />
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                    <TextBlock Text="透明" Style="{StaticResource InspectorLabel}" />
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Style="{StaticResource InspectorSlider}" Tag="opacity" Minimum="0" Maximum="100" Value="100" AutomationProperties.Name="图像不透明度" />
                    <TextBox x:Name="OpacityValue" Grid.Column="2" Style="{StaticResource InspectorValue}" Tag="opacity" Text="100%" AutomationProperties.Name="透明度精确值" />
                </Grid>
                <StackPanel x:Name="BasicAdvancedPanel" Margin="0,4,0,0">
                    <StackPanel Margin="0,5,0,0">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                            <TextBlock Text="对比" Style="{StaticResource InspectorLabel}" />
                            <Slider x:Name="ContrastSlider" Grid.Column="1" Style="{StaticResource InspectorSlider}" Tag="contrast" Minimum="20" Maximum="180" Value="100" AutomationProperties.Name="图像对比度" />
                            <TextBox x:Name="ContrastValue" Grid.Column="2" Style="{StaticResource InspectorValue}" Tag="contrast" Text="100%" AutomationProperties.Name="对比度精确值" />
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                            <TextBlock Text="饱和" Style="{StaticResource InspectorLabel}" />
                            <Slider x:Name="SaturationSlider" Grid.Column="1" Style="{StaticResource InspectorSlider}" Tag="saturation" Minimum="0" Maximum="200" Value="100" AutomationProperties.Name="图像饱和度" />
                            <TextBox x:Name="SaturationValue" Grid.Column="2" Style="{StaticResource InspectorValue}" Tag="saturation" Text="100%" AutomationProperties.Name="饱和度精确值" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="CompositionPanel">
                <Grid Margin="1,0,1,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="拖动画布调整，或直接选择精确值" Foreground="{DynamicResource MutedText}" FontSize="9.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Background="{DynamicResource TealSoft}" CornerRadius="7" Padding="7,3" Margin="7,0,0,0">
                        <TextBlock x:Name="PlacementKindText" Text="主题推荐" Foreground="{DynamicResource Teal}" FontSize="8.7" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Border Background="{DynamicResource SettingsControlSurface}" BorderBrush="{DynamicResource SettingsControlBorder}" BorderThickness="1" CornerRadius="12" Padding="11,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /><RowDefinition Height="9" /><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Grid.Column="1" Text="宽度 / 模式" Foreground="{DynamicResource SubtleText}" FontSize="8.8" Margin="2,0,0,0" />
                        <TextBlock x:Name="SizeHeightLabel" Grid.Column="3" Text="高度" Foreground="{DynamicResource SubtleText}" FontSize="8.8" Margin="2,0,0,0" />
                        <TextBlock Grid.Row="2" Text="尺寸" Style="{StaticResource InspectorLabel}" />
                        <ComboBox x:Name="SizeWidthValue" Grid.Row="2" Grid.Column="1" Height="36" Style="{DynamicResource SettingsComboBox}" IsEditable="True" StaysOpenOnEdit="True" Tag="sizeWidth" Text="cover" GotKeyboardFocus="PlacementValue_GotKeyboardFocus" LostKeyboardFocus="PlacementValue_LostKeyboardFocus" PreviewKeyDown="PlacementValue_PreviewKeyDown" DropDownClosed="PlacementComboBox_DropDownClosed" SelectionChanged="PlacementComboBox_SelectionChanged" AutomationProperties.Name="背景宽度">
                            <ComboBoxItem Content="填满区域" Tag="cover" />
                            <ComboBoxItem Content="完整显示" Tag="contain" />
                            <ComboBoxItem Content="100%" Tag="100%" />
                            <ComboBoxItem Content="自动" Tag="auto" />
                        </ComboBox>
                        <ComboBox x:Name="SizeHeightValue" Grid.Row="2" Grid.Column="3" Height="36" Style="{DynamicResource SettingsComboBox}" IsEditable="True" StaysOpenOnEdit="True" Tag="sizeHeight" Text="auto" GotKeyboardFocus="PlacementValue_GotKeyboardFocus" LostKeyboardFocus="PlacementValue_LostKeyboardFocus" PreviewKeyDown="PlacementValue_PreviewKeyDown" DropDownClosed="PlacementComboBox_DropDownClosed" SelectionChanged="PlacementComboBox_SelectionChanged" AutomationProperties.Name="背景高度">
                            <ComboBoxItem Content="自动" Tag="auto" />
                            <ComboBoxItem Content="100%" Tag="100%" />
                        </ComboBox>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="水平位置" Foreground="{DynamicResource SubtleText}" FontSize="8.8" Margin="2,0,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="垂直位置" Foreground="{DynamicResource SubtleText}" FontSize="8.8" Margin="2,0,0,0" />
                        <TextBlock Grid.Row="6" Text="位置" Style="{StaticResource InspectorLabel}" />
                        <ComboBox x:Name="PositionXValue" Grid.Row="6" Grid.Column="1" Height="36" Style="{DynamicResource SettingsComboBox}" IsEditable="True" StaysOpenOnEdit="True" Tag="positionX" Text="center" GotKeyboardFocus="PlacementValue_GotKeyboardFocus" LostKeyboardFocus="PlacementValue_LostKeyboardFocus" PreviewKeyDown="PlacementValue_PreviewKeyDown" DropDownClosed="PlacementComboBox_DropDownClosed" SelectionChanged="PlacementComboBox_SelectionChanged" AutomationProperties.Name="背景水平位置">
                            <ComboBoxItem Content="左侧" Tag="left" />
                            <ComboBoxItem Content="居中" Tag="center" />
                            <ComboBoxItem Content="右侧" Tag="right" />
                            <ComboBoxItem Content="25%" Tag="25%" />
                            <ComboBoxItem Content="75%" Tag="75%" />
                        </ComboBox>
                        <ComboBox x:Name="PositionYValue" Grid.Row="6" Grid.Column="3" Height="36" Style="{DynamicResource SettingsComboBox}" IsEditable="True" StaysOpenOnEdit="True" Tag="positionY" Text="center" GotKeyboardFocus="PlacementValue_GotKeyboardFocus" LostKeyboardFocus="PlacementValue_LostKeyboardFocus" PreviewKeyDown="PlacementValue_PreviewKeyDown" DropDownClosed="PlacementComboBox_DropDownClosed" SelectionChanged="PlacementComboBox_SelectionChanged" AutomationProperties.Name="背景垂直位置">
                            <ComboBoxItem Content="顶部" Tag="top" />
                            <ComboBoxItem Content="居中" Tag="center" />
                            <ComboBoxItem Content="底部" Tag="bottom" />
                            <ComboBoxItem Content="25%" Tag="25%" />
                            <ComboBoxItem Content="75%" Tag="75%" />
                        </ComboBox>
                        <TextBlock x:Name="PlacementSummaryText" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Text="当前：size cover auto · position center center" Foreground="{DynamicResource Accent}" FontFamily="Cascadia Mono" FontSize="8.8" Margin="1,9,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
                <TextBlock x:Name="PlacementErrorText" Visibility="Collapsed" Foreground="{DynamicResource Danger}" FontSize="8.7" TextWrapping="Wrap" Margin="43,4,0,0" AutomationProperties.LiveSetting="Assertive" />

                <Border x:Name="LegacyCompositionPanel" Visibility="Collapsed" Background="{DynamicResource AmberSoft}" BorderBrush="{DynamicResource Amber}" BorderThickness="1" CornerRadius="9" Padding="8" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="旧版兼容构图" Foreground="{DynamicResource Amber}" FontSize="9" FontWeight="SemiBold" />
                        <TextBlock x:Name="LegacyCompositionText" Text="首次调整时自动转换为新构图。" Foreground="{DynamicResource MutedText}" FontSize="8.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Visibility="Collapsed">
                    <Slider x:Name="ZoomSlider" Tag="zoom" Minimum="70" Maximum="200" Value="100" />
                    <TextBox x:Name="ZoomValue" Tag="zoom" Text="100%" />
                    <Slider x:Name="OffsetXSlider" Tag="offsetX" Minimum="-200" Maximum="200" Value="0" />
                    <TextBox x:Name="OffsetXValue" Tag="offsetX" Text="0 px" />
                    <Slider x:Name="OffsetYSlider" Tag="offsetY" Minimum="-200" Maximum="200" Value="0" />
                    <TextBox x:Name="OffsetYValue" Tag="offsetY" Text="0 px" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="EffectsPanel" Visibility="Collapsed">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                    <TextBlock Text="叠色" Style="{StaticResource InspectorLabel}" />
                    <Slider x:Name="OverlayOpacitySlider" Grid.Column="1" Style="{StaticResource InspectorSlider}" Tag="overlayOpacity" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="背景叠色强度" />
                    <TextBox x:Name="OverlayOpacityValue" Grid.Column="2" Style="{StaticResource InspectorValue}" Tag="overlayOpacity" Text="0%" AutomationProperties.Name="背景叠色强度精确值" />
                </Grid>
                <StackPanel x:Name="EffectsAdvancedPanel" Margin="0,4,0,0">
                    <StackPanel Margin="0,5,0,0">
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><TextBlock Text="灰度" Style="{StaticResource InspectorLabel}" /><Slider x:Name="GrayscaleSlider" Grid.Column="1" Style="{StaticResource InspectorSlider}" Tag="grayscale" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="图像灰度" /><TextBox x:Name="GrayscaleValue" Grid.Column="2" Style="{StaticResource InspectorValue}" Tag="grayscale" Text="0%" AutomationProperties.Name="灰度精确值" /></Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><TextBlock Text="色相" Style="{StaticResource InspectorLabel}" /><Slider x:Name="HueRotationSlider" Grid.Column="1" Style="{StaticResource InspectorSlider}" Tag="hueRotation" Minimum="-180" Maximum="180" Value="0" AutomationProperties.Name="图像色相旋转" /><TextBox x:Name="HueRotationValue" Grid.Column="2" Style="{StaticResource InspectorValue}" Tag="hueRotation" Text="0°" AutomationProperties.Name="色相旋转精确值" /></Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><TextBlock Text="柔化" Style="{StaticResource InspectorLabel}" /><Slider x:Name="BlurSlider" Grid.Column="1" Style="{StaticResource InspectorSlider}" Tag="blur" Minimum="0" Maximum="20" TickFrequency="0.5" Value="0" AutomationProperties.Name="图像柔化" /><TextBox x:Name="BlurValue" Grid.Column="2" Style="{StaticResource InspectorValue}" Tag="blur" Text="0 px" AutomationProperties.Name="柔化精确值" /></Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><TextBlock Text="渐变" Style="{StaticResource InspectorLabel}" /><Slider x:Name="GradientStrengthSlider" Grid.Column="1" Style="{StaticResource InspectorSlider}" Tag="gradientStrength" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="图像渐变强度" /><TextBox x:Name="GradientStrengthValue" Grid.Column="2" Style="{StaticResource InspectorValue}" Tag="gradientStrength" Text="0%" AutomationProperties.Name="渐变强度精确值" /></Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><TextBlock Text="暗角" Style="{StaticResource InspectorLabel}" /><Slider x:Name="VignetteSlider" Grid.Column="1" Style="{StaticResource InspectorSlider}" Tag="vignette" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="图像暗角" /><TextBox x:Name="VignetteValue" Grid.Column="2" Style="{StaticResource InspectorValue}" Tag="vignette" Text="0%" AutomationProperties.Name="暗角精确值" /></Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="混合" Style="{StaticResource InspectorLabel}" />
                            <ComboBox x:Name="BlendModeComboBox" Grid.Column="1" Height="30" Style="{DynamicResource SettingsComboBox}" SelectionChanged="BlendModeComboBox_SelectionChanged" AutomationProperties.Name="图片混合模式">
                                <ComboBoxItem Content="正常" Tag="normal" /><ComboBoxItem Content="正片叠底" Tag="multiply" /><ComboBoxItem Content="滤色" Tag="screen" /><ComboBoxItem Content="叠加" Tag="overlay" /><ComboBoxItem Content="柔光" Tag="soft-light" /><ComboBoxItem Content="明度" Tag="luminosity" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="颜色" Style="{StaticResource InspectorLabel}" />
                            <TextBox x:Name="OverlayColorValue" Grid.Column="1" Height="30" Text="#000000" MaxLength="7" Padding="8,4" VerticalContentAlignment="Center" Background="{DynamicResource SettingsControlSurface}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource SettingsControlBorder}" CaretBrush="{DynamicResource Accent}" LostKeyboardFocus="OverlayColorValue_LostKeyboardFocus" PreviewKeyDown="OverlayColorValue_PreviewKeyDown" AutomationProperties.Name="叠色十六进制颜色" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource SettingsControlBorder}" Margin="0,12,0,10" />

            <TextBlock Text="图片来源" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="1,0,0,7" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button x:Name="ChooseImageButton" Style="{StaticResource InspectorAccentActionButton}" Content="更换本地图片" Click="ChooseImage_Click" ToolTip="替换当前区域与亮暗模式的图片" AutomationProperties.Name="选择本地替换图片" />
                <Button x:Name="ClearImageButton" Grid.Column="2" Style="{StaticResource InspectorActionButton}" Content="切回主题原图" Click="ClearImage_Click" ToolTip="使用主题原图并保留参数" AutomationProperties.Name="使用主题原图" />
            </Grid>

            <TextBlock Text="恢复" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="1,12,0,7" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button x:Name="ResetParameterButton" Style="{StaticResource InspectorActionButton}" Content="恢复当前参数" Click="ResetParameter_Click" ToolTip="恢复当前参数到主题推荐；可撤销" AutomationProperties.Name="恢复此参数到主题推荐" />
                <Button x:Name="ResetGroupButton" Grid.Column="2" Style="{StaticResource InspectorActionButton}" Content="恢复当前参数组" Click="ResetGroup_Click" ToolTip="恢复当前组到主题推荐；可撤销" AutomationProperties.Name="恢复此参数组到主题推荐" />
                <Button x:Name="ResetRegionButton" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource InspectorAccentActionButton}" Content="恢复当前槽位到主题推荐值" Click="ResetRegion_Click" ToolTip="恢复当前区域与亮暗模式并保留图片来源；可撤销" AutomationProperties.Name="恢复当前槽位到主题推荐值" />
                <Button x:Name="RestoreOriginalBaselineButton" Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource InspectorActionButton}" Content="恢复当前槽位到原图基线" Click="RestoreOriginalBaseline_Click" ToolTip="切回主题原始资产与中性效果；可撤销" AutomationProperties.Name="恢复当前槽位到原图基线" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
