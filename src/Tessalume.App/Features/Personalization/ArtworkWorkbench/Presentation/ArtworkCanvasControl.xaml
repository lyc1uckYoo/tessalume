<UserControl x:Class="Tessalume.App.Features.Personalization.ArtworkWorkbench.Presentation.ArtworkCanvasControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="330"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Focusable="True"
             AutomationProperties.Name="图像预览画布"
             AutomationProperties.HelpText="在全图取景中拖动或缩放取景框，直接调整最终构图">
    <UserControl.Resources>
        <Style x:Key="CropHandle" TargetType="Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#FFF4C665"
                                 Stroke="#FF241B0E"
                                 StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="CanvasHost" Background="Transparent" SizeChanged="CanvasHost_SizeChanged">
        <Border x:Name="FullSourceStage"
                Margin="4"
                Background="#FF111926"
                BorderBrush="{DynamicResource SettingsControlBorder}"
                BorderThickness="1"
                CornerRadius="16"
                ClipToBounds="True">
            <Grid x:Name="FullSourceHost" ClipToBounds="True">
                <Rectangle Opacity="0.32">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#18000000" Geometry="M0,0 H24 V24 H0 Z" />
                                    <GeometryDrawing Brush="#18FFFFFF" Geometry="M0,0 H12 V12 H0 Z M12,12 H24 V24 H12 Z" />
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Canvas x:Name="FullSourceCanvas"
                        Margin="18"
                        ClipToBounds="False">
                    <Border x:Name="FullSourceImageBorder"
                            Background="#FF0B1019"
                            BorderBrush="#5EFFFFFF"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Image x:Name="FullSourceImage"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" />
                    </Border>

                    <Rectangle x:Name="CropShadeTop" Fill="#9A08101B" IsHitTestVisible="False" />
                    <Rectangle x:Name="CropShadeLeft" Fill="#9A08101B" IsHitTestVisible="False" />
                    <Rectangle x:Name="CropShadeRight" Fill="#9A08101B" IsHitTestVisible="False" />
                    <Rectangle x:Name="CropShadeBottom" Fill="#9A08101B" IsHitTestVisible="False" />

                    <Border x:Name="CropFrame"
                            Background="#08FFFFFF"
                            BorderBrush="#FFF4C665"
                            BorderThickness="2"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="CropFrame_MouseLeftButtonDown"
                            MouseMove="CropFrame_MouseMove"
                            MouseLeftButtonUp="CropFrame_MouseLeftButtonUp"
                            LostMouseCapture="CropFrame_LostMouseCapture"
                            MouseWheel="CropFrame_MouseWheel"
                            AutomationProperties.Name="最终取景框"
                            AutomationProperties.HelpText="拖动移动最终取景；滚轮围绕当前指针缩放">
                        <Grid IsHitTestVisible="False">
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="10"
                                    Padding="8,4"
                                    CornerRadius="6"
                                    Background="#D5121A27">
                                <TextBlock x:Name="CropFrameLabel"
                                           Text="最终取景"
                                           Foreground="White"
                                           FontSize="9.5"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>

                    <Thumb x:Name="CropHandleTopLeft"
                           Style="{StaticResource CropHandle}"
                           Cursor="SizeNWSE"
                           Tag="topLeft"
                           DragStarted="CropHandle_DragStarted"
                           DragDelta="CropHandle_DragDelta"
                           DragCompleted="CropHandle_DragCompleted"
                           AutomationProperties.Name="从左上角缩放取景框" />
                    <Thumb x:Name="CropHandleTopRight"
                           Style="{StaticResource CropHandle}"
                           Cursor="SizeNESW"
                           Tag="topRight"
                           DragStarted="CropHandle_DragStarted"
                           DragDelta="CropHandle_DragDelta"
                           DragCompleted="CropHandle_DragCompleted"
                           AutomationProperties.Name="从右上角缩放取景框" />
                    <Thumb x:Name="CropHandleBottomLeft"
                           Style="{StaticResource CropHandle}"
                           Cursor="SizeNESW"
                           Tag="bottomLeft"
                           DragStarted="CropHandle_DragStarted"
                           DragDelta="CropHandle_DragDelta"
                           DragCompleted="CropHandle_DragCompleted"
                           AutomationProperties.Name="从左下角缩放取景框" />
                    <Thumb x:Name="CropHandleBottomRight"
                           Style="{StaticResource CropHandle}"
                           Cursor="SizeNWSE"
                           Tag="bottomRight"
                           DragStarted="CropHandle_DragStarted"
                           DragDelta="CropHandle_DragDelta"
                           DragCompleted="CropHandle_DragCompleted"
                           AutomationProperties.Name="从右下角缩放取景框" />
                </Canvas>

                <Border x:Name="FullSourceStatusBadge"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="14"
                        Padding="9,5"
                        CornerRadius="8"
                        Background="#D5162030"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="FullSourceStatusText"
                               Text="完整原图 · 等待构图数据"
                               Foreground="White"
                               FontFamily="Cascadia Mono"
                               FontSize="9.5" />
                </Border>

                <Border x:Name="OriginalBaselineBadge"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="14"
                        Padding="9,5"
                        CornerRadius="8"
                        Background="#D99B6124"
                        IsHitTestVisible="False">
                    <TextBlock Text="主题原始资产 · 完整图片 · 中性效果" Foreground="White" FontSize="9.5" FontWeight="SemiBold" />
                </Border>

                <Border x:Name="FullSourceLoadingOverlay"
                        Visibility="Collapsed"
                        Background="#B0121824"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="150" Height="3" IsIndeterminate="True" Foreground="{DynamicResource Accent}" />
                        <TextBlock x:Name="FullSourceLoadingText"
                                   Text="正在加载完整原图…"
                                   Foreground="White"
                                   FontSize="10.5"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border x:Name="FullSourceEmptyOverlay"
                        Visibility="Visible"
                        Margin="18"
                        Background="#8D101824"
                        BorderBrush="#48FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                        <TextBlock Text="完整原图尚未就绪" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="FullSourceEmptyText"
                                   Text="选择有效主题后，这里会显示当前槽位的完整原始素材。"
                                   Foreground="#D6FFFFFF"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="FullSourceBoundaryFlash"
                        Visibility="Collapsed"
                        BorderBrush="#FFF0B55B"
                        BorderThickness="2"
                        CornerRadius="15"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="PreviewScrollViewer"
                      Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      CanContentScroll="False"
                      PanningMode="None">
        <Grid x:Name="PreviewStage"
              Visibility="Collapsed"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="4">
            <Border x:Name="ViewportBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SettingsControlSurface}"
                BorderBrush="{DynamicResource SettingsControlBorder}"
                BorderThickness="1"
                CornerRadius="16"
                ClipToBounds="True"
                Cursor="SizeAll"
                MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                MouseMove="Viewport_MouseMove"
                MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                LostMouseCapture="Viewport_LostMouseCapture"
                MouseWheel="Viewport_MouseWheel">
            <Grid x:Name="ViewportGrid" ClipToBounds="True">
                <Rectangle x:Name="Checkerboard" Opacity="0.26">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#16000000" Geometry="M0,0 H24 V24 H0 Z" />
                                    <GeometryDrawing Brush="#16FFFFFF" Geometry="M0,0 H12 V12 H0 Z M12,12 H24 V24 H12 Z" />
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid x:Name="ArtworkLayer">
                    <Canvas x:Name="ArtworkImageCanvas" ClipToBounds="False">
                        <Image x:Name="ArtworkImage"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" />
                    </Canvas>
                    <Border x:Name="TintOverlay" IsHitTestVisible="False" />
                    <Border x:Name="VignetteOverlay" IsHitTestVisible="False" />
                </Grid>

                <Grid x:Name="MaskLayer" IsHitTestVisible="False">
                    <Grid x:Name="ImageReadabilityVeilOverlay" IsHitTestVisible="False" />
                    <Grid x:Name="GradientOverlay" IsHitTestVisible="False" />
                </Grid>

                <Grid x:Name="RuntimeMockLayer" IsHitTestVisible="False">
                    <Border x:Name="RuntimeTopChrome"
                            Height="26"
                            VerticalAlignment="Top"
                            Background="#3A101827"
                            BorderBrush="#38FFFFFF"
                            BorderThickness="0,0,0,1" />
                    <StackPanel x:Name="HeroMock"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="250"
                                Margin="32,52,0,28">
                        <Border Height="8" Width="46" HorizontalAlignment="Left" CornerRadius="4" Background="#CCFFFFFF" />
                        <Border Height="18" Margin="0,10,0,0" CornerRadius="5" Background="#DDF7F8FC" />
                        <Border Height="18" Width="195" HorizontalAlignment="Left" Margin="0,6,0,0" CornerRadius="5" Background="#BDF7F8FC" />
                        <Border Height="7" Width="220" HorizontalAlignment="Left" Margin="0,12,0,0" CornerRadius="3.5" Background="#95FFFFFF" />
                        <Border Height="7" Width="160" HorizontalAlignment="Left" Margin="0,5,0,0" CornerRadius="3.5" Background="#78FFFFFF" />
                    </StackPanel>
                    <StackPanel x:Name="SidebarMock" Visibility="Collapsed" Margin="12,42,12,14">
                        <Border Height="22" CornerRadius="7" Background="#A8FFFFFF" />
                        <Border Height="7" Margin="3,18,20,0" CornerRadius="3.5" Background="#A8FFFFFF" />
                        <Border Height="24" Margin="0,8,0,0" CornerRadius="7" Background="#68FFFFFF" />
                        <Border Height="24" Margin="0,6,0,0" CornerRadius="7" Background="#68FFFFFF" />
                        <Border Height="7" Margin="3,18,24,0" CornerRadius="3.5" Background="#A8FFFFFF" />
                        <Border Height="24" Margin="0,8,0,0" CornerRadius="7" Background="#68FFFFFF" />
                    </StackPanel>
                    <Grid x:Name="ChatMock" Visibility="Collapsed" Margin="46,48,46,32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Border Height="8" Width="174" HorizontalAlignment="Left" CornerRadius="4" Background="#B8FFFFFF" />
                            <Border Height="7" Width="286" HorizontalAlignment="Left" Margin="0,7,0,0" CornerRadius="3.5" Background="#94FFFFFF" />
                            <Border Height="7" Width="230" HorizontalAlignment="Left" Margin="0,5,0,0" CornerRadius="3.5" Background="#7AFFFFFF" />
                            <Border Height="38" Width="214" HorizontalAlignment="Right" Margin="0,24,0,0" CornerRadius="11" Background="#68FFFFFF" />
                            <Border Height="7" Width="270" HorizontalAlignment="Left" Margin="0,24,0,0" CornerRadius="3.5" Background="#94FFFFFF" />
                            <Border Height="7" Width="190" HorizontalAlignment="Left" Margin="0,5,0,0" CornerRadius="3.5" Background="#7AFFFFFF" />
                        </StackPanel>
                        <Border Grid.Row="2" Height="34" CornerRadius="12" Background="#8AFFFFFF" BorderBrush="#56FFFFFF" BorderThickness="1" />
                    </Grid>
                </Grid>

                <Canvas x:Name="GuideLayer" IsHitTestVisible="False">
                    <Rectangle x:Name="SafeAreaRectangle"
                               Stroke="#E8FFFFFF"
                               StrokeThickness="1.4"
                               StrokeDashArray="5,4"
                               Fill="#0FFFFFFF" />
                    <Border x:Name="SafeAreaLabel"
                            Canvas.Left="12"
                            Canvas.Top="38"
                            Background="#B3172235"
                            CornerRadius="6"
                            Padding="7,3">
                        <TextBlock Text="文字安全区" Foreground="White" FontSize="9.5" FontWeight="SemiBold" />
                    </Border>
                    <Rectangle x:Name="SubjectAreaRectangle"
                               Stroke="#E9F5C96A"
                               StrokeThickness="1.4"
                               StrokeDashArray="2,4"
                               Fill="#08F5C96A" />
                    <Border x:Name="SubjectAreaLabel"
                            Background="#C33A2D19"
                            CornerRadius="6"
                            Padding="7,3">
                        <TextBlock Text="主体建议区" Foreground="#FFF0C36A" FontSize="9.5" FontWeight="SemiBold" />
                    </Border>
                </Canvas>

                <Border x:Name="CanvasStatusBadge"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="12"
                        Padding="9,5"
                        CornerRadius="8"
                        Background="#C5162030"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="CanvasStatusText"
                               Text="X 0 px  ·  Y 0 px  ·  100%"
                               Foreground="White"
                               FontFamily="Cascadia Mono"
                               FontSize="9.5" />
                </Border>

                <Border x:Name="CompareBadge"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="12,38,12,0"
                        Padding="9,5"
                        CornerRadius="8"
                        Background="#D99B6124"
                        IsHitTestVisible="False">
                    <TextBlock Text="原图 · 未修改数据" Foreground="White" FontSize="9.5" FontWeight="SemiBold" />
                </Border>

                <Border x:Name="LoadingOverlay"
                        Visibility="Collapsed"
                        Background="#A0121824"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="132" Height="3" IsIndeterminate="True" Foreground="{DynamicResource Accent}" />
                        <TextBlock x:Name="LoadingText" Text="正在加载预览…" Foreground="White" FontSize="10.5" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border x:Name="EmptyOverlay"
                        Visibility="Visible"
                        Margin="18"
                        Background="#78101824"
                        BorderBrush="#48FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                        <TextBlock Text="预览尚未就绪" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyText" Text="选择有效主题后，这里会显示当前区域的实际素材。" Foreground="#D6FFFFFF" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="BoundaryFlash"
                        Visibility="Collapsed"
                        BorderBrush="#FFF0B55B"
                        BorderThickness="2"
                        CornerRadius="15"
                        IsHitTestVisible="False" />
            </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
