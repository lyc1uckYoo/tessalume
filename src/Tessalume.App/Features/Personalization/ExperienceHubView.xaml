<UserControl x:Class="Tessalume.App.Features.Personalization.ExperienceHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:personalization="clr-namespace:Tessalume.App.Features.Personalization"
             VerticalAlignment="Top">
    <StackPanel Margin="0,0,0,4">
        <personalization:DisplayPreferencesView x:Name="DisplayPreferencesControl" PreferencesChanged="DisplayPreferences_Changed" />
        <personalization:ExperienceProfilesView x:Name="ExperienceProfilesControl" Margin="0,12,0,0"
                                                  SaveRequested="ExperienceProfiles_SaveRequested"
                                                  ApplyRequested="ExperienceProfiles_ApplyRequested"
                                                  DeleteRequested="ExperienceProfiles_DeleteRequested" />

        <Border Style="{DynamicResource InsetCard}" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource TealSoft}">
                    <Path Width="13" Height="13" Data="M 12,2 L 20,6 L 20,12 C 20,17 16.8,20.3 12,22 C 7.2,20.3 4,17 4,12 L 4,6 Z M 9,12 L 11,14 L 15.5,9.5" Stroke="{DynamicResource Teal}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="设置保存在本机" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="11.5" />
                    <TextBlock Text="显示偏好和体验方案不会修改主题包；需要调整图像时可进入工作台。" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="9.5" Margin="0,2,10,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{DynamicResource QuietActionButton}" Content="调整主题图像" Click="ArtworkStudio_Click" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
