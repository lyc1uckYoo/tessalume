<UserControl x:Class="Tessalume.App.Features.Personalization.DisplayPreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">
    <Border Style="{DynamicResource ProductCard}" Padding="18">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource SkySoft}">
                    <TextBlock Text="Aa" Foreground="{DynamicResource Sky}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="显示偏好" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="控制主题动效、Codex 正文字号与内容疏密；跟随当前主题保存。" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource SkySoft}" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="体验控制" Foreground="{DynamicResource Sky}" FontSize="9.5" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{DynamicResource InsetCard}" Padding="13">
                    <StackPanel>
                        <TextBlock Text="动效强度" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="减少动画可降低干扰和资源占用" Foreground="{DynamicResource MutedText}" FontSize="9.5" Margin="0,3,0,8" />
                        <ComboBox x:Name="MotionComboBox" Height="32" Style="{DynamicResource SettingsComboBox}" SelectedValuePath="Tag" SelectionChanged="Selection_Changed" AutomationProperties.Name="主题动效强度">
                            <ComboBoxItem Content="完整" Tag="full" />
                            <ComboBoxItem Content="轻量" Tag="reduced" />
                            <ComboBoxItem Content="关闭" Tag="off" />
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{DynamicResource InsetCard}" Padding="13">
                    <StackPanel>
                        <TextBlock Text="正文字号" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="调整聊天区和左栏文字的整体比例" Foreground="{DynamicResource MutedText}" FontSize="9.5" Margin="0,3,0,8" />
                        <ComboBox x:Name="TextScaleComboBox" Height="32" Style="{DynamicResource SettingsComboBox}" SelectedValuePath="Tag" SelectionChanged="Selection_Changed" AutomationProperties.Name="Codex 正文字号">
                            <ComboBoxItem Content="较小" Tag="small" />
                            <ComboBoxItem Content="标准" Tag="standard" />
                            <ComboBoxItem Content="较大" Tag="large" />
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{DynamicResource InsetCard}" Padding="13">
                    <StackPanel>
                        <TextBlock Text="界面密度" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="控制消息之间的留白与阅读节奏" Foreground="{DynamicResource MutedText}" FontSize="9.5" Margin="0,3,0,8" />
                        <ComboBox x:Name="DensityComboBox" Height="32" Style="{DynamicResource SettingsComboBox}" SelectedValuePath="Tag" SelectionChanged="Selection_Changed" AutomationProperties.Name="Codex 界面密度">
                            <ComboBoxItem Content="紧凑" Tag="compact" />
                            <ComboBoxItem Content="舒适" Tag="comfortable" />
                            <ComboBoxItem Content="宽松" Tag="spacious" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
