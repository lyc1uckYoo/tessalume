<UserControl x:Class="Tessalume.App.Features.Pets.PetGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">
    <UserControl.Resources>
        <Style x:Key="PetGalleryFilter" TargetType="ToggleButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurface}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PetGalleryCardButton" TargetType="Button">
            <Setter Property="Width" Value="400" />
            <Setter Property="MinHeight" Value="376" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardSurface"
                                Background="{DynamicResource SurfaceElevated}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="18"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="HoverTint" Background="{DynamicResource AccentSoft}" CornerRadius="18" Opacity="0" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="HoverTint" Property="Opacity" Value="0.10" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardSurface" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardSurface" Property="Opacity" Value="0.58" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PetGalleryCardTemplate">
            <Button Style="{StaticResource PetGalleryCardButton}"
                    Tag="{Binding Entry}"
                    IsEnabled="{Binding CanOpen}"
                    Click="PetCard_Click"
                    AutomationProperties.Name="{Binding AutomationName}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="214" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Margin="8,8,8,0"
                            Background="{DynamicResource PersonalizationMotionGradient}"
                            BorderBrush="{DynamicResource PersonalizationMotionBorder}"
                            BorderThickness="1"
                            CornerRadius="14"
                            ClipToBounds="True">
                        <Grid>
                            <Ellipse Width="220" Height="220" Margin="0,-135,-72,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource Accent}" Opacity="0.09" />
                            <Ellipse Width="150" Height="150" Margin="-78,0,0,-82" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource Teal}" Opacity="0.07" />
                            <TextBlock Text="✦" Foreground="{DynamicResource Accent}" FontSize="46" Opacity="0.22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding CoverImage}"
                                   MaxWidth="260"
                                   MaxHeight="194"
                                   Margin="8"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border x:Name="SourceBadge"
                                    Padding="9,5"
                                    Margin="10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource TealSoft}"
                                    BorderBrush="{DynamicResource Teal}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SourceDot" Width="6" Height="6" Fill="{DynamicResource Teal}" Margin="0,0,6,0" />
                                    <TextBlock x:Name="SourceText" Text="{Binding SourceBadge}" Foreground="{DynamicResource Teal}" FontSize="9.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Padding="8,4"
                                    Margin="10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource HomeToolbarSurface}"
                                    BorderBrush="{DynamicResource HomeToolbarBorder}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource MutedText}" FontSize="9.5" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="17,13,17,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryText}" FontSize="17" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding ActionSummary}" Foreground="{DynamicResource Accent}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Description}"
                                   Foreground="{DynamicResource MutedText}"
                                   FontSize="10.5"
                                   LineHeight="16"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="34"
                                   Margin="0,5,0,0" />
                        <TextBlock Grid.Row="2"
                                   Text="{Binding HealthMessage}"
                                   Foreground="{DynamicResource SubtleText}"
                                   FontSize="9.5"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,8,0,8" />
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FooterText}" Foreground="{DynamicResource SubtleText}" FontSize="9.5" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Padding="11,6" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ActionText}" Foreground="{DynamicResource Accent}" FontSize="10.5" FontWeight="SemiBold" />
                                    <TextBlock Text="  →" Foreground="{DynamicResource Accent}" FontSize="10.5" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDevelopment}" Value="True">
                    <Setter TargetName="SourceBadge" Property="Background" Value="{DynamicResource AccentSoft}" />
                    <Setter TargetName="SourceBadge" Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter TargetName="SourceDot" Property="Fill" Value="{DynamicResource Accent}" />
                    <Setter TargetName="SourceText" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="20,17"
                Background="{DynamicResource PersonalizationCanvasGradient}"
                BorderBrush="{DynamicResource PersonalizationCanvasBorder}"
                BorderThickness="1"
                CornerRadius="22"
                Effect="{DynamicResource PersonalizationCardShadow}">
            <Grid>
                <Ellipse Width="220" Height="220" Margin="0,-150,-82,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource Accent}" Opacity="0.055" IsHitTestVisible="False" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="50" Height="50" Background="{DynamicResource PrimaryGradient}" CornerRadius="16">
                        <Path Width="25" Height="25" Data="M 7,10 C 4,10 3,7 4.5,5.5 C 6,4 8.5,5 9,7.2 M 15,7.2 C 15.5,5 18,4 19.5,5.5 C 21,7 20,10 17,10 M 7,12 C 7,8 17,8 17,12 C 20,13 20,18 16.5,19.5 C 14,20.6 13,19 12,19 C 11,19 10,20.6 7.5,19.5 C 4,18 4,13 7,12 Z" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="个性化角色伙伴" Foreground="{DynamicResource Accent}" FontSize="9.5" FontWeight="Bold" />
                        <TextBlock Text="Codex 宠物画廊" Foreground="{DynamicResource PrimaryText}" FontSize="25" FontWeight="Bold" Margin="0,2,0,0" />
                        <TextBlock Text="浏览角色伙伴，预览完整动作并安装到 Codex。" Foreground="{DynamicResource MutedText}" FontSize="11.5" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="3" Padding="12,7" Margin="14,0,0,0" VerticalAlignment="Center" Background="{DynamicResource HomeToolbarSurface}" BorderBrush="{DynamicResource HomeToolbarBorder}" BorderThickness="1" CornerRadius="11">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="11" Height="11" Margin="0,0,7,0">
                                <Ellipse Fill="{DynamicResource Accent}" Opacity="0.16" />
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" />
                            </Grid>
                            <TextBlock x:Name="GalleryCountText" Text="正在扫描…" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="12,10"
                Background="{DynamicResource HomeToolbarSurface}"
                BorderBrush="{DynamicResource HomeToolbarBorder}"
                BorderThickness="1"
                CornerRadius="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Height="34">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Path Width="14" Height="14" Data="M 10,18 A 8,8 0 1 1 10,2 A 8,8 0 1 1 10,18 M 16,16 L 22,22" Stroke="{DynamicResource SubtleText}" StrokeThickness="1.7" StrokeStartLineCap="Round" Stretch="Uniform" />
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PrimaryText}"
                                 FontSize="10.5"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"
                                 AutomationProperties.Name="搜索宠物" />
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="搜索宠物名称或 ID" Foreground="{DynamicResource SubtleText}" FontSize="10.5" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="AllFilterButton" Style="{StaticResource PetGalleryFilter}" Content="全部" Tag="all" IsChecked="True" Click="Filter_Click" />
                    <ToggleButton x:Name="OfficialFilterButton" Style="{StaticResource PetGalleryFilter}" Content="官方宠物" Tag="official" Click="Filter_Click" />
                    <ToggleButton x:Name="DevelopmentFilterButton" Style="{StaticResource PetGalleryFilter}" Content="开发预览" Tag="development" Click="Filter_Click" />
                </StackPanel>
                <Button Grid.Column="3" Style="{DynamicResource HomeUtilityButton}" Height="34" MinWidth="92" Content="↻  刷新画廊" Click="Refresh_Click" AutomationProperties.Name="重新扫描宠物画廊" />
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Padding="13,10"
                Background="{DynamicResource InfoSurface}"
                BorderBrush="{DynamicResource InfoBorder}"
                BorderThickness="1"
                CornerRadius="13">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="20" Height="20" Background="{DynamicResource AccentSoft}" CornerRadius="7">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" />
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="开发预览" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="  跟随 Codex 候选输出自动刷新，只用于审核动作。" Foreground="{DynamicResource MutedText}" FontSize="10" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="20" Height="20" Background="{DynamicResource TealSoft}" CornerRadius="7">
                        <Path Width="11" Height="11" Data="M 4,11 L 8,15 L 17,6" Stroke="{DynamicResource Teal}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="官方宠物" Foreground="{DynamicResource Teal}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="  已封版并通过哈希校验，才会开放安全安装。" Foreground="{DynamicResource MutedText}" FontSize="10" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <StackPanel x:Name="GallerySection" Grid.Row="5" Margin="0,15,0,0">
            <Grid Margin="1,0,1,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="GallerySectionTitle" Text="全部伙伴" Foreground="{DynamicResource PrimaryText}" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="选择一张卡片，进入完整动作与角色资料详情。" Foreground="{DynamicResource MutedText}" FontSize="10.5" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Padding="9,5" VerticalAlignment="Center" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9">
                    <TextBlock x:Name="FilteredCountText" Text="0 个结果" Foreground="{DynamicResource PrimaryText}" FontSize="9.5" FontWeight="SemiBold" />
                </Border>
            </Grid>
            <ItemsControl x:Name="GalleryItems" ItemTemplate="{StaticResource PetGalleryCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <Border x:Name="EmptyState"
                Grid.Row="6"
                Margin="0,4,0,0"
                Padding="26"
                Background="{DynamicResource SurfaceElevated}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="18"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="没有匹配的宠物" Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="调整搜索或筛选条件后再试。" Foreground="{DynamicResource MutedText}" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
