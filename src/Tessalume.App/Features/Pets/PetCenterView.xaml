<UserControl x:Class="Tessalume.App.Features.Pets.PetCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             IsVisibleChanged="PetCenterView_IsVisibleChanged"
             Unloaded="PetCenterView_Unloaded"
             SizeChanged="PetCenterView_SizeChanged">
    <StackPanel x:Name="RootPanel" VerticalAlignment="Top" Margin="0,0,0,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CODEX PETS" Style="{DynamicResource SectionEyebrowText}" />
                <TextBlock Text="Codex 宠物" Style="{DynamicResource PageTitleText}" Margin="0,4,0,0" />
                <TextBlock Text="把角色宠物安全装入 Codex 官方 Pets；选择与唤醒仍由你在 Codex 中完成。"
                           Style="{DynamicResource PageDescriptionText}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource TealSoft}" BorderBrush="{DynamicResource Teal}"
                    BorderThickness="1" CornerRadius="11" Padding="11,6" VerticalAlignment="Center" Margin="14,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="HeaderStatusDot" Width="6" Height="6" Fill="{DynamicResource Teal}" Margin="0,0,7,0" />
                    <TextBlock x:Name="HeaderStatusText" Text="正在检查" Foreground="{DynamicResource Teal}" FontSize="10" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{DynamicResource ProductCard}" Margin="0,20,0,0">
            <Grid x:Name="HeroLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PreviewColumn" Width="324" />
                    <ColumnDefinition x:Name="HeroGapColumn" Width="22" />
                    <ColumnDefinition x:Name="DetailsColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="CompactGapRow" Height="0" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="PreviewCard" Grid.Column="0" Grid.Row="0" MinHeight="346"
                        Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource InfoBorder}"
                        BorderThickness="1" CornerRadius="17" ClipToBounds="True">
                    <Grid>
                        <Ellipse Width="270" Height="270" Fill="{DynamicResource Accent}" Opacity="0.11"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-118,-82,0" />
                        <Ellipse Width="190" Height="190" Fill="{DynamicResource Sky}" Opacity="0.08"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-88,0,0,-95" />
                        <Grid Margin="18,15,18,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="LIVE PREVIEW" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="Bold" />
                                </Border>
                                <TextBlock x:Name="PreviewStateText" Grid.Column="1" Text="产品预览待加载"
                                           Foreground="{DynamicResource MutedText}" FontSize="9.5" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,7,0,5">
                                <TextBlock x:Name="PreviewFallbackText" Text="❄" Foreground="{DynamicResource Accent}"
                                           FontSize="54" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="PetPreviewImage" Width="216" Height="234" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       AutomationProperties.Name="飞行雪绒状态预览" />
                            </Grid>
                            <WrapPanel Grid.Row="2" HorizontalAlignment="Center">
                                <Button Style="{DynamicResource QuietActionButton}" Height="28" Padding="9,0" Margin="0,0,6,0" FontSize="9.5" Content="待机" Tag="idle" Click="PreviewState_Click" />
                                <Button Style="{DynamicResource QuietActionButton}" Height="28" Padding="9,0" Margin="0,0,6,0" FontSize="9.5" Content="工作" Tag="running" Click="PreviewState_Click" />
                                <Button Style="{DynamicResource QuietActionButton}" Height="28" Padding="9,0" Margin="0,0,6,0" FontSize="9.5" Content="需要你" Tag="needs-input" Click="PreviewState_Click" />
                                <Button Style="{DynamicResource QuietActionButton}" Height="28" Padding="9,0" Margin="0,0,6,0" FontSize="9.5" Content="完成" Tag="ready" Click="PreviewState_Click" />
                                <Button Style="{DynamicResource QuietActionButton}" Height="28" Padding="9,0" Margin="0,0,6,0" FontSize="9.5" Content="受阻" Tag="blocked" Click="PreviewState_Click" />
                                <Button Style="{DynamicResource QuietActionButton}" Height="28" Padding="9,0" Margin="0" FontSize="9.5" Content="九宫格" Tag="showcase" Click="PreviewState_Click" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel x:Name="DetailsPanel" Grid.Column="2" Grid.Row="0" VerticalAlignment="Top">
                    <WrapPanel>
                        <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="8" Padding="9,4" Margin="0,0,7,0">
                            <TextBlock Text="首个内置宠物" Foreground="{DynamicResource Accent}" FontSize="9.5" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="{DynamicResource SkySoft}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="8" Padding="9,4">
                            <TextBlock Text="Codex 官方 Pets 协议" Foreground="{DynamicResource Sky}" FontSize="9.5" FontWeight="SemiBold" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="飞行雪绒" Foreground="{DynamicResource PrimaryText}" FontSize="25" FontWeight="Bold" Margin="0,12,0,0" />
                    <TextBlock Text="爱弥斯的电子幽灵形态：栖居在屏幕边缘、会工作也会撒娇的飞行雪绒。"
                               Foreground="{DynamicResource MutedText}" FontSize="11" LineHeight="19" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <Border x:Name="InstallationStatusCard" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}"
                            BorderThickness="1" CornerRadius="13" Padding="13,11" Margin="0,15,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Ellipse x:Name="InstallationStatusHalo" Fill="{DynamicResource Accent}" Opacity="0.16" />
                                <Ellipse x:Name="InstallationStatusDot" Width="7" Height="7" Fill="{DynamicResource Accent}" />
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="InstallationStatusTitle" Text="正在检查" Foreground="{DynamicResource PrimaryText}" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="InstallationStatusDetail" Text="正在校验本地宠物文件…" Foreground="{DynamicResource MutedText}" FontSize="10" LineHeight="17" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button x:Name="PrimaryActionButton" Style="{DynamicResource PrimaryActionButton}" Height="43" Margin="0,14,0,0"
                            Content="正在检查…" IsEnabled="False" Click="PrimaryAction_Click"
                            AutomationProperties.Name="宠物主操作" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{DynamicResource QuietActionButton}" Height="36" Content="复制 /pet" Click="CopyCommand_Click"
                                ToolTip="复制唤醒命令，不会自动发送" AutomationProperties.Name="复制斜杠 pet 命令" />
                        <Button Grid.Column="2" Style="{DynamicResource QuietActionButton}" Height="36" Content="打开 Codex" Click="OpenCodex_Click"
                                AutomationProperties.Name="打开 Codex" />
                    </Grid>

                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="AcknowledgeSelectionButton" Style="{DynamicResource QuietActionButton}" Height="31"
                                Content="我已在 Codex 完成选择" Visibility="Collapsed" Click="AcknowledgeSelection_Click"
                                AutomationProperties.Name="确认已在 Codex 完成宠物选择" />
                        <Button x:Name="UninstallButton" Style="{DynamicResource QuietActionButton}" Height="31" Margin="7,0,0,0"
                                Content="卸载受管文件" Visibility="Collapsed" Click="Uninstall_Click"
                                AutomationProperties.Name="卸载 Tessalume 管理的宠物文件" />
                        <Button x:Name="RestoreBackupButton" Style="{DynamicResource QuietActionButton}" Height="31" Margin="7,0,0,0"
                                Content="恢复最近备份" Visibility="Collapsed" Click="RestoreBackup_Click"
                                AutomationProperties.Name="恢复最近的宠物备份" />
                    </WrapPanel>
                </StackPanel>

                <Border x:Name="MetadataPanel" Grid.Column="2" Grid.Row="2" Margin="0,13,0,0"
                        Background="{DynamicResource HomeToolbarSurface}" BorderBrush="{DynamicResource HomeToolbarBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="12,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="产品版本" Foreground="{DynamicResource SubtleText}" FontSize="9" />
                            <TextBlock x:Name="ProductVersionText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,2,0,0" />
                            <TextBlock Text="作者与许可" Foreground="{DynamicResource SubtleText}" FontSize="9" Margin="0,8,0,0" />
                            <TextBlock x:Name="AuthorLicenseText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="运行协议" Foreground="{DynamicResource SubtleText}" FontSize="9" />
                            <TextBlock x:Name="ProtocolText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,2,0,0" />
                            <TextBlock Text="安装范围" Foreground="{DynamicResource SubtleText}" FontSize="9" Margin="0,8,0,0" />
                            <TextBlock x:Name="InstallLocationText" Text="当前用户 .codex\pets" Foreground="{DynamicResource PrimaryText}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="LowerLayout" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="InstallGuideCard" Style="{DynamicResource InsetCard}">
                <StackPanel>
                    <TextBlock Text="安装后，只需在 Codex 完成一次选择" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="7" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="7" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="7" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Surface}" CornerRadius="9" Padding="9,8"><StackPanel><TextBlock Text="01" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="Bold" /><TextBlock Text="Settings" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
                        <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="9" Padding="9,8"><StackPanel><TextBlock Text="02" Foreground="{DynamicResource Sky}" FontSize="9" FontWeight="Bold" /><TextBlock Text="Pets" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
                        <Border Grid.Column="4" Background="{DynamicResource Surface}" CornerRadius="9" Padding="9,8"><StackPanel><TextBlock Text="03" Foreground="{DynamicResource Amber}" FontSize="9" FontWeight="Bold" /><TextBlock Text="Refresh 后选择" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                        <Border Grid.Column="6" Background="{DynamicResource Surface}" CornerRadius="9" Padding="9,8"><StackPanel><TextBlock Text="04" Foreground="{DynamicResource Teal}" FontSize="9" FontWeight="Bold" /><TextBlock Text="输入 /pet" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
                    </Grid>
                    <TextBlock Text="Tessalume 不会点击 Codex 界面、不会发送命令，也无法自动确认宠物是否已启用。"
                               Foreground="{DynamicResource MutedText}" FontSize="9.5" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="CompanionThemeCard" Grid.Column="2" Style="{DynamicResource InsetCard}">
                <StackPanel>
                    <TextBlock Text="配套主题" Foreground="{DynamicResource Rose}" FontSize="9.5" FontWeight="Bold" />
                    <TextBlock Text="爱弥斯 · 星海远航" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,0" />
                    <TextBlock Text="宠物与主题可以独立使用；应用主题不会偷偷安装宠物。" Foreground="{DynamicResource MutedText}" FontSize="9.5" LineHeight="16" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Style="{DynamicResource QuietActionButton}" Content="查看主题" Click="OpenTheme_Click" Height="33" />
                        <Button Grid.Column="2" Style="{DynamicResource QuietActionButton}" Content="应用主题" Click="ApplyTheme_Click" Height="33" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1"
                CornerRadius="13" Padding="14,11" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource Surface}">
                    <Path Width="11" Height="11" Data="M 12,2 L 20,6 L 20,12 C 20,17 16.8,20.3 12,22 C 7.2,20.3 4,17 4,12 L 4,6 Z M 9,12 L 11,14 L 15.5,9.5"
                          Stroke="{DynamicResource Positive}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" />
                </Border>
                <TextBlock Grid.Column="1" Text="权限与隐私：只读取和管理当前用户 .codex\pets 下与所选宠物 ID 相关的文件；不读取聊天、账号、日志或其他 Codex 配置。"
                           Foreground="{DynamicResource MutedText}" FontSize="9.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Column="2" Style="{DynamicResource QuietActionButton}" Content="重新检查" Height="31" Click="Refresh_Click" AutomationProperties.Name="重新检查宠物状态" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
