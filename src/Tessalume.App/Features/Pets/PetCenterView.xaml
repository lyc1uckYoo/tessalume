<UserControl x:Class="Tessalume.App.Features.Pets.PetCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tessalume.App.Features.Pets"
             xmlns:webview2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             FontFamily="Microsoft YaHei UI"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollViewer}}}"
             IsVisibleChanged="PetCenterView_IsVisibleChanged"
             Unloaded="PetCenterView_Unloaded"
             SizeChanged="PetCenterView_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="PetPreviewChip" TargetType="ToggleButton">
            <Setter Property="Height" Value="25" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,5,4" />
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipSurface" Property="Background" Value="{DynamicResource HoverSurface}" />
                                <Setter TargetName="ChipSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipSurface" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="ChipSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChipSurface" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChipSurface" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PetToolButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToolSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToolSurface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToolSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToolSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToolSurface" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PetSelectionButton" TargetType="Button" BasedOn="{StaticResource PetToolButton}">
            <Setter Property="Width" Value="126" />
            <Setter Property="Height" Value="39" />
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style x:Key="PetAccentToolButton" TargetType="Button" BasedOn="{StaticResource PetToolButton}">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style x:Key="PetDangerToolButton" TargetType="Button" BasedOn="{StaticResource PetToolButton}">
            <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Style>
        <Style x:Key="PetPrimaryButton" TargetType="Button">
            <Setter Property="Width" Value="148" />
            <Setter Property="Height" Value="39" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource PrimaryActionGradient}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimarySurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="PrimaryGlow" Background="#14FFFFFF" CornerRadius="10" Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryGlow" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PrimarySurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimarySurface" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimarySurface" Property="Opacity" Value="0.44" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PetSectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootPanel" VerticalAlignment="Stretch">
        <local:PetGalleryView x:Name="GalleryPanel" VerticalAlignment="Top" />

        <Grid x:Name="DetailPanel" Visibility="Collapsed" VerticalAlignment="Top" MaxHeight="720">
        <Border x:Name="PetConsoleShell"
                MaxHeight="720"
                Padding="0"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                SnapsToDevicePixels="True">
            <Grid ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="PageHeader" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackToGalleryButton" Width="122" Height="38" Padding="13,0" Style="{DynamicResource HomeCrispButton}" Click="BackToGallery_Click" ToolTip="返回宠物画廊" AutomationProperties.Name="返回宠物画廊">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Data="M 14,4 L 6,12 L 14,20 M 7,12 L 21,12" Style="{DynamicResource NavIcon}" Margin="0,0,7,0" />
                                <TextBlock Text="返回画廊" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="PetHeaderIcon" Grid.Column="2" Width="42" Height="42" Background="{DynamicResource PrimaryGradient}" CornerRadius="13" VerticalAlignment="Center">
                            <Path Width="22" Height="22" Data="M 7,10 C 4,10 3,7 4.5,5.5 C 6,4 8.5,5 9,7.2 M 15,7.2 C 15.5,5 18,4 19.5,5.5 C 21,7 20,10 17,10 M 7,12 C 7,8 17,8 17,12 C 20,13 20,18 16.5,19.5 C 14,20.6 13,19 12,19 C 11,19 10,20.6 7.5,19.5 C 4,18 4,13 7,12 Z" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="TESSALUME  PET DETAILS" Style="{StaticResource PetSectionLabel}" FontSize="10" />
                            <TextBlock x:Name="DetailPageTitleText" Text="飞行雪绒" Foreground="{DynamicResource PrimaryText}" FontSize="24" FontWeight="Bold" Margin="0,1,0,0" />
                            <TextBlock x:Name="DetailPageSubtitleText" Text="查看真实动作、角色资料和本地安装状态。" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,1,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border x:Name="HeaderStatusBadge" Grid.Column="5" Padding="10,6" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="InstallationStatusHalo" Fill="{DynamicResource Accent}" Opacity="0.17" />
                                    <Ellipse x:Name="InstallationStatusDot" Width="6" Height="6" Fill="{DynamicResource Accent}" />
                                </Grid>
                                <TextBlock x:Name="InstallationStatusTitle" Text="正在检查" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="WorkspaceSurface" Grid.Row="1" MinHeight="0" MaxHeight="650" Margin="0,14,0,0" Padding="0" VerticalAlignment="Top" Background="Transparent" SizeChanged="WorkspaceSurface_SizeChanged">
                        <Grid x:Name="WorkspaceGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="WorkspaceLeftColumn" Width="1.05*" />
                                <ColumnDefinition x:Name="WorkspaceGapColumn" Width="16" />
                                <ColumnDefinition x:Name="WorkspaceRightColumn" Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>

                            <Border x:Name="PreviewStage" Grid.Column="0" Grid.Row="0" MinHeight="0" Padding="14" Background="{DynamicResource PersonalizationMotionGradient}" BorderBrush="{DynamicResource PersonalizationMotionBorder}" BorderThickness="1" CornerRadius="16" ClipToBounds="True" Effect="{DynamicResource HomeCardShadow}">
                                <Grid>
                                    <Ellipse Width="330" Height="330" Margin="0,-185,-115,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource Accent}" Opacity="0.09" />
                                    <Ellipse Width="240" Height="240" Margin="-130,0,0,-130" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource Sky}" Opacity="0.07" />
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="动态预览" Style="{StaticResource PetSectionLabel}" />
                                                <TextBlock x:Name="PreviewStateText" Text="待机" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="8,4" VerticalAlignment="Center" Background="{DynamicResource HomeToolbarSurface}" BorderBrush="{DynamicResource HomeToolbarBorder}" BorderThickness="1" CornerRadius="9">
                                                <TextBlock x:Name="PlaybackStatusText" Text="正在准备…" Foreground="{DynamicResource MutedText}" FontSize="9.5" TextAlignment="Right" />
                                            </Border>
                                        </Grid>
                                        <Border x:Name="PreviewImageHost" Grid.Row="1" MinHeight="0" Margin="0,10,0,0" Padding="10" VerticalAlignment="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource HomeToolbarBorder}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock x:Name="PreviewFallbackText" Text="❄" Foreground="{DynamicResource Accent}" FontSize="48" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image x:Name="PetPreviewImage" MaxWidth="420" MaxHeight="410" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="宠物动态动作预览" />
                                                <webview2:WebView2CompositionControl x:Name="PetRuntimePreview" Width="400" Height="400" MaxWidth="420" MaxHeight="410" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="实时图集宠物预览" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border x:Name="ControlPanelHost" Grid.Column="2" Grid.Row="0" MinHeight="0" Padding="16" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource HomeToolbarBorder}" BorderThickness="1" CornerRadius="16" Effect="{DynamicResource HomeCardShadow}">
                                <Grid x:Name="ControlPanel">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Padding="0,0,0,10" BorderBrush="{DynamicResource HomeToolbarBorder}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock x:Name="PetDisplayNameText" Text="飞行雪绒" Foreground="{DynamicResource PrimaryText}" FontSize="20" FontWeight="Bold" />
                                                    <TextBlock x:Name="PetDescriptionText" Text="爱弥斯的电子幽灵伙伴，陪你工作与互动。" Foreground="{DynamicResource MutedText}" FontSize="10.5" LineHeight="16" TextWrapping="Wrap" Margin="0,3,8,0" />
                                                </StackPanel>
                                                <Border x:Name="PetSourceBadge" Grid.Column="1" Padding="8,4" VerticalAlignment="Top" Background="{DynamicResource TealSoft}" CornerRadius="8">
                                                    <TextBlock x:Name="PetSourceBadgeText" Text="官方宠物" Foreground="{DynamicResource Teal}" FontSize="9.5" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                            <Border Margin="0,8,0,0" Padding="9,7" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="状态说明" Style="{StaticResource PetSectionLabel}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <TextBlock x:Name="InstallationStatusDetail" Grid.Column="1" Text="正在校验本地宠物文件…" Foreground="{DynamicResource MutedText}" FontSize="10" LineHeight="15" TextWrapping="Wrap" />
                                            </Grid>
                                            </Border>
                                            <WrapPanel x:Name="PrimaryActionGroup" Margin="0,8,0,0">
                                                <Button x:Name="PrimaryActionButton" Style="{StaticResource PetPrimaryButton}" Content="正在检查…" IsEnabled="False" Click="PrimaryAction_Click" AutomationProperties.Name="宠物主操作" />
                                                <Button x:Name="AcknowledgeSelectionButton" Margin="8,0,0,0" Style="{StaticResource PetSelectionButton}" Content="我已完成选择" Visibility="Collapsed" Click="AcknowledgeSelection_Click" AutomationProperties.Name="确认已在 Codex 完成宠物选择" />
                                            </WrapPanel>
                                            <Border x:Name="ActivationGuidePanel" Margin="0,6,0,0" Padding="8,5" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                                                <TextBlock x:Name="ActivationGuideText" Text="Settings → Pets → Refresh → 选择宠物 → 输入 /pet" Foreground="{DynamicResource PrimaryText}" FontSize="9.8" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel x:Name="ActionSelector" Grid.Row="1" Margin="0,10,0,0">
                                        <TextBlock Text="动作预览" Style="{StaticResource PetSectionLabel}" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="日常" Foreground="{DynamicResource SubtleText}" FontSize="10" VerticalAlignment="Center" />
                                            <WrapPanel x:Name="DailyActionsPanel" Grid.Column="1">
                                                <ToggleButton x:Name="IdlePreviewButton" Style="{StaticResource PetPreviewChip}" Content="待机" Tag="idle" Click="PreviewState_Click" AutomationProperties.Name="预览待机动作" />
                                                <ToggleButton x:Name="MoveRightPreviewButton" Style="{StaticResource PetPreviewChip}" Content="向右移动" Tag="move-right" Click="PreviewState_Click" AutomationProperties.Name="预览向右移动动作" />
                                                <ToggleButton x:Name="MoveLeftPreviewButton" Style="{StaticResource PetPreviewChip}" Content="向左移动" Tag="move-left" Click="PreviewState_Click" AutomationProperties.Name="预览向左移动动作" />
                                                <ToggleButton x:Name="WavePreviewButton" Style="{StaticResource PetPreviewChip}" Content="挥手互动" Tag="wave-touch" Click="PreviewState_Click" AutomationProperties.Name="预览挥手互动动作" />
                                                <ToggleButton x:Name="JumpPreviewButton" Style="{StaticResource PetPreviewChip}" Content="跳跃" Tag="jump" Click="PreviewState_Click" AutomationProperties.Name="预览跳跃动作" />
                                            </WrapPanel>
                                        </Grid>
                                        <Grid Margin="0,1,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="任务" Foreground="{DynamicResource SubtleText}" FontSize="10" VerticalAlignment="Center" />
                                            <WrapPanel x:Name="TaskActionsPanel" Grid.Column="1">
                                                <ToggleButton x:Name="BlockedPreviewButton" Style="{StaticResource PetPreviewChip}" Content="遇到阻塞" Tag="blocked" Click="PreviewState_Click" AutomationProperties.Name="预览遇到阻塞动作" />
                                                <ToggleButton x:Name="NeedsInputPreviewButton" Style="{StaticResource PetPreviewChip}" Content="等待输入" Tag="needs-input" Click="PreviewState_Click" AutomationProperties.Name="预览等待输入动作" />
                                                <ToggleButton x:Name="RunningPreviewButton" Style="{StaticResource PetPreviewChip}" Content="正在工作" Tag="running" Click="PreviewState_Click" AutomationProperties.Name="预览正在工作动作" />
                                                <ToggleButton x:Name="ReadyPreviewButton" Style="{StaticResource PetPreviewChip}" Content="完成待看" Tag="ready" Click="PreviewState_Click" AutomationProperties.Name="预览完成待看动作" />
                                            </WrapPanel>
                                        </Grid>
                                        <Grid Margin="0,1,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="视角" Foreground="{DynamicResource SubtleText}" FontSize="10" VerticalAlignment="Center" />
                                            <WrapPanel x:Name="ViewActionsPanel" Grid.Column="1">
                                                <ToggleButton x:Name="GazePreviewButton" Style="{StaticResource PetPreviewChip}" Content="16 向转身" Tag="gaze-clockwise" Click="PreviewState_Click" AutomationProperties.Name="预览十六向转身" />
                                                <ToggleButton x:Name="ShowcasePreviewButton" Style="{StaticResource PetPreviewChip}" Content="动态九宫格" Tag="showcase" Click="PreviewState_Click" AutomationProperties.Name="预览动态九宫格" />
                                            </WrapPanel>
                                        </Grid>
                                        <Border Height="1" Margin="0,3,0,0" Background="{DynamicResource HomeToolbarBorder}" />
                                    </StackPanel>

                                    <Grid x:Name="RecommendedThemeSection" Grid.Row="2" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="配套主题" Style="{StaticResource PetSectionLabel}" />
                                            <TextBlock x:Name="RecommendedThemeNameText" Text="爱弥斯 · 星海远航" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,2,6,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource PetToolButton}" Content="查看" Click="OpenTheme_Click" />
                                        <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource PetAccentToolButton}" Content="应用" Click="ApplyTheme_Click" />
                                    </Grid>

                                    <Border Grid.Row="3" Margin="0,8,0,0" Padding="12" Background="{DynamicResource HomeToolbarSurface}" BorderBrush="{DynamicResource HomeToolbarBorder}" BorderThickness="1" CornerRadius="12">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <TextBlock Text="产品信息" Style="{StaticResource PetSectionLabel}" />
                                            <Grid Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Top">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="5" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="版本" Foreground="{DynamicResource SubtleText}" FontSize="9.5" />
                                                    <TextBlock x:Name="ProductVersionText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,1,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="运行协议" Foreground="{DynamicResource SubtleText}" FontSize="9.5" />
                                                    <TextBlock x:Name="ProtocolText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2">
                                                    <TextBlock Text="作者许可" Foreground="{DynamicResource SubtleText}" FontSize="9.5" />
                                                    <TextBlock x:Name="AuthorLicenseText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="2">
                                                    <TextBlock x:Name="LocationLabelText" Text="管理范围" Foreground="{DynamicResource SubtleText}" FontSize="9.5" />
                                                    <TextBlock x:Name="InstallLocationText" Text="仅管理当前用户 .codex\pets" Foreground="{DynamicResource PrimaryText}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="当前用户 .codex\pets" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,6" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="9">
                                                <TextBlock Text="安装或修复前会重新校验完整资源，并保留可恢复备份。" Foreground="{DynamicResource MutedText}" FontSize="9.5" TextWrapping="Wrap" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel x:Name="ManagementSection" Grid.Row="4" Margin="0,8,0,0">
                                        <TextBlock x:Name="ManagementSectionTitle" Text="管理工具" Style="{StaticResource PetSectionLabel}" />
                                        <WrapPanel x:Name="ManagementToolsPanel" Margin="0,4,0,0">
                                            <Button x:Name="RefreshButton" Margin="0,0,6,0" Style="{StaticResource PetToolButton}" Content="↻  重新检查" Click="Refresh_Click" AutomationProperties.Name="重新检查宠物状态" />
                                            <Button x:Name="RestoreBackupButton" Margin="0,0,6,0" Style="{StaticResource PetAccentToolButton}" Content="↶  恢复备份" IsEnabled="False" Click="RestoreBackup_Click" AutomationProperties.Name="恢复最近的宠物备份" />
                                            <Button x:Name="UninstallButton" Style="{StaticResource PetDangerToolButton}" Content="移除受管文件" IsEnabled="False" Click="Uninstall_Click" AutomationProperties.Name="卸载 Tessalume 管理的宠物文件" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
