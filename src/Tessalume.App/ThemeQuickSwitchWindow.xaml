<Window x:Class="Tessalume.App.ThemeQuickSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tessalume.App"
        Title="{x:Static local:BrandInfo.QuickSwitchTitle}" Height="78" MinHeight="78" MaxHeight="78" SizeToContent="Width"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <LinearGradientBrush x:Key="BarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#211827" Offset="0" />
            <GradientStop Color="#35243E" Offset="0.52" />
            <GradientStop Color="#241B32" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CurrentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E05DA4" Offset="0" />
            <GradientStop Color="#826AD8" Offset="1" />
        </LinearGradientBrush>
        <DropShadowEffect x:Key="BarShadow" Color="#120B18" BlurRadius="28" ShadowDepth="8" Opacity="0.44" />
        <SolidColorBrush x:Key="QuickPrimaryText" Color="#FFF7FA" />
        <SolidColorBrush x:Key="QuickSecondaryText" Color="#B8DFD4E5" />
        <SolidColorBrush x:Key="QuickIconBrush" Color="#FFF7FA" />
        <SolidColorBrush x:Key="QuickButtonSurface" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="QuickButtonBorder" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="QuickButtonHover" Color="#29FFFFFF" />
        <SolidColorBrush x:Key="QuickButtonHoverBorder" Color="#46FFFFFF" />
        <SolidColorBrush x:Key="QuickButtonPressed" Color="#477E67D0" />
        <SolidColorBrush x:Key="QuickPlayerSurface" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="QuickPlayerBorder" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="QuickAccentSurface" Color="#287D66CF" />
        <SolidColorBrush x:Key="QuickAccentBorder" Color="#397F70D6" />
        <SolidColorBrush x:Key="QuickColorSurface" Color="#2A9B6AD1" />
        <SolidColorBrush x:Key="QuickColorBorder" Color="#4AAF86E4" />
        <SolidColorBrush x:Key="QuickHomeSurface" Color="#245E6FCA" />
        <SolidColorBrush x:Key="QuickHomeBorder" Color="#3E8192E5" />
        <SolidColorBrush x:Key="QuickCloseSurface" Color="#176E6880" />
        <SolidColorBrush x:Key="QuickCloseBorder" Color="#357F7992" />
        <SolidColorBrush x:Key="QuickCloseIcon" Color="#FFD9E4" />
        <SolidColorBrush x:Key="QuickRingSurface" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="QuickRingBorder" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="QuickRingTrack" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="QuickSeparator" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="QuickPanelBorder" Color="#3AFFFFFF" />
        <SolidColorBrush x:Key="QuickBadgeSurface" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="QuickBadgeBorder" Color="#2FFFFFFF" />
        <SolidColorBrush x:Key="QuickTooltipSurface" Color="#F4291F33" />
        <SolidColorBrush x:Key="QuickTooltipBorder" Color="#685273" />
        <Color x:Key="QuickPanelStop0">#24FFFFFF</Color>
        <Color x:Key="QuickPanelStop1">#32E05DA4</Color>
        <Color x:Key="QuickPanelStop2">#28826AD8</Color>
        <Color x:Key="QuickPanelStop3">#14FFFFFF</Color>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource QuickPrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource QuickButtonSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource QuickButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid x:Name="MotionRoot" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource QuickButtonHover}" />
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource QuickButtonHoverBorder}" />
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MotionRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="MotionRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.16" />
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MotionRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MotionRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource QuickButtonPressed}" />
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MotionRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.92" Duration="0:0:0.08" />
                            <DoubleAnimation Storyboard.TargetName="MotionRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.92" Duration="0:0:0.08" />
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MotionRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="MotionRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.12" />
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{DynamicResource QuickPlayerSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource QuickPlayerBorder}" />
        </Style>
        <Style x:Key="AccentIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{DynamicResource QuickAccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource QuickAccentBorder}" />
        </Style>
        <Style x:Key="ColorIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{DynamicResource QuickColorSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource QuickColorBorder}" />
        </Style>
        <Style x:Key="HomeIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{DynamicResource QuickHomeSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource QuickHomeBorder}" />
        </Style>
        <Style x:Key="CloseIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{DynamicResource QuickCloseSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource QuickCloseBorder}" />
        </Style>
    </Window.Resources>

    <Border x:Name="QuickBarRoot" Margin="5" Background="{StaticResource BarGradient}" BorderBrush="#61815B8C" BorderThickness="1"
            CornerRadius="20" Effect="{StaticResource BarShadow}" SnapsToDevicePixels="True">
        <Border.RenderTransform><TranslateTransform Y="0" /></Border.RenderTransform>
        <Grid MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown">
            <Border x:Name="QuickBarTopSheen" Height="1" Margin="20,0" VerticalAlignment="Top" Background="#38FFFFFF" CornerRadius="1" />
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" /><ColumnDefinition Width="5" /><ColumnDefinition Width="40" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1" /><ColumnDefinition Width="10" />
                    <ColumnDefinition Width="36" /><ColumnDefinition Width="7" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="7" /><ColumnDefinition Width="36" /><ColumnDefinition Width="21" />
                    <ColumnDefinition Width="36" /><ColumnDefinition Width="5" /><ColumnDefinition Width="36" />
                    <ColumnDefinition Width="5" /><ColumnDefinition Width="36" /><ColumnDefinition Width="5" /><ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center" ToolTipService.InitialShowDelay="180">
                    <Grid.ToolTip>
                        <ToolTip x:Name="FiveHourUsageToolTip" Placement="Bottom" Background="{DynamicResource QuickTooltipSurface}" Foreground="{DynamicResource QuickPrimaryText}"
                                 BorderBrush="{DynamicResource QuickTooltipBorder}" BorderThickness="1" Padding="11,8" FontFamily="Microsoft YaHei UI"
                                 Content="正在读取 Codex 5 小时额度…" />
                    </Grid.ToolTip>
                    <Ellipse Width="36" Height="36" Fill="{DynamicResource QuickRingSurface}" Stroke="{DynamicResource QuickRingBorder}" StrokeThickness="1" />
                    <Ellipse Width="34" Height="34" Stroke="{DynamicResource QuickRingTrack}" StrokeThickness="3" />
                    <Path x:Name="FiveHourUsageArcPath" Stroke="#8D8A9C" StrokeThickness="3" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Fill="Transparent" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="FiveHourUsagePercentText" Text="--" Foreground="{DynamicResource QuickPrimaryText}" FontWeight="Bold" FontSize="10.5"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="5H" Foreground="{DynamicResource QuickSecondaryText}" FontSize="7" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="2" Width="38" Height="38" VerticalAlignment="Center" ToolTipService.InitialShowDelay="180">
                    <Grid.ToolTip>
                        <ToolTip x:Name="LongUsageToolTip" Placement="Bottom" Background="{DynamicResource QuickTooltipSurface}" Foreground="{DynamicResource QuickPrimaryText}"
                                 BorderBrush="{DynamicResource QuickTooltipBorder}" BorderThickness="1" Padding="11,8" FontFamily="Microsoft YaHei UI"
                                 Content="正在读取 Codex 长周期额度…" />
                    </Grid.ToolTip>
                    <Ellipse Width="36" Height="36" Fill="{DynamicResource QuickRingSurface}" Stroke="{DynamicResource QuickRingBorder}" StrokeThickness="1" />
                    <Ellipse Width="34" Height="34" Stroke="{DynamicResource QuickRingTrack}" StrokeThickness="3" />
                    <Path x:Name="LongUsageArcPath" Stroke="#8D8A9C" StrokeThickness="3" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Fill="Transparent" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LongUsagePercentText" Text="--" Foreground="{DynamicResource QuickPrimaryText}" FontWeight="Bold" FontSize="10.5"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="LongUsageLabelText" Text="7D" Foreground="{DynamicResource QuickSecondaryText}" FontSize="7" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                    </StackPanel>
                </Grid>
                <Border Grid.Column="4" Width="1" Height="29" Background="{DynamicResource QuickSeparator}" VerticalAlignment="Center" />
                <Border Grid.Column="11" Width="1" Height="29" Background="{DynamicResource QuickSeparator}" VerticalAlignment="Center" />

                <Button Grid.Column="6" Style="{StaticResource PlayerButton}" Click="Previous_Click" ToolTip="上一个收藏主题">
                    <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24">
                        <Rectangle Canvas.Left="4" Canvas.Top="6" Width="2.4" Height="12" RadiusX="1.2" Fill="{DynamicResource QuickIconBrush}" />
                        <Path Data="M 19,6 L 9,12 L 19,18 Z" Fill="{DynamicResource QuickIconBrush}" />
                    </Canvas></Viewbox>
                </Button>
                <Button Grid.Column="10" Style="{StaticResource PlayerButton}" Click="Next_Click" ToolTip="下一个收藏主题">
                    <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24">
                        <Path Data="M 5,6 L 15,12 L 5,18 Z" Fill="{DynamicResource QuickIconBrush}" />
                        <Rectangle Canvas.Left="17.6" Canvas.Top="6" Width="2.4" Height="12" RadiusX="1.2" Fill="{DynamicResource QuickIconBrush}" />
                    </Canvas></Viewbox>
                </Button>

                <Border x:Name="CurrentThemePanel" Grid.Column="8" Height="44" MinWidth="172" MaxWidth="290"
                        BorderBrush="{DynamicResource QuickPanelBorder}" BorderThickness="1"
                        CornerRadius="14" Padding="12,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush x:Name="CurrentPanelGradient" StartPoint="-0.35,0" EndPoint="1.15,1">
                            <GradientStop Color="{DynamicResource QuickPanelStop0}" Offset="0" />
                            <GradientStop Color="{DynamicResource QuickPanelStop1}" Offset="0.38" />
                            <GradientStop Color="{DynamicResource QuickPanelStop2}" Offset="0.68" />
                            <GradientStop Color="{DynamicResource QuickPanelStop3}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <PointAnimation Storyboard.TargetName="CurrentPanelGradient" Storyboard.TargetProperty="StartPoint"
                                                    From="-0.35,0" To="0.18,0" Duration="0:0:5.6" AutoReverse="True" RepeatBehavior="Forever" />
                                    <PointAnimation Storyboard.TargetName="CurrentPanelGradient" Storyboard.TargetProperty="EndPoint"
                                                    From="1.15,1" To="0.82,1" Duration="0:0:5.6" AutoReverse="True" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="CurrentOrbMotion"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:12" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="CurrentOrbPulse"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="0.9" To="1.12" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="CurrentOrbPulse"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="0.9" To="1.12" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="CurrentOrbPulse" Storyboard.TargetProperty="Opacity"
                                                     From="0.42" To="0.88" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="LivePulse" Storyboard.TargetProperty="Opacity"
                                                     From="0.32" To="1" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Width="21" Height="21" VerticalAlignment="Center">
                            <Ellipse x:Name="CurrentOrbPulse" Width="20" Height="20" Fill="#66E05DA4" Opacity="0.55" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                                <Ellipse.Effect><BlurEffect Radius="5" /></Ellipse.Effect>
                            </Ellipse>
                            <Border x:Name="CurrentOrbMotion" Width="17" Height="17" CornerRadius="8.5" Background="{StaticResource CurrentGradient}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><RotateTransform Angle="0" /></Border.RenderTransform>
                                <Path Width="8" Height="8" Data="M 4,0 L 5,3 L 8,4 L 5,5 L 4,8 L 3,5 L 0,4 L 3,3 Z"
                                      Stretch="Uniform" Fill="{DynamicResource QuickIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="当前主题" Foreground="{DynamicResource QuickSecondaryText}" FontWeight="SemiBold" FontSize="8.5" />
                            <TextBlock x:Name="CurrentThemeText" Text="Codex 默认外观" Foreground="{DynamicResource QuickPrimaryText}" FontWeight="SemiBold"
                                       FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="188">
                                <TextBlock.RenderTransform><TranslateTransform X="0" /></TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource QuickBadgeSurface}" BorderBrush="{DynamicResource QuickBadgeBorder}" BorderThickness="1" CornerRadius="7"
                                Padding="6,3" VerticalAlignment="Center" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LivePulse" Width="5" Height="5" Fill="#75E7C0" Margin="0,0,4,0" />
                                <TextBlock Text="LIVE" Foreground="{DynamicResource QuickSecondaryText}" FontSize="6.5" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Button x:Name="RestoreThemeButton" Grid.Column="12" Style="{StaticResource AccentIconButton}" Click="Restore_Click" ToolTip="恢复 Codex 默认外观">
                    <Viewbox x:Name="RestoreIconViewbox" Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
                        <Viewbox.RenderTransform><RotateTransform Angle="0" /></Viewbox.RenderTransform>
                        <Canvas Width="24" Height="24">
                        <Path x:Name="RestoreIconPath" Data="M 7,8 L 3.5,8 L 3.5,4.5 M 4,8 C 6,4 10,2.5 14,3.5 C 18.5,4.5 21,9 20,13.5 C 19,18 14.5,21 10,20 C 7,19.4 4.8,17.5 3.7,15"
                              Stroke="{DynamicResource QuickIconBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="ColorModeButton" Grid.Column="14" Style="{StaticResource ColorIconButton}" Click="ToggleColor_Click" ToolTip="正在读取 Codex 明暗状态…">
                    <Viewbox x:Name="ColorIconViewbox" Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
                        <Viewbox.RenderTransform><RotateTransform Angle="0" /></Viewbox.RenderTransform>
                        <Grid Width="24" Height="24">
                            <Path x:Name="QuickMoonIcon" Visibility="Collapsed" Data="M 15,3 C 9,4 7,9 8.5,13.5 C 10,18 14.5,19.5 19,17 C 17,20.5 12.5,22 8.5,20 C 4,17.8 2,12.5 4,8 C 6,3.8 11,1.7 15,3 Z" Fill="{DynamicResource QuickIconBrush}" />
                            <Grid x:Name="QuickSunIcon" Visibility="Collapsed">
                                <Ellipse Width="8" Height="8" Fill="Transparent" Stroke="{DynamicResource QuickIconBrush}" StrokeThickness="2" />
                                <Path Data="M 12,1 L 12,4 M 12,20 L 12,23 M 1,12 L 4,12 M 20,12 L 23,12 M 4.2,4.2 L 6.2,6.2 M 17.8,17.8 L 19.8,19.8 M 19.8,4.2 L 17.8,6.2 M 6.2,17.8 L 4.2,19.8"
                                      Stroke="{DynamicResource QuickIconBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" />
                            </Grid>
                            <TextBlock x:Name="QuickColorUnknownText" Text="?" Foreground="{DynamicResource QuickIconBrush}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Viewbox>
                </Button>
                <Button Grid.Column="16" Style="{StaticResource HomeIconButton}" Click="Home_Click" ToolTip="{x:Static local:BrandInfo.OpenMainWindowTooltip}">
                    <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                        <Path Data="M 4,11.5 L 12,4.5 L 20,11.5 M 6.5,10 L 6.5,20 L 17.5,20 L 17.5,10 M 10,20 L 10,14 L 14,14 L 14,20"
                              Stroke="{DynamicResource QuickIconBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Canvas></Viewbox>
                </Button>
                <Button Grid.Column="18" Style="{StaticResource CloseIconButton}" Click="Close_Click" ToolTip="关闭浮窗并打开主页">
                    <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24">
                        <Path Data="M 6.5,6.5 L 17.5,17.5 M 17.5,6.5 L 6.5,17.5" Stroke="{DynamicResource QuickCloseIcon}" StrokeThickness="1.9" StrokeStartLineCap="Round" />
                    </Canvas></Viewbox>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
