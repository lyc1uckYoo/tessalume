<Window x:Class="Tessalume.App.ProductDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" MinHeight="228" MaxHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" KeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DialogSurfaceAltBrush" Color="#F3F5F9" />
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#DDE2EC" />
        <SolidColorBrush x:Key="DialogTextBrush" Color="#171927" />
        <SolidColorBrush x:Key="DialogMutedBrush" Color="#62697A" />
        <SolidColorBrush x:Key="DialogAccentBrush" Color="#675CF0" />
        <SolidColorBrush x:Key="DialogAccentSoftBrush" Color="#EFEDFF" />
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{DynamicResource DialogSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.86" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource DialogAccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogSurface" Margin="18" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource DialogBorderBrush}"
            BorderThickness="1" CornerRadius="20" Padding="22,18,22,20">
        <Border.Effect>
            <DropShadowEffect Color="#080B14" BlurRadius="34" ShadowDepth="10" Opacity="0.3" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                <Border x:Name="DialogIconSurface" Width="38" Height="38" CornerRadius="12" Background="{DynamicResource DialogAccentSoftBrush}" VerticalAlignment="Top">
                    <TextBlock x:Name="DialogIconText" Text="?" Foreground="{DynamicResource DialogAccentBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="4,0,12,0">
                    <TextBlock x:Name="DialogTitleText" Text="需要确认" Foreground="{DynamicResource DialogTextBrush}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="DialogMessageText" Text="请确认是否继续。" Foreground="{DynamicResource DialogMutedBrush}" FontSize="10.5"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,0" MaxHeight="300" />
                </StackPanel>
                <Button Grid.Column="2" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource DialogMutedBrush}"
                        Content="×" FontSize="16" Cursor="Hand" ToolTip="关闭" Click="Cancel_Click" />
            </Grid>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource DialogBorderBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Content="取消" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Style="{StaticResource DialogButton}" Content="确认" IsDefault="True" Margin="9,0,0,0"
                        Background="{DynamicResource DialogAccentBrush}" Foreground="White" BorderBrush="Transparent" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
