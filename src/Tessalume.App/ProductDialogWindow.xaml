<Window x:Class="Tessalume.App.ProductDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" KeyDown="Window_KeyDown"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FBFCFF" />
        <SolidColorBrush x:Key="DialogSurfaceAltBrush" Color="#F1F3FA" />
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#D7DDEA" />
        <SolidColorBrush x:Key="DialogTextBrush" Color="#171B2E" />
        <SolidColorBrush x:Key="DialogMutedBrush" Color="#5D667C" />
        <SolidColorBrush x:Key="DialogAccentBrush" Color="#6558E8" />
        <SolidColorBrush x:Key="DialogAccentSoftBrush" Color="#EEEBFF" />
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{DynamicResource DialogSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.86" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource DialogAccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogCloseButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DialogMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseChrome" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseChrome" Property="Background" Value="{DynamicResource DialogSurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseChrome" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseChrome" Property="Background" Value="{DynamicResource DialogAccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogSurface" Margin="10" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource DialogBorderBrush}"
            BorderThickness="1" CornerRadius="18" Padding="20,16,20,16">
        <Border.Effect>
            <DropShadowEffect Color="#080B14" BlurRadius="28" ShadowDepth="7" Opacity="0.24" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions>
                <Border x:Name="DialogIconSurface" Width="34" Height="34" CornerRadius="11" Background="{DynamicResource DialogAccentSoftBrush}" VerticalAlignment="Top">
                    <TextBlock x:Name="DialogIconText" Text="?" Foreground="{DynamicResource DialogAccentBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="DialogTitleText" Grid.Column="1" Margin="3,2,10,0" Text="需要确认" TextWrapping="Wrap"
                           Foreground="{DynamicResource DialogTextBrush}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Top" />
                <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource DialogCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        AutomationProperties.Name="关闭提示" Content="×" FontSize="15" ToolTip="关闭" Click="Cancel_Click" />
            </Grid>
            <ScrollViewer x:Name="DialogMessageScrollViewer" Grid.Row="1" Margin="45,7,0,0" MaxHeight="340"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" PanningMode="VerticalOnly" Focusable="False">
                <TextBlock x:Name="DialogMessageText" Text="请确认是否继续。" Foreground="{DynamicResource DialogMutedBrush}" FontSize="12"
                           TextWrapping="Wrap" LineHeight="21" Padding="0,0,7,0" />
            </ScrollViewer>
            <Border Grid.Row="2" Height="1" Background="{DynamicResource DialogBorderBrush}" Margin="0,14,0,12" VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Content="取消" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Style="{StaticResource DialogButton}" Content="确认" IsDefault="True" Margin="9,0,0,0"
                        Background="{DynamicResource DialogAccentBrush}" Foreground="White" BorderBrush="Transparent" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
