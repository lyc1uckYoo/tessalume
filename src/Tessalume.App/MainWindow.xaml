                        </Grid>
                    </Button>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="10,13,10,12" />
                    <TextBlock Text="SYSTEM" Foreground="{DynamicResource Accent}" Opacity="0.72" FontSize="8.5" FontWeight="SemiBold" Margin="12,0,0,7" />
                    <Button x:Name="DiagnosticsButton" Style="{StaticResource NavButton}" Click="Diagnostics_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 3,13 L 7,13 L 9.5,7 L 13,18 L 15.5,11 L 21,11" />
                            <TextBlock Grid.Column="1" Text="运行与诊断" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource NavButton}" Click="Settings_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 20,18 M 8,3 L 8,9 M 16,9 L 16,15 M 10,15 L 10,21" />
                            <TextBlock Grid.Column="1" Text="偏好设置" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="RestoreTheme_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 7,8 L 3,8 L 3,4 M 3.5,8 C 5.8,3.5 11,2 15.5,4.2 C 20,6.5 21.5,12 19,16.5 C 16.5,21 10.8,22 6.7,19.2 C 5.2,18.2 4,16.8 3.4,15.2" />
                            <TextBlock Grid.Column="1" Text="恢复默认外观" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="10,13,10,12" />
                    <TextBlock Text="DEVELOPER" Foreground="{DynamicResource Amber}" Opacity="0.78" FontSize="8.5" FontWeight="SemiBold" Margin="12,0,0,7" />
                    <Button x:Name="ImportGuideButton" Style="{StaticResource NavButton}" Click="ImportGuide_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 12,3 L 12,15 M 7.5,10.5 L 12,15 L 16.5,10.5 M 4,18 L 4,21 L 20,21 L 20,18" />
                            <TextBlock Grid.Column="1" Text="导入主题" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="UsageGuideButton" Style="{StaticResource NavButton}" Click="UsageGuide_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 4,4 C 8,3 10,4 12,6 L 12,20 C 10,18 8,17 4,18 Z M 20,4 C 16,3 14,4 12,6 L 12,20 C 14,18 16,17 20,18 Z" />
                            <TextBlock Grid.Column="1" Text="开发指南" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Row="4" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="13" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="9" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Positive}" VerticalAlignment="Top" Margin="0,4,0,0" />
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                            <TextBlock Text="LOCAL RUNTIME" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="9.5" />
                            <TextBlock Text="主题只在本机运行，不修改 Codex 安装文件。" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="9.5" LineHeight="15" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="ThemeLibraryPage" Grid.Column="1" Margin="28,22,28,20" Opacity="1">
            <Grid.RenderTransform><TranslateTransform Y="0" /></Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="CategoryTitleText" Text="主题画廊" Foreground="{DynamicResource PrimaryText}" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock x:Name="CategoryDescriptionText" Text="为 Codex 选择一个完整的视觉世界。" Foreground="{DynamicResource MutedText}" FontSize="11.5" Margin="1,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Height="34" VerticalAlignment="Center" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="11,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="EngineStateDot" Width="7" Height="7" Fill="{DynamicResource SubtleText}" Margin="0,0,7,0" />
                        <TextBlock x:Name="EngineStateText" Text="主题引擎待启动" Foreground="{DynamicResource PrimaryText}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="QuickSwitchButton" Grid.Column="3" Style="{StaticResource FeatureButton}" Width="116" Click="QuickSwitchButton_Click" Content="打开主题浮窗" />
                <Button x:Name="StartupButton" Grid.Column="5" Style="{StaticResource FeatureButton}" Width="116" Click="StartupButton_Click" Content="开启开机启动" />
                <Border Grid.Column="7" Height="38" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LightModeButton" Style="{StaticResource ModeToggleButton}" Tag="light" Click="StudioMode_Click" ToolTip="切换为亮色界面">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Data="M 12,8 A 4,4 0 1 1 11.9,8 M 12,1 L 12,3 M 12,21 L 12,23 M 1,12 L 3,12 M 21,12 L 23,12 M 4.2,4.2 L 5.7,5.7 M 18.3,18.3 L 19.8,19.8 M 19.8,4.2 L 18.3,5.7 M 5.7,18.3 L 4.2,19.8"
                                       Style="{StaticResource NavIcon}" Margin="0,0,6,0" />
                                <TextBlock Text="亮色" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DarkModeButton" Style="{StaticResource ModeToggleButton}" Tag="dark" Click="StudioMode_Click" ToolTip="切换为暗色界面">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Data="M 15,3 C 9,4 7,9 8.5,13.5 C 10,18 14.5,19.5 19,17 C 17,20.5 12.5,22 8.5,20 C 4,17.8 2,12.5 4,8 C 6,3.8 11,1.7 15,3 Z"
                                       Style="{StaticResource NavIcon}" Margin="0,0,6,0" />
                                <TextBlock Text="暗色" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Height="92" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="18" Padding="18,0" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="15" Background="{DynamicResource PrimaryGradient}" VerticalAlignment="Center">
                        <Grid>
                            <Path Width="21" Height="21" Data="M 10.5,1 L 12.3,7.8 L 20,10.5 L 12.3,13.2 L 10.5,20 L 8.7,13.2 L 1,10.5 L 8.7,7.8 Z"
                                  Stretch="Uniform" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="DeclarationIconText" Text="" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="ImportDeclarationTitleText" Text="你的视觉工作台" Foreground="{DynamicResource PrimaryText}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="ImportDeclarationBodyText" Text="浏览、收藏并一键应用完整沉浸式主题。" Foreground="{DynamicResource MutedText}" FontSize="10.5" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="3" Width="1" Height="44" Background="{DynamicResource Border}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Width="70">
                            <TextBlock x:Name="ThemeCountText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="本地主题" Style="{StaticResource PillText}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Width="70">
                            <TextBlock x:Name="FavoriteCountText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="已收藏" Style="{StaticResource PillText}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="ImportButton" Grid.Column="7" Height="38" Click="ImportTheme_Click" Style="{StaticResource PrimaryActionButton}" Content="导入主题" />
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,2,0,10">
                    <ItemsControl x:Name="ThemeItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,2,6,14">
                                    <Button x:Name="CardButton" Tag="{Binding}" Click="ThemeCard_Click" Background="Transparent"
                                            BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Button.RenderTransform><ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" /></Button.RenderTransform>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="MotionSurface" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform><TranslateTransform x:Name="CardLift" Y="0" /></Border.RenderTransform>
                                                    <ContentPresenter VerticalAlignment="Top" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Opacity" Value="0.92" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Border x:Name="CardFrame" Height="276" CornerRadius="17" Background="Transparent" Effect="{StaticResource CardShadow}">
                                        <Grid>
                                        <Border x:Name="CardShell" CornerRadius="16" Background="{DynamicResource SurfaceElevated}"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                SizeChanged="RoundedCard_SizeChanged">
                                            <Grid>
                                                <Grid x:Name="PreviewArea" Background="{DynamicResource AdvancedPreview}">
                                                    <Rectangle x:Name="PreviewImage">
                                                        <Rectangle.Fill>
                                                            <ImageBrush ImageSource="{Binding Preview}"
                                                                        Stretch="UniformToFill"
                                                                        AlignmentX="{Binding PreviewAlignmentX}" />
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <Grid x:Name="FallbackPreview" Background="{Binding FallbackBackground}">
                                                        <Ellipse Width="230" Height="230" Fill="{Binding FallbackAccent}" Opacity="0.13" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-115,-55,0" />
                                                        <Ellipse Width="170" Height="170" Fill="{Binding FallbackAccent}" Opacity="0.10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-60,0,0,-96" />
                                                        <Border Width="330" Height="142" CornerRadius="14" Background="{Binding FallbackPanel}" BorderBrush="#62FFFFFF" BorderThickness="1">
                                                            <Grid Margin="16">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <Border CornerRadius="11" Background="{Binding FallbackAccent}" Opacity="0.16" />
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <Rectangle Width="96" Height="7" RadiusX="3.5" RadiusY="3.5" Fill="{Binding FallbackAccent}" HorizontalAlignment="Left" Opacity="0.72" />
                                                                    <Rectangle Height="6" RadiusX="3" RadiusY="3" Fill="{Binding FallbackAccent}" Opacity="0.20" Margin="0,15,28,0" />
                                                                    <Rectangle Height="6" RadiusX="3" RadiusY="3" Fill="{Binding FallbackAccent}" Opacity="0.14" Margin="0,9,62,0" />
                                                                    <Border Height="30" CornerRadius="8" Background="White" Opacity="0.68" Margin="0,16,0,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                                <Border>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0.26" />
                                                            <GradientStop Color="#1A080B12" Offset="0.5" />
                                                            <GradientStop Color="#D90A0C13" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border Margin="1" CornerRadius="15" BorderBrush="#32FFFFFF" BorderThickness="1" />
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Background="#B50A0C12" CornerRadius="7" Padding="9,5">
                                                    <TextBlock Text="{Binding TypeLabel}" Foreground="#EFFFFFFF" FontSize="8.5" FontWeight="SemiBold" />
                                                </Border>
                                                <Grid VerticalAlignment="Bottom" Margin="17,0,16,16">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Description}" Foreground="#C9FFFFFF" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,50,0" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                            <TextBlock Text="{Binding Author}" Foreground="#EFFFFFFF" FontSize="8.5" FontWeight="SemiBold" />
                                                            <Border Width="3" Height="3" CornerRadius="1.5" Background="#78FFFFFF" Margin="8,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Version, StringFormat=v{0}}" Foreground="#AFFFFFFF" FontSize="8.5" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border x:Name="SelectedMark" Grid.Column="1" Height="26" CornerRadius="8" Background="{DynamicResource PrimaryActionGradient}"
                                                            Padding="9,0"
                                                            VerticalAlignment="Bottom" Opacity="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="5" Height="5" Fill="White" Margin="0,0,6,0" />
                                                            <TextBlock Text="已应用" Foreground="White" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="SelectionRing" CornerRadius="16" BorderBrush="{DynamicResource PrimaryActionGradient}" BorderThickness="1.5"
                                                 Opacity="0" IsHitTestVisible="False" />
                                        </Grid>
                                        </Border>
                                    </Button>
                                    <Button x:Name="FavoriteButton" Tag="{Binding}" Click="FavoriteTheme_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,13,13,0" Width="34" Height="34" Background="#A80A0C12" Foreground="White"
                                            BorderBrush="#3FFFFFFF" BorderThickness="1" Padding="0" Panel.ZIndex="2" ToolTip="收藏主题" Content="♡">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="FavoriteChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform><ScaleTransform x:Name="FavoriteScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FavoriteChrome" Property="Opacity" Value="0.9" /></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="FavoriteChrome" Property="Opacity" Value="0.68" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasPreview}" Value="False"><Setter TargetName="PreviewImage" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding HasPreview}" Value="True"><Setter TargetName="FallbackPreview" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="CardFrame" Property="Effect" Value="{StaticResource SelectedCardShadow}" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" From="0.975" To="1" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" From="0.975" To="1" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="SelectionRing" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0:0:0.16" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectionRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                            </Storyboard></BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                        <Setter TargetName="SelectedMark" Property="Opacity" Value="1" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectedMark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                            </Storyboard></BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectedMark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                            </Storyboard></BeginStoryboard>
