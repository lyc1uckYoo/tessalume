                        </Border>

                        <TextBlock Text="导入流程" Style="{StaticResource SectionEyebrowText}" Margin="1,18,0,9" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource InsetCard}"><StackPanel><TextBlock Text="01" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" /><TextBlock Text="选择来源" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="文件夹或 ZIP 均可" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>
