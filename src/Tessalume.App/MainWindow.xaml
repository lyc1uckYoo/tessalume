                    <StackPanel Grid.Column="1" Margin="10,1,0,0">
                        <TextBlock Text="{x:Static local:BrandInfo.ProductName}" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="15.5" />
