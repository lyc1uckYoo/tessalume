                            <Grid x:Name="SettingsThemeSwitchPanel" Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
