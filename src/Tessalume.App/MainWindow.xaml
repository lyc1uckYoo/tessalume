                                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="饱和" Foreground="{DynamicResource MutedText}" FontSize="9.5" VerticalAlignment="Center" /><Slider x:Name="HeroSaturationSlider" Grid.Column="1" Style="{StaticResource SettingsSlider}" Tag="hero.saturation" Minimum="0" Maximum="200" Value="100" ValueChanged="VisualAdjustmentSlider_ValueChanged" AutoToolTipPlacement="TopLeft" /><Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="7" Padding="4,3" Margin="5,0,0,0"><TextBlock x:Name="HeroSaturationValue" Text="100%" Foreground="{DynamicResource PrimaryText}" FontSize="8.5" TextAlignment="Center" /></Border></Grid>
                                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="透明" Foreground="{DynamicResource MutedText}" FontSize="9.5" VerticalAlignment="Center" /><Slider x:Name="HeroOpacitySlider" Grid.Column="1" Style="{StaticResource SettingsSlider}" Tag="hero.opacity" Minimum="0" Maximum="100" Value="100" ValueChanged="VisualAdjustmentSlider_ValueChanged" AutoToolTipPlacement="TopLeft" /><Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="7" Padding="4,3" Margin="5,0,0,0"><TextBlock x:Name="HeroOpacityValue" Text="100%" Foreground="{DynamicResource PrimaryText}" FontSize="8.5" TextAlignment="Center" /></Border></Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="15" Padding="14">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource AccentSoft}"><Path Width="14" Height="14" Data="M 4,3 L 10,3 L 10,21 L 4,21 Z M 12,6 L 20,6 L 20,21 L 12,21 Z M 6.8,12 L 7.2,12" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Stretch="Uniform" /></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="左栏图片" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="导航区域人物原图" Foreground="{DynamicResource SubtleText}" FontSize="8.5" /></StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource SettingsMiniButton}" Tag="sidebar" Click="ResetVisualRegion_Click" ToolTip="重置左栏图片"><Path Width="13" Height="13" Data="M 7,8 L 3,8 L 3,4 M 3.5,8 C 5.8,3.5 11,2 15.5,4.2 C 20,6.5 21.5,12 19,16.5" Stroke="{DynamicResource MutedText}" StrokeThickness="1.8" Fill="Transparent" Stretch="Uniform" /></Button>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,11,0,7" />
                                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="亮度" Foreground="{DynamicResource MutedText}" FontSize="9.5" VerticalAlignment="Center" /><Slider x:Name="SidebarBrightnessSlider" Grid.Column="1" Style="{StaticResource SettingsSlider}" Tag="sidebar.brightness" Minimum="20" Maximum="180" Value="100" ValueChanged="VisualAdjustmentSlider_ValueChanged" AutoToolTipPlacement="TopLeft" /><Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="7" Padding="4,3" Margin="5,0,0,0"><TextBlock x:Name="SidebarBrightnessValue" Text="100%" Foreground="{DynamicResource PrimaryText}" FontSize="8.5" TextAlignment="Center" /></Border></Grid>
                                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="对比" Foreground="{DynamicResource MutedText}" FontSize="9.5" VerticalAlignment="Center" /><Slider x:Name="SidebarContrastSlider" Grid.Column="1" Style="{StaticResource SettingsSlider}" Tag="sidebar.contrast" Minimum="20" Maximum="180" Value="100" ValueChanged="VisualAdjustmentSlider_ValueChanged" AutoToolTipPlacement="TopLeft" /><Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="7" Padding="4,3" Margin="5,0,0,0"><TextBlock x:Name="SidebarContrastValue" Text="100%" Foreground="{DynamicResource PrimaryText}" FontSize="8.5" TextAlignment="Center" /></Border></Grid>
                                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="饱和" Foreground="{DynamicResource MutedText}" FontSize="9.5" VerticalAlignment="Center" /><Slider x:Name="SidebarSaturationSlider" Grid.Column="1" Style="{StaticResource SettingsSlider}" Tag="sidebar.saturation" Minimum="0" Maximum="200" Value="100" ValueChanged="VisualAdjustmentSlider_ValueChanged" AutoToolTipPlacement="TopLeft" /><Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="7" Padding="4,3" Margin="5,0,0,0"><TextBlock x:Name="SidebarSaturationValue" Text="100%" Foreground="{DynamicResource PrimaryText}" FontSize="8.5" TextAlignment="Center" /></Border></Grid>
                                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="透明" Foreground="{DynamicResource MutedText}" FontSize="9.5" VerticalAlignment="Center" /><Slider x:Name="SidebarOpacitySlider" Grid.Column="1" Style="{StaticResource SettingsSlider}" Tag="sidebar.opacity" Minimum="0" Maximum="100" Value="100" ValueChanged="VisualAdjustmentSlider_ValueChanged" AutoToolTipPlacement="TopLeft" /><Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="7" Padding="4,3" Margin="5,0,0,0"><TextBlock x:Name="SidebarOpacityValue" Text="100%" Foreground="{DynamicResource PrimaryText}" FontSize="8.5" TextAlignment="Center" /></Border></Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="15" Padding="14">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource AmberSoft}"><Path Width="14" Height="14" Data="M 4,5 C 4,3.9 4.9,3 6,3 L 18,3 C 19.1,3 20,3.9 20,5 L 20,15 C 20,16.1 19.1,17 18,17 L 10,17 L 6,21 L 6,17 C 4.9,17 4,16.1 4,15 Z M 8,8 L 16,8 M 8,12 L 13,12" Stroke="{DynamicResource Amber}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" /></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="聊天背景" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="对话主区域背景原图" Foreground="{DynamicResource SubtleText}" FontSize="8.5" /></StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource SettingsMiniButton}" Tag="chat" Click="ResetVisualRegion_Click" ToolTip="重置聊天背景"><Path Width="13" Height="13" Data="M 7,8 L 3,8 L 3,4 M 3.5,8 C 5.8,3.5 11,2 15.5,4.2 C 20,6.5 21.5,12 19,16.5" Stroke="{DynamicResource MutedText}" StrokeThickness="1.8" Fill="Transparent" Stretch="Uniform" /></Button>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,11,0,7" />
                                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="亮度" Foreground="{DynamicResource MutedText}" FontSize="9.5" VerticalAlignment="Center" /><Slider x:Name="ChatBrightnessSlider" Grid.Column="1" Style="{StaticResource SettingsSlider}" Tag="chat.brightness" Minimum="20" Maximum="180" Value="100" ValueChanged="VisualAdjustmentSlider_ValueChanged" AutoToolTipPlacement="TopLeft" /><Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="7" Padding="4,3" Margin="5,0,0,0"><TextBlock x:Name="ChatBrightnessValue" Text="100%" Foreground="{DynamicResource PrimaryText}" FontSize="8.5" TextAlignment="Center" /></Border></Grid>
                                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="对比" Foreground="{DynamicResource MutedText}" FontSize="9.5" VerticalAlignment="Center" /><Slider x:Name="ChatContrastSlider" Grid.Column="1" Style="{StaticResource SettingsSlider}" Tag="chat.contrast" Minimum="20" Maximum="180" Value="100" ValueChanged="VisualAdjustmentSlider_ValueChanged" AutoToolTipPlacement="TopLeft" /><Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="7" Padding="4,3" Margin="5,0,0,0"><TextBlock x:Name="ChatContrastValue" Text="100%" Foreground="{DynamicResource PrimaryText}" FontSize="8.5" TextAlignment="Center" /></Border></Grid>
                                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="饱和" Foreground="{DynamicResource MutedText}" FontSize="9.5" VerticalAlignment="Center" /><Slider x:Name="ChatSaturationSlider" Grid.Column="1" Style="{StaticResource SettingsSlider}" Tag="chat.saturation" Minimum="0" Maximum="200" Value="100" ValueChanged="VisualAdjustmentSlider_ValueChanged" AutoToolTipPlacement="TopLeft" /><Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="7" Padding="4,3" Margin="5,0,0,0"><TextBlock x:Name="ChatSaturationValue" Text="100%" Foreground="{DynamicResource PrimaryText}" FontSize="8.5" TextAlignment="Center" /></Border></Grid>
                                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock Text="透明" Foreground="{DynamicResource MutedText}" FontSize="9.5" VerticalAlignment="Center" /><Slider x:Name="ChatOpacitySlider" Grid.Column="1" Style="{StaticResource SettingsSlider}" Tag="chat.opacity" Minimum="0" Maximum="100" Value="100" ValueChanged="VisualAdjustmentSlider_ValueChanged" AutoToolTipPlacement="TopLeft" /><Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="7" Padding="4,3" Margin="5,0,0,0"><TextBlock x:Name="ChatOpacityValue" Text="100%" Foreground="{DynamicResource PrimaryText}" FontSize="8.5" TextAlignment="Center" /></Border></Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="17">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSoft}"><Path Width="16" Height="16" Data="M 12,2 L 12,7 M 7.5,4.5 A 8,8 0 1 0 16.5,4.5" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" Fill="Transparent" Stretch="Uniform" /></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="开机自动启动" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="登录 Windows 后自动显示主题悬浮窗" Foreground="{DynamicResource MutedText}" FontSize="9" Margin="0,3,12,0" /></StackPanel>
                                    <CheckBox x:Name="StartupCheckBox" Grid.Column="2" Style="{StaticResource SettingsToggle}" VerticalAlignment="Center" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="16" Padding="17">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource Surface}"><Path Width="16" Height="16" Data="M 12,2 L 20,6 L 20,12 C 20,17 16.8,20.3 12,22 C 7.2,20.3 4,17 4,12 L 4,6 Z M 9,12 L 11,14 L 15.5,9.5" Stroke="{DynamicResource Positive}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" /></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="本地保存 · 安全生效" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="主题参数仅保存在便携版 data 目录，不修改 Codex 安装文件。" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="9" Margin="0,3,0,0" /></StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="DiagnosticsInfoPanel" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock Text="运行与诊断" Foreground="{DynamicResource PrimaryText}" FontSize="27" FontWeight="Bold" />
                        <TextBlock Text="仅检查本机主题库、Codex 进程与本机回环端口，不访问互联网。" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="1,6,0,20" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="CODEX" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="DiagnosticCodexText" Text="正在检查…" Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border>
                            <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="本机端口" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="DiagnosticPortText" Text="正在检查…" Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border>
                            <Border Grid.Column="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="主题包" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="DiagnosticThemesText" Text="正在检查…" Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border>
                        </Grid>
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="诊断详情" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="11" Padding="14">
                                        <StackPanel><TextBlock Text="STUDIO 根目录" Foreground="{DynamicResource SubtleText}" FontSize="9" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticRootText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="11" Padding="14">
                                        <StackPanel><TextBlock Text="本地主题库" Foreground="{DynamicResource SubtleText}" FontSize="9" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticLibraryText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                                    </Border>
                                    <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="11" Padding="14">
                                        <StackPanel><TextBlock Text="CODEX 进程" Foreground="{DynamicResource SubtleText}" FontSize="9" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticProcessText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="11" Padding="14">
                                        <StackPanel><TextBlock Text="本机回环连接" Foreground="{DynamicResource SubtleText}" FontSize="9" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticLoopbackText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel>
                                    </Border>
                                    <Border Grid.Row="4" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="11" Padding="14">
                                        <StackPanel><TextBlock Text="主题状态" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticThemeStateText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock x:Name="DiagnosticCurrentThemeText" Text="当前主题：—" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="2" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="11" Padding="14">
                                        <StackPanel><TextBlock Text="主题包校验" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="SemiBold" /><TextBlock x:Name="DiagnosticValidationText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="仅本机注入 · 无公网请求" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource RoundButton}" Click="Diagnostics_Click" Content="↻ 刷新诊断" HorizontalAlignment="Left" Margin="0,18,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
