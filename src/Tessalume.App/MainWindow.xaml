                                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="8,4" Margin="0,0,7,0"><TextBlock Text="skin.css" Foreground="{DynamicResource Accent}" FontFamily="Cascadia Mono" FontSize="10" /></Border>
                                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="8,4" Margin="0,0,7,0"><TextBlock Text="theme.js" Foreground="{DynamicResource Accent}" FontFamily="Cascadia Mono" FontSize="10" /></Border>
                                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="8,4"><TextBlock Text="assets/" Foreground="{DynamicResource Accent}" FontFamily="Cascadia Mono" FontSize="10" /></Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="3" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="16">
