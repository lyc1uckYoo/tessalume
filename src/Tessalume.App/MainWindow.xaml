                            <Border Grid.Column="4" Style="{StaticResource InsetCard}"><StackPanel><TextBlock Text="03" Foreground="{DynamicResource Amber}" FontSize="10" FontWeight="Bold" /><TextBlock Text="加入主题库" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="完整复制到便携目录" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>
                            <Border Grid.Column="6" Style="{StaticResource InsetCard}"><StackPanel><TextBlock Text="04" Foreground="{DynamicResource Teal}" FontSize="10" FontWeight="Bold" /><TextBlock Text="预览并应用" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="从画廊选择并实时切换" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>
