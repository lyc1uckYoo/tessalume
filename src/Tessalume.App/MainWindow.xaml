<Window x:Class="Tessalume.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tessalume.App"
        xmlns:controls="clr-namespace:Tessalume.App.Controls"
        xmlns:creator="clr-namespace:Tessalume.App.Creator"
        xmlns:about="clr-namespace:Tessalume.App.Features.About"
        xmlns:diagnostics="clr-namespace:Tessalume.App.Features.Diagnostics"
        xmlns:personalization="clr-namespace:Tessalume.App.Features.Personalization"
        Title="{x:Static local:BrandInfo.WindowTitle}"
        Icon="{x:Static local:BrandInfo.AppIcon}"
        Width="1280" Height="820" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/MainWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="AdaptiveViewport" Background="{DynamicResource WindowBackground}" ClipToBounds="True" SizeChanged="AdaptiveViewport_SizeChanged">
      <Grid x:Name="AdaptiveRoot" MinWidth="1080" MinHeight="720" Background="{DynamicResource WindowBackground}">
        <Grid.LayoutTransform><ScaleTransform x:Name="AdaptiveScale" ScaleX="1" ScaleY="1" /></Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
          <Grid ClipToBounds="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
            <Ellipse Width="210" Height="210" Fill="{DynamicResource SidebarGlowOne}" Opacity="0.055" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-116,-112,0" />
            <Ellipse Width="170" Height="170" Fill="{DynamicResource SidebarGlowTwo}" Opacity="0.04" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-105,0,0,-96" />
            <Border Width="1" HorizontalAlignment="Right" Background="{DynamicResource Accent}" Opacity="0.12" />
            <Grid Margin="14,16,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource SidebarBrandSurface}" BorderBrush="{DynamicResource SidebarBrandBorder}" BorderThickness="1" CornerRadius="15" Padding="10,9">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource SidebarBrandBorder}" BorderThickness="1">
                        <Image Width="32" Height="32" Source="{x:Static local:BrandInfo.AppLogo}" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static local:BrandInfo.ProductName}" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="万棱流光 · THEME STUDIO" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="UpdateAvailableBadge"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource UpdateBadgeButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-6,-4,0"
                            Visibility="Collapsed"
                            Click="UpdateAvailableBadge_Click"
                            ToolTip="发现新版本，点击查看并安装"
                            AutomationProperties.Name="发现新版本，点击更新">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="White" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="更新" Foreground="White" FontSize="10" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                  <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SidebarScrollBar}" />
                  </ScrollViewer.Resources>
                  <StackPanel>
                    <TextBlock Text="主题" Style="{StaticResource SidebarSectionLabel}" />
                    <Button x:Name="ThemesButton" Style="{StaticResource NavButton}" Click="ShowThemes_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 2,2 L 9,2 L 9,9 L 2,9 Z M 13,2 L 20,2 L 20,9 L 13,9 Z M 2,13 L 9,13 L 9,20 L 2,20 Z M 13,13 L 20,13 L 20,20 L 13,20 Z" />
                            <TextBlock Grid.Column="1" Text="主题画廊" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="FavoritesButton" Style="{StaticResource NavButton}" Click="ShowFavorites_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 12,20 C 9,17.6 4,14 4,8.7 C 4,5.8 6,4 8.4,4 C 10,4 11.2,4.8 12,6 C 12.8,4.8 14,4 15.6,4 C 18,4 20,5.8 20,8.7 C 20,14 15,17.6 12,20 Z" />
                            <TextBlock x:Name="FavoritesLabelText" Grid.Column="1" Text="我的收藏" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Border Height="1" Background="{DynamicResource SidebarBrandBorder}" Margin="10,13,10,12" />
                    <TextBlock Text="个性化" Style="{StaticResource SidebarSectionLabel}" />
                    <Button x:Name="SettingsButton" Style="{StaticResource NavButton}" Click="Settings_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 4,4 L 20,4 L 20,20 L 4,20 Z M 7,16 L 11,12 L 14,15 L 17,10 M 15.5,7 A 1.5,1.5 0 1 1 15.4,7" />
                            <TextBlock Grid.Column="1" Text="图像工作台" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="ExperienceButton" Style="{StaticResource NavButton}" Click="Experience_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 20,18 M 8,3 L 8,9 M 16,9 L 16,15 M 10,15 L 10,21" />
                            <TextBlock Grid.Column="1" Text="显示与方案" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Border Height="1" Background="{DynamicResource SidebarBrandBorder}" Margin="10,13,10,12" />
                    <TextBlock Text="创作" Style="{StaticResource SidebarSectionLabel}" Foreground="{DynamicResource Amber}" />
                    <Button x:Name="ImportGuideButton" Style="{StaticResource NavButton}" Click="ImportGuide_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 12,3 L 12,15 M 7.5,10.5 L 12,15 L 16.5,10.5 M 4,18 L 4,21 L 20,21 L 20,18" />
                            <TextBlock Grid.Column="1" Text="导入主题" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="CreatorCenterButton" Style="{StaticResource NavButton}" Click="CreatorCenter_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 4,4 C 8,3 10,4 12,6 L 12,20 C 10,18 8,17 4,18 Z M 20,4 C 16,3 14,4 12,6 L 12,20 C 14,18 16,17 20,18 Z" />
                            <TextBlock Grid.Column="1" Text="创作项目中心" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Border Height="1" Background="{DynamicResource SidebarBrandBorder}" Margin="10,13,10,12" />
                    <TextBlock Text="系统" Style="{StaticResource SidebarSectionLabel}" />
                    <Button x:Name="DiagnosticsButton" Style="{StaticResource NavButton}" Click="Diagnostics_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 3,13 L 7,13 L 9.5,7 L 13,18 L 15.5,11 L 21,11" />
                            <TextBlock Grid.Column="1" Text="运行与诊断" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="DataButton" Style="{StaticResource NavButton}" Click="Data_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 4,7 C 4,4 20,4 20,7 C 20,10 4,10 4,7 Z M 4,7 L 4,17 C 4,20 20,20 20,17 L 20,7 M 4,12 C 4,15 20,15 20,12" />
                            <TextBlock Grid.Column="1" Text="更新与数据" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="AboutButton" Style="{StaticResource NavButton}" Click="About_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource NavIcon}" Data="M 12,21 A 9,9 0 1 1 12,3 A 9,9 0 1 1 12,21 M 12,10 L 12,17 M 12,7 L 12,7" />
                            <TextBlock Grid.Column="1" Text="关于 Tessalume" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                  </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="4" Background="{DynamicResource SidebarStatusSurface}" BorderBrush="{DynamicResource SidebarStatusBorder}" BorderThickness="1" CornerRadius="14" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="12" Height="12" VerticalAlignment="Top" Margin="0,2,0,0">
                            <Ellipse Fill="{DynamicResource Positive}" Opacity="0.16" />
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Positive}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                            <TextBlock Text="本地安全运行" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" FontSize="11" />
                            <TextBlock Text="主题仅作用于当前会话，不修改 Codex 安装文件。" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="10" LineHeight="16" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
          </Grid>
        </Border>

        <Grid x:Name="ThemeLibraryPage" Grid.Column="1" Margin="30,24,30,20" Opacity="1"
              TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
              TextOptions.TextHintingMode="Fixed" SnapsToDevicePixels="True"
              AllowDrop="True" DragEnter="ThemeLibraryPage_DragOver" DragOver="ThemeLibraryPage_DragOver"
              DragLeave="ThemeLibraryPage_DragLeave" Drop="ThemeLibraryPage_Drop">
            <Grid.RenderTransform><TranslateTransform Y="0" /></Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MinHeight="58">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TESSALUME  THEME LIBRARY" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="CategoryTitleText" Text="主题画廊" Foreground="{DynamicResource PrimaryText}" FontSize="28" FontWeight="Bold" />
                        <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource Teal}" Margin="10,0,0,7" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="CategoryDescriptionText" Text="浏览本地主题，并在应用前确认完整的视觉体验。" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="1,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Height="36" VerticalAlignment="Center" Background="{DynamicResource HomeToolbarSurface}" BorderBrush="{DynamicResource HomeToolbarBorder}" BorderThickness="1" CornerRadius="10" Padding="12,0">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource Accent}" Opacity="0.13" />
                            <Ellipse x:Name="EngineStateDot" Width="6" Height="6" Fill="{DynamicResource SubtleText}" />
                        </Grid>
                        <TextBlock x:Name="EngineStateText" Text="主题引擎待启动" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="QuickSwitchButton" Grid.Column="3" Style="{StaticResource HomeUtilityButton}" Width="116" Click="QuickSwitchButton_Click" Content="打开主题浮窗" />
                <Button x:Name="StartupButton" Grid.Column="5" Style="{StaticResource HomeUtilityButton}" Width="116" Click="StartupButton_Click" Content="开启开机启动" />
                <Border Grid.Column="7" Height="38" Background="{DynamicResource HomeToolbarSurface}" BorderBrush="{DynamicResource HomeToolbarBorder}" BorderThickness="1" CornerRadius="11" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LightModeButton" Style="{StaticResource HomeModeToggleButton}" Tag="light" Click="StudioMode_Click" ToolTip="切换为亮色界面">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Data="M 12,8 A 4,4 0 1 1 11.9,8 M 12,1 L 12,3 M 12,21 L 12,23 M 1,12 L 3,12 M 21,12 L 23,12 M 4.2,4.2 L 5.7,5.7 M 18.3,18.3 L 19.8,19.8 M 19.8,4.2 L 18.3,5.7 M 5.7,18.3 L 4.2,19.8"
                                       Style="{StaticResource NavIcon}" Margin="0,0,6,0" />
                                <TextBlock Text="亮色" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DarkModeButton" Style="{StaticResource HomeModeToggleButton}" Tag="dark" Click="StudioMode_Click" ToolTip="切换为暗色界面">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Data="M 15,3 C 9,4 7,9 8.5,13.5 C 10,18 14.5,19.5 19,17 C 17,20.5 12.5,22 8.5,20 C 4,17.8 2,12.5 4,8 C 6,3.8 11,1.7 15,3 Z"
                                       Style="{StaticResource NavIcon}" Margin="0,0,6,0" />
                                <TextBlock Text="暗色" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Height="96" Background="{DynamicResource HomeHeroGradient}" BorderBrush="{DynamicResource HomeHeroBorder}" BorderThickness="1" CornerRadius="18" ClipToBounds="True" Effect="{StaticResource HomeHeroShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="220" Height="220" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-142,-20,0" Fill="{DynamicResource HomeHeroGlowOne}" Opacity="0.11" />
                    <Ellipse Width="160" Height="160" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,245,-120" Fill="{DynamicResource HomeHeroGlowTwo}" Opacity="0.10" />
                    <Grid Margin="20,10,16,10" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource PrimaryGradient}" VerticalAlignment="Center">
                            <Grid>
                                <Ellipse Width="34" Height="34" Fill="#24FFFFFF" />
                                <TextBlock x:Name="DeclarationIconText" Text="✦" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="CURATE YOUR CODEX" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="ImportDeclarationTitleText" Text="管理你的主题体验" Foreground="{DynamicResource PrimaryText}" FontSize="19" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock x:Name="ImportDeclarationBodyText" Text="导入、收藏与实时切换都在本机完成，Codex 安装文件保持不变。" Foreground="{DynamicResource HomeHeroMuted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="520" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1" Margin="0,10,16,10" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Height="60" Background="{DynamicResource HomeHeroPanel}" BorderBrush="{DynamicResource HomeHeroBorder}" BorderThickness="1" CornerRadius="13">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ThemeCountText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="本地主题" Foreground="{DynamicResource HomeHeroMuted}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Height="60" Background="{DynamicResource HomeHeroPanel}" BorderBrush="{DynamicResource HomeHeroBorder}" BorderThickness="1" CornerRadius="13">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="FavoriteCountText" Text="—" Foreground="{DynamicResource PrimaryText}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="我的收藏" Foreground="{DynamicResource HomeHeroMuted}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="ImportButton" Grid.Column="4" Width="124" Click="ImportTheme_Click" Style="{StaticResource HomeHeroActionButton}" Content="＋  导入主题" ToolTip="选择主题文件夹（Ctrl+I）" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource HomeToolbarSurface}" BorderBrush="{DynamicResource HomeToolbarBorder}" BorderThickness="1" CornerRadius="14" Padding="10,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="ThemeSearchBox" Style="{StaticResource HomeSearchTextBox}" TextChanged="ThemeSearchBox_TextChanged"
                                 GotKeyboardFocus="ThemeSearchBox_FocusChanged" LostKeyboardFocus="ThemeSearchBox_FocusChanged"
                                 AutomationProperties.Name="搜索主题" ToolTip="按主题名称、说明、作者或 ID 搜索" />
                        <Path Width="15" Height="15" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"
                              Data="M 6,11 A 5,5 0 1 1 6,1 A 5,5 0 1 1 6,11 M 9.5,9.5 L 13.5,13.5"
                              Stretch="Uniform" Stroke="{DynamicResource MutedText}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                        <TextBlock x:Name="ThemeSearchPlaceholder" Text="搜索名称、作者或主题 ID" Foreground="{DynamicResource SubtleText}"
                                   FontSize="12" VerticalAlignment="Center" Margin="42,0,34,0" IsHitTestVisible="False" />
                        <Button x:Name="ClearThemeSearchButton" Content="×" Width="25" Height="25" HorizontalAlignment="Right" Margin="0,0,6,0"
                                Visibility="Collapsed" Style="{StaticResource HomeCrispButton}" Padding="0" FontSize="14"
                                ToolTip="清除搜索" AutomationProperties.Name="清除主题搜索" Click="ClearThemeSearch_Click" />
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AllThemesFilterButton" Style="{StaticResource HomeFilterChipButton}" Content="全部" Tag="all" Click="ThemeFilter_Click" />
                        <Button x:Name="LightThemesFilterButton" Style="{StaticResource HomeFilterChipButton}" Content="亮色" Tag="light" Margin="7,0,0,0" Click="ThemeFilter_Click" />
                        <Button x:Name="DarkThemesFilterButton" Style="{StaticResource HomeFilterChipButton}" Content="暗色" Tag="dark" Margin="7,0,0,0" Click="ThemeFilter_Click" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeSortComboBox" Grid.Column="4" Width="150" Height="38" FontSize="11"
                              Style="{StaticResource SettingsComboBox}" SelectedValuePath="Tag" SelectedIndex="0"
                              SelectionChanged="ThemeSortComboBox_SelectionChanged" ToolTip="调整主题排列顺序"
                              AutomationProperties.Name="主题排序">
                        <ComboBoxItem Content="默认顺序" Tag="default" />
                        <ComboBoxItem Content="最近使用" Tag="recent" />
                        <ComboBoxItem Content="按名称" Tag="name" />
                        <ComboBoxItem Content="按作者" Tag="author" />
                    </ComboBox>
                    <Button Grid.Column="6" Height="38" Style="{StaticResource HomeCrispButton}" Padding="12,0"
                            Click="RefreshThemes_Click" ToolTip="重新扫描本地主题目录" AutomationProperties.Name="刷新本地主题库">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Data="M 19,7 L 19,3 L 15,3 M 19,3 C 16.5,1.2 12.8,1.5 10.5,3.2 C 8.7,4.5 7.7,6.4 7.5,8.4 M 5,17 L 5,21 L 9,21 M 5,21 C 7.5,22.8 11.2,22.5 13.5,20.8 C 15.3,19.5 16.3,17.6 16.5,15.6"
                                  Style="{StaticResource NavIcon}" Margin="0,0,6,0" />
                            <TextBlock Text="刷新" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="ThemeResultText" Grid.Column="8" Text="显示全部主题" Foreground="{DynamicResource MutedText}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                  </Grid>
                </Border>

                <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,2,0,10">
                    <ItemsControl x:Name="ThemeItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,3,6,14">
                                    <Button x:Name="CardButton" Tag="{Binding}" Click="ThemeCard_Click" Background="Transparent"
                                            BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Button.RenderTransform><ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" /></Button.RenderTransform>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="MotionSurface" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform><TranslateTransform x:Name="CardLift" Y="0" /></Border.RenderTransform>
                                                    <ContentPresenter VerticalAlignment="Top" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.18">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2">
