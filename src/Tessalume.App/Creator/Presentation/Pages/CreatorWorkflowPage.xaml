<UserControl x:Class="Tessalume.App.Creator.CreatorWorkflowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{DynamicResource ProductCard}" Padding="17">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="主题创作流程" Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="从角色研究到发布导出，每一步都由当前项目体检结果驱动。" Foreground="{DynamicResource MutedText}" FontSize="10.5" Margin="0,4,0,0" /></StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="9" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="{Binding WorkflowProgressText}" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" /></Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding WorkflowStages}" Margin="0,14,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,8,0" BorderThickness="1" CornerRadius="12" Padding="12,11">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource TealSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Teal}" /><Style.Triggers><DataTrigger Binding="{Binding StatusTone}" Value="warning"><Setter Property="Background" Value="{DynamicResource AmberSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Amber}" /></DataTrigger><DataTrigger Binding="{Binding StatusTone}" Value="error"><Setter Property="Background" Value="{DynamicResource SurfaceAlt}" /><Setter Property="BorderBrush" Value="{DynamicResource Border}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Number}" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource MutedText}" FontSize="9.5" /></Grid><TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedText}" FontSize="9.5" TextWrapping="Wrap" LineHeight="14" Margin="0,4,0,0" /></StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border x:Name="ProjectDetailCard" Style="{DynamicResource ProductCard}" Margin="0,15,0,0" Padding="17" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding SelectedProject.DisplayName}" Foreground="{DynamicResource PrimaryText}" FontSize="17" FontWeight="SemiBold" /><TextBlock Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,5,0,0"><Run Text="{Binding SelectedProject.CharacterName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedProject.ThemeId, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedProject.VersionText, Mode=OneWay}" /></TextBlock></StackPanel>
                    <Button Grid.Column="1" Style="{DynamicResource QuietActionButton}" Content="打开项目目录" Click="OpenProjectFolder_Click" />
                    <Button Grid.Column="3" Style="{DynamicResource SecondaryActionButton}" Content="立即重新体检" IsEnabled="{Binding CanRevalidateSelectedProject}" Click="RevalidateProject_Click" />
                </Grid>

                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{DynamicResource TealSoft}" BorderBrush="{DynamicResource Teal}" BorderThickness="1" CornerRadius="11" Padding="12,9"><StackPanel><TextBlock Text="发布状态" Foreground="{DynamicResource MutedText}" FontSize="10" /><TextBlock Text="{Binding SelectedProject.StatusText}" Foreground="{DynamicResource Teal}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border><Border Grid.Column="2" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="12,9"><StackPanel><TextBlock Text="视觉覆盖" Foreground="{DynamicResource MutedText}" FontSize="10" /><TextBlock Text="{Binding SelectedProject.CapabilityText}" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border><Border Grid.Column="4" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="12,9"><StackPanel><TextBlock Text="素材清单" Foreground="{DynamicResource MutedText}" FontSize="10" /><TextBlock Text="{Binding SelectedProject.AssetText}" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border></Grid>

                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="13" Padding="14" Margin="0,15,0,0">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本地开发会话" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="文件写入稳定后自动体检；不会读取 Codex 对话。" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0" /></StackPanel><Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="9,5"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,7,0" /><TextBlock Text="{Binding WatcherStatusText}" Foreground="{DynamicResource PrimaryText}" FontSize="10" FontWeight="SemiBold" /></StackPanel></Border></Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="12,10"><StackPanel><TextBlock Text="文件监控与体检" Foreground="{DynamicResource PrimaryText}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding WatcherActivityText}" Foreground="{DynamicResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border><Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="12,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding CodexStatusText}" Foreground="{DynamicResource PrimaryText}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding CodexModeText}" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0" /></StackPanel><Button Grid.Column="1" Style="{DynamicResource CreatorDevButton}" Content="切换亮暗" IsEnabled="{Binding CanToggleCodexMode}" Click="ToggleCodexMode_Click" /></Grid></Border></Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{DynamicResource CreatorDevButton}" Content="重新体检" IsEnabled="{Binding CanRevalidateSelectedProject}" Click="RevalidateProject_Click" /><Button Grid.Column="2" Style="{DynamicResource CreatorDevButton}" Content="重新应用到 Codex" IsEnabled="{Binding CanApplySelectedProject}" Click="ApplyProject_Click" /><ToggleButton Grid.Column="4" Style="{DynamicResource CreatorSwitch}" IsChecked="{Binding AutoApplyEnabled, Mode=TwoWay}" AutomationProperties.Name="校验通过后自动应用" /><StackPanel Grid.Column="6"><TextBlock Text="校验通过后自动应用" Foreground="{DynamicResource PrimaryText}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding LastAppliedText}" Foreground="{DynamicResource MutedText}" FontSize="9.5" Margin="0,3,0,0" /></StackPanel></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="WorkflowEmptyPanel" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,15,0,0">
            <StackPanel HorizontalAlignment="Center"><TextBlock Text="先在“工作区与项目”选择一个主题" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="选择后会生成五阶段流程并启动本地文件监听。" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,5,0,0" /></StackPanel>
        </Border>
    </StackPanel>
</UserControl>
