<UserControl x:Class="Tessalume.App.Creator.CreatorAcceptancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border x:Name="AcceptanceProjectCard" Style="{DynamicResource ProductCard}" Padding="18" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="运行验收" Foreground="{DynamicResource PrimaryText}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="一次检查亮色、暗色、输入框、消息框和响应式布局；完成后自动恢复进入验收前的明暗模式。" Foreground="{DynamicResource MutedText}" FontSize="10.5" Margin="0,5,18,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{DynamicResource PrimaryActionButton}" Content="开始批量验收" Height="38" Padding="18,0" IsEnabled="{Binding CanRunAcceptance}" Click="RunAcceptance_Click" />
                </Grid>

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource AmberSoft}" BorderBrush="{DynamicResource Amber}" BorderThickness="1" CornerRadius="11" Padding="13,10"><StackPanel><TextBlock Text="主题项目问题" Foreground="{DynamicResource MutedText}" FontSize="9.5" /><TextBlock Text="{Binding StaticThemeIssueCount, StringFormat={}{0} 项}" Foreground="{DynamicResource Amber}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border>
                    <Border Grid.Column="2" Background="{DynamicResource SkySoft}" BorderBrush="{DynamicResource Sky}" BorderThickness="1" CornerRadius="11" Padding="13,10"><StackPanel><TextBlock Text="运行时兼容问题" Foreground="{DynamicResource MutedText}" FontSize="9.5" /><TextBlock Text="{Binding RuntimeCompatibilityIssueCount, StringFormat={}{0} 项}" Foreground="{DynamicResource Sky}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border>
                    <Border Grid.Column="4" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="13,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="验收状态" Foreground="{DynamicResource MutedText}" FontSize="9.5" /><TextBlock Text="{Binding AcceptanceSummaryText}" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,12,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding AcceptanceCompletedText}" Foreground="{DynamicResource MutedText}" FontSize="9.5" VerticalAlignment="Center" /></Grid></Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding AcceptanceChecks}" Margin="0,14,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="12,11" Margin="0,0,8,0" MinHeight="132">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="25" Height="25" CornerRadius="8" Background="{DynamicResource AccentSoft}"><TextBlock Text="{Binding Number}" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" /><Border Grid.Column="2" Style="{DynamicResource CreatorStatusPill}"><TextBlock Text="{Binding StatusText}" Style="{DynamicResource CreatorStatusText}" /></Border></Grid>
                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedText}" FontSize="9.5" TextWrapping="Wrap" LineHeight="14" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding OriginText}" Foreground="{DynamicResource Accent}" FontSize="9" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="11" Padding="13,10" Margin="0,12,0,0"><TextBlock Text="归因规则：清单、素材、CSS、脚本和主题挂载失败归入“主题项目”；Codex 页面识别、语义标记和自适应规则失效归入“运行时兼容”。" Foreground="{DynamicResource MutedText}" FontSize="10" TextWrapping="Wrap" /></Border>
            </StackPanel>
        </Border>
        <Border x:Name="AcceptanceEmptyPanel" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel HorizontalAlignment="Center"><TextBlock Text="先选择需要验收的主题项目" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="选择项目后，这里会建立五项批量验收清单，并在验收完成后更新发布门禁。" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,5,0,0" /></StackPanel></Border>
    </StackPanel>
</UserControl>
