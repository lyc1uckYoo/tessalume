<UserControl x:Class="Tessalume.App.Creator.CreatorReleasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border x:Name="ReleaseProjectCard" Style="{DynamicResource ProductCard}" Padding="18" Visibility="Collapsed">
            <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="发布前最终清单" Foreground="{DynamicResource PrimaryText}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding ReleaseReadinessText}" Foreground="{DynamicResource MutedText}" FontSize="10.5" Margin="0,5,0,0" /></StackPanel><Border Grid.Column="1" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="11,6"><TextBlock Text="本地验收 · ZIP + SHA-256" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" /></Border></Grid>
                <ItemsControl ItemsSource="{Binding ReleaseChecklist}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="13,10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="26" Height="26" CornerRadius="8" Style="{DynamicResource CreatorChecklistIcon}"><TextBlock Text="{Binding IconText}" Style="{DynamicResource CreatorChecklistIconText}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedText}" FontSize="9.5" Margin="0,3,0,0" /></StackPanel><Border Grid.Column="2" Style="{DynamicResource CreatorStatusPill}" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" Style="{DynamicResource CreatorStatusText}" /></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,7,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedProject.DisplayName}" Foreground="{DynamicResource PrimaryText}" FontSize="12" FontWeight="SemiBold" /><TextBlock Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0"><Run Text="{Binding SelectedProject.ThemeId, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedProject.VersionText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedProject.AssetText, Mode=OneWay}" /></TextBlock></StackPanel><Button Grid.Column="1" Style="{DynamicResource QuietActionButton}" Content="打开项目目录" Click="OpenProjectFolder_Click" /><Button Grid.Column="3" Style="{DynamicResource PrimaryActionButton}" Content="导出分享 ZIP" Height="36" IsEnabled="{Binding CanReleaseSelectedProject}" Click="ExportProject_Click" /></Grid></Border>
            </StackPanel>
        </Border>
        <Border x:Name="ReleaseEmptyPanel" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel HorizontalAlignment="Center"><TextBlock Text="选择项目后生成发布清单" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="清单通过后才会启用导出，避免漏图、缺少暗色或残留阻断错误。" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,5,0,0" /></StackPanel></Border>
    </StackPanel>
</UserControl>
