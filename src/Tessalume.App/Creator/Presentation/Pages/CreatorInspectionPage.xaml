<UserControl x:Class="Tessalume.App.Creator.CreatorInspectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <StackPanel>
        <Border x:Name="InspectionProjectCard" Style="{DynamicResource ProductCard}" Padding="17" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="项目体检" Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold" /><TextBlock Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0"><Run Text="{Binding SelectedProject.DisplayName, Mode=OneWay}" /><Run Text=" · 错误 " /><Run Text="{Binding SelectedProject.ErrorCount, Mode=OneWay}" /><Run Text=" 项 · 建议 " /><Run Text="{Binding SelectedProject.WarningCount, Mode=OneWay}" /><Run Text=" 项" /></TextBlock></StackPanel>
                    <Button Grid.Column="1" Style="{DynamicResource SecondaryActionButton}" Content="重新体检" IsEnabled="{Binding CanRevalidateSelectedProject}" Click="RevalidateProject_Click" />
                    <Button x:Name="RepairPromptButton" Grid.Column="3" Style="{DynamicResource PrimaryActionButton}" Content="{Binding SelectedProject.RepairPromptButtonText}" IsEnabled="{Binding SelectedProject.CanCopyRepairPrompt}" Click="CopyRepairPrompt_Click" AutomationProperties.Name="复制当前主题修复提示词" Visibility="Collapsed" />
                </Grid>
                <Border Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="11" Padding="12,9" Margin="0,13,0,4"><TextBlock Text="错误会阻止应用和导出；体检会单独检查六槽原图推荐值，并阻止 CSS 重新写死裁切、滤镜、透明度、遮罩或图片动效。点击“定位”可直接打开相关文件。" Foreground="{DynamicResource MutedText}" FontSize="10" TextWrapping="Wrap" /></Border>
                <ItemsControl ItemsSource="{Binding HealthGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="13,11" Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Accent}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0" /><TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{DynamicResource MutedText}" FontSize="10" /></Grid>
                                    <ItemsControl ItemsSource="{Binding Checks}" Margin="0,8,0,0">
                                        <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasProblems}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource MutedText}" FontSize="10" TextWrapping="Wrap" LineHeight="14" Margin="0,4,8,0" /></StackPanel><Button Grid.Column="1" Content="定位" Tag="{Binding FilePath}" Click="OpenHealthPath_Click" VerticalAlignment="Top" Style="{DynamicResource CreatorMiniButton}" Visibility="{Binding HasFilePath, Converter={StaticResource BooleanToVisibility}}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border x:Name="InspectionEmptyPanel" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel HorizontalAlignment="Center"><TextBlock Text="尚未选择体检项目" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="返回工作区页面选择主题后，这里会按清单、素材、预览和脚本分组显示结果。" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,5,0,0" /></StackPanel></Border>
    </StackPanel>
</UserControl>
