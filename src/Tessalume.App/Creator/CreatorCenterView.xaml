<UserControl x:Class="Tessalume.App.Creator.CreatorCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="clr-namespace:Tessalume.App.Creator"
             FontFamily="Microsoft YaHei UI"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             Focusable="False"
             FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Presentation/Styles/CreatorCenterResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,4">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="创作项目中心" Foreground="{DynamicResource PrimaryText}" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="从角色需求到体检、亮暗验收和分享包，按阶段管理本地主题项目。" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="1,6,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="11" Padding="11,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource Positive}" Margin="0,0,7,0" /><TextBlock Text="CREATOR STUDIO 2.0" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" /></StackPanel>
            </Border>
        </Grid>

        <Border x:Name="CreatorRouteBar" Style="{DynamicResource ProductCard}" Padding="10" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button x:Name="WorkspaceRouteButton" Tag="active" Style="{DynamicResource CreatorRouteButton}" Click="WorkspaceRoute_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource AccentSoft}"><TextBlock Text="01" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="工作区与项目" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="创建、打开和选择主题" Foreground="{DynamicResource MutedText}" FontSize="9.5" Margin="0,2,0,0" /></StackPanel></Grid>
                </Button>
                <Button x:Name="WorkflowRouteButton" Grid.Column="2" Style="{DynamicResource CreatorRouteButton}" Click="WorkflowRoute_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource TealSoft}"><TextBlock Text="02" Foreground="{DynamicResource Teal}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="创作流程" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="五阶段进度与开发会话" Foreground="{DynamicResource MutedText}" FontSize="9.5" Margin="0,2,0,0" /></StackPanel></Grid>
                </Button>
                <Button x:Name="InspectionRouteButton" Grid.Column="4" Style="{DynamicResource CreatorRouteButton}" Click="InspectionRoute_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource AmberSoft}"><TextBlock Text="03" Foreground="{DynamicResource Amber}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="项目体检" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="定位问题并生成修复提示" Foreground="{DynamicResource MutedText}" FontSize="9.5" Margin="0,2,0,0" /></StackPanel></Grid>
                </Button>
                <Button x:Name="AcceptanceRouteButton" Grid.Column="6" Style="{DynamicResource CreatorRouteButton}" Click="AcceptanceRoute_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource SkySoft}"><TextBlock Text="04" Foreground="{DynamicResource Sky}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="运行验收" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="亮暗与关键表面批量检查" Foreground="{DynamicResource MutedText}" FontSize="9.5" Margin="0,2,0,0" /></StackPanel></Grid>
                </Button>
                <Button x:Name="ReleaseRouteButton" Grid.Column="8" Style="{DynamicResource CreatorRouteButton}" Click="ReleaseRoute_Click">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource TealSoft}"><TextBlock Text="05" Foreground="{DynamicResource Teal}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="发布清单" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="最终门禁与 ZIP 导出" Foreground="{DynamicResource MutedText}" FontSize="9.5" Margin="0,2,0,0" /></StackPanel></Grid>
                </Button>
            </Grid>
        </Border>

        <Grid Margin="0,14,0,0">
            <creator:CreatorWorkspacePage x:Name="WorkspacePage"
                CreateWorkspaceRequested="CreateWorkspace_Click"
                OpenWorkspaceRequested="OpenWorkspace_Click"
                CopyTemplateRequested="CopyManualTemplate_Click"
                RelocateWorkspaceRequested="RelocateWorkspace_Click"
                RemoveWorkspaceRequested="RemoveWorkspace_Click"
                RefreshWorkspaceRequested="RefreshWorkspace_Click"
                OpenWorkspaceFolderRequested="OpenWorkspaceFolder_Click"
                UpgradeWorkspaceRequested="UpgradeWorkspace_Click"
                WorkspaceSelectionChanged="WorkspaceList_SelectionChanged"
                ProjectSelectionChanged="ProjectList_SelectionChanged"
                TogglePromptEditorRequested="TogglePromptEditor_Click"
                CopyPromptRequested="CopyPrompt_Click"
                ResetPromptRequested="ResetPrompt_Click"
                PromptChanged="PromptField_Changed" />
            <creator:CreatorWorkflowPage x:Name="WorkflowPage" Visibility="Collapsed"
                OpenProjectFolderRequested="OpenProjectFolder_Click"
                RevalidateProjectRequested="RevalidateProject_Click"
                ApplyProjectRequested="ApplyProjectToCodex_Click"
                ToggleCodexModeRequested="ToggleCreatorCodexMode_Click" />
            <creator:CreatorInspectionPage x:Name="InspectionPage" Visibility="Collapsed"
                RevalidateProjectRequested="RevalidateProject_Click"
                CopyRepairPromptRequested="CopyRepairPrompt_Click"
                OpenHealthPathRequested="OpenHealthPath_Click" />
            <creator:CreatorAcceptancePage x:Name="AcceptancePage" Visibility="Collapsed"
                RunAcceptanceRequested="RunAcceptance_Click" />
            <creator:CreatorReleasePage x:Name="ReleasePage" Visibility="Collapsed"
                OpenProjectFolderRequested="OpenProjectFolder_Click"
                ExportProjectRequested="ExportProject_Click" />
        </Grid>

        <Border Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="13" Padding="14,11" Margin="0,12,0,0">
            <TextBlock Text="所有扫描、体检和导出均在本机完成；Tessalume 不读取 Codex 对话，也不会上传主题项目或创作素材。" Foreground="{DynamicResource MutedText}" FontSize="10" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
