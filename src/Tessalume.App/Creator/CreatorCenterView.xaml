<UserControl x:Class="Tessalume.App.Creator.CreatorCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creator="clr-namespace:Tessalume.App.Creator"
             FontFamily="Microsoft YaHei UI"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             Focusable="False"
             FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Presentation/Styles/CreatorCenterResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,4">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="主题创作助手" Foreground="{DynamicResource PrimaryText}" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="告诉 Tessalume 你想做谁，剩下的每一步都会根据项目状态自动提醒。" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="1,6,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="11" Padding="11,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource Positive}" Margin="0,0,7,0" /><TextBlock Text="CREATOR TOOLCHAIN 2.0" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" /></StackPanel>
            </Border>
        </Grid>

        <Border x:Name="CreatorGuidanceCard" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Guidance.StepText}" Foreground="{DynamicResource Accent}" FontSize="8.5" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="31" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="GuidanceTitleText" Text="{Binding Guidance.Title}" Foreground="{DynamicResource PrimaryText}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="GuidanceDescriptionText" Text="{Binding Guidance.Description}" Foreground="{DynamicResource MutedText}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,4,16,0" />
                </StackPanel>
                <Button x:Name="GuidancePrimaryButton" Grid.Column="2" Style="{DynamicResource PrimaryActionButton}" Content="{Binding Guidance.PrimaryActionText}" MinWidth="148" Height="38" Padding="17,0" FontSize="10.5" Click="GuidancePrimary_Click" />
            </Grid>
        </Border>

        <Border x:Name="CreatorRouteBar" Style="{DynamicResource ProductCard}" Padding="10" Margin="0,12,0,0">
            <UniformGrid Rows="1" Columns="5">
                <Button x:Name="WorkspaceRouteButton" Tag="active" Style="{DynamicResource CreatorRouteButton}" Click="WorkspaceRoute_Click" Margin="0,0,4,0" ToolTip="需求、工作区与项目">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource Surface}"><TextBlock Text="01" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="开始" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="WorkflowRouteButton" Style="{DynamicResource CreatorRouteButton}" Click="WorkflowRoute_Click" Margin="4,0" ToolTip="查看当前创作进度">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource Surface}"><TextBlock Text="02" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="制作" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="InspectionRouteButton" Style="{DynamicResource CreatorRouteButton}" Click="InspectionRoute_Click" Margin="4,0" ToolTip="定位问题并交给 Codex">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource Surface}"><TextBlock Text="03" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="修复" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="AcceptanceRouteButton" Style="{DynamicResource CreatorRouteButton}" Click="AcceptanceRoute_Click" Margin="4,0" ToolTip="自动检查真实页面">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource Surface}"><TextBlock Text="04" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="验收" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="ReleaseRouteButton" Style="{DynamicResource CreatorRouteButton}" Click="ReleaseRoute_Click" Margin="4,0,0,0" ToolTip="最终清单与分享包">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource Surface}"><TextBlock Text="05" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="导出" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                </Button>
            </UniformGrid>
        </Border>

        <Grid Margin="0,14,0,0">
            <creator:CreatorWorkspacePage x:Name="WorkspacePage"
                CreateWorkspaceRequested="CreateWorkspace_Click"
                OpenWorkspaceRequested="OpenWorkspace_Click"
                CopyTemplateRequested="CopyManualTemplate_Click"
                RelocateWorkspaceRequested="RelocateWorkspace_Click"
                RemoveWorkspaceRequested="RemoveWorkspace_Click"
                RefreshWorkspaceRequested="RefreshWorkspace_Click"
                OpenWorkspaceFolderRequested="OpenWorkspaceFolder_Click"
                UpgradeWorkspaceRequested="UpgradeWorkspace_Click"
                WorkspaceSelectionChanged="WorkspaceList_SelectionChanged"
                ProjectSelectionChanged="ProjectList_SelectionChanged"
                TogglePromptEditorRequested="TogglePromptEditor_Click"
                CopyPromptRequested="CopyPrompt_Click"
                ResetPromptRequested="ResetPrompt_Click"
                PromptChanged="PromptField_Changed"
                StartNewThemeRequested="StartNewTheme_Click"
                CancelNewThemeRequested="CancelNewTheme_Click" />
            <creator:CreatorWorkflowPage x:Name="WorkflowPage" Visibility="Collapsed"
                OpenProjectFolderRequested="OpenProjectFolder_Click"
                RevalidateProjectRequested="RevalidateProject_Click"
                ApplyProjectRequested="ApplyProjectToCodex_Click"
                ToggleCodexModeRequested="ToggleCreatorCodexMode_Click" />
            <creator:CreatorInspectionPage x:Name="InspectionPage" Visibility="Collapsed"
                RevalidateProjectRequested="RevalidateProject_Click"
                CopyRepairPromptRequested="CopyRepairPrompt_Click"
                OpenHealthPathRequested="OpenHealthPath_Click" />
            <creator:CreatorAcceptancePage x:Name="AcceptancePage" Visibility="Collapsed"
                RunAcceptanceRequested="RunAcceptance_Click" />
            <creator:CreatorReleasePage x:Name="ReleasePage" Visibility="Collapsed"
                OpenProjectFolderRequested="OpenProjectFolder_Click"
                ExportProjectRequested="ExportProject_Click" />
        </Grid>

        <Border Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="13" Padding="14,11" Margin="0,12,0,0">
            <TextBlock Text="所有扫描、体检和导出均在本机完成；Tessalume 不读取 Codex 对话，也不会上传主题项目或创作素材。" Foreground="{DynamicResource MutedText}" FontSize="10" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
