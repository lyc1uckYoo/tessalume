<UserControl x:Class="Tessalume.App.Controls.ArtworkAdjustmentEditor"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="274"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">
    <UserControl.Resources>
        <Style x:Key="AdjustmentLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AdjustmentValue" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoft}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="ToolTip" Value="输入数值，或使用方向键微调；按住 Shift 可加速" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceElevated}"
            BorderBrush="{DynamicResource HomeToolbarBorder}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="15"
            Effect="{DynamicResource HomeCardShadow}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="12" Background="{Binding HeaderAccentSoft, ElementName=Root}">
                    <Path Width="17" Height="17" Data="{Binding IconData, ElementName=Root}"
                          Stroke="{Binding HeaderAccent, ElementName=Root}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Fill="Transparent" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, ElementName=Root}" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock x:Name="CustomImageStatusText" Text="亮色模式 · 主题原图" Foreground="{Binding HeaderAccent, ElementName=Root}" FontSize="10.5" FontWeight="SemiBold" Margin="0,4,8,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle, ElementName=Root}" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ChooseImageButton" Style="{DynamicResource SettingsMiniButton}" Click="ChooseImage_Click"
                            Width="92" Height="36" Padding="12,0" FontSize="10.5" FontWeight="SemiBold" Content="更换图片" ToolTip="为当前亮暗模式选择本地图片" AutomationProperties.Name="选择本地替换图片" />
                    <Button x:Name="ClearImageButton" Style="{DynamicResource SettingsMiniButton}" Click="ClearImage_Click" Margin="7,0,0,0"
                            Width="106" Height="36" Padding="12,0" FontSize="10.5" FontWeight="SemiBold" Content="使用主题原图" ToolTip="只撤下本地替换图片，保留当前调节参数" AutomationProperties.Name="撤下替换图片并使用主题原图" />
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{DynamicResource HomeToolbarBorder}" Margin="0,12,0,10" />

            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="GroupTitleText" Text="基础调节" Foreground="{DynamicResource PrimaryText}" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="GroupHintText" Text="改善明暗与色彩；建议一次只调整一个参数。" Foreground="{DynamicResource MutedText}" FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,3,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CopyButton" Style="{DynamicResource SettingsMiniButton}" Click="Copy_Click"
                            Width="76" Height="32" Padding="10,0" FontSize="10" FontWeight="SemiBold" Content="复制参数" ToolTip="复制当前区域参数，不包含图片来源" AutomationProperties.Name="复制当前区域参数" />
                    <Button x:Name="PasteButton" Style="{DynamicResource SettingsMiniButton}" Click="Paste_Click" Margin="6,0,0,0"
                            Width="76" Height="32" Padding="10,0" FontSize="10" FontWeight="SemiBold" Content="粘贴参数" ToolTip="粘贴参数并保留目标区域的图片来源" AutomationProperties.Name="粘贴区域参数" IsEnabled="False" />
                    <Button x:Name="ResetButton" Style="{DynamicResource SettingsMiniButton}" Click="Reset_Click" Margin="6,0,0,0"
                            Width="88" Height="32" Padding="10,0" FontSize="10" FontWeight="SemiBold" ToolTip="只重置当前显示的参数组，可使用撤销恢复" AutomationProperties.Name="重置当前参数组">
                        <TextBlock x:Name="ResetButtonText" Text="重置基础" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="BasicPanel">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                    <TextBlock Text="亮度" Style="{StaticResource AdjustmentLabel}" />
                    <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{DynamicResource SettingsSlider}" Tag="brightness" AutomationProperties.Name="图像亮度" Minimum="20" Maximum="180" Value="100" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" />
                    <TextBox x:Name="BrightnessValue" Grid.Column="2" Tag="brightness" Text="100%" Style="{StaticResource AdjustmentValue}" GotKeyboardFocus="ValueEditor_GotKeyboardFocus" LostKeyboardFocus="ValueEditor_LostKeyboardFocus" PreviewKeyDown="ValueEditor_PreviewKeyDown" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                    <TextBlock Text="对比" Style="{StaticResource AdjustmentLabel}" />
                    <Slider x:Name="ContrastSlider" Grid.Column="1" Style="{DynamicResource SettingsSlider}" Tag="contrast" AutomationProperties.Name="图像对比度" Minimum="20" Maximum="180" Value="100" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" />
                    <TextBox x:Name="ContrastValue" Grid.Column="2" Tag="contrast" Text="100%" Style="{StaticResource AdjustmentValue}" GotKeyboardFocus="ValueEditor_GotKeyboardFocus" LostKeyboardFocus="ValueEditor_LostKeyboardFocus" PreviewKeyDown="ValueEditor_PreviewKeyDown" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                    <TextBlock Text="饱和" Style="{StaticResource AdjustmentLabel}" />
                    <Slider x:Name="SaturationSlider" Grid.Column="1" Style="{DynamicResource SettingsSlider}" Tag="saturation" AutomationProperties.Name="图像饱和度" Minimum="0" Maximum="200" Value="100" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" />
                    <TextBox x:Name="SaturationValue" Grid.Column="2" Tag="saturation" Text="100%" Style="{StaticResource AdjustmentValue}" GotKeyboardFocus="ValueEditor_GotKeyboardFocus" LostKeyboardFocus="ValueEditor_LostKeyboardFocus" PreviewKeyDown="ValueEditor_PreviewKeyDown" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                    <TextBlock Text="透明" Style="{StaticResource AdjustmentLabel}" />
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Style="{DynamicResource SettingsSlider}" Tag="opacity" AutomationProperties.Name="图像不透明度" Minimum="0" Maximum="100" Value="100" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" />
                    <TextBox x:Name="OpacityValue" Grid.Column="2" Tag="opacity" Text="100%" Style="{StaticResource AdjustmentValue}" GotKeyboardFocus="ValueEditor_GotKeyboardFocus" LostKeyboardFocus="ValueEditor_LostKeyboardFocus" PreviewKeyDown="ValueEditor_PreviewKeyDown" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="CompositionPanel" Visibility="Collapsed">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                    <TextBlock Text="缩放" Style="{StaticResource AdjustmentLabel}" />
                    <Slider x:Name="ZoomSlider" Grid.Column="1" Style="{DynamicResource SettingsSlider}" Tag="zoom" AutomationProperties.Name="图像缩放" Minimum="70" Maximum="200" Value="100" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" />
                    <TextBox x:Name="ZoomValue" Grid.Column="2" Tag="zoom" Text="100%" Style="{StaticResource AdjustmentValue}" GotKeyboardFocus="ValueEditor_GotKeyboardFocus" LostKeyboardFocus="ValueEditor_LostKeyboardFocus" PreviewKeyDown="ValueEditor_PreviewKeyDown" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                    <TextBlock Text="水平" Style="{StaticResource AdjustmentLabel}" />
                    <Slider x:Name="OffsetXSlider" Grid.Column="1" Style="{DynamicResource SettingsSlider}" Tag="offsetX" AutomationProperties.Name="图像水平位置" Minimum="-200" Maximum="200" Value="0" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" />
                    <TextBox x:Name="OffsetXValue" Grid.Column="2" Tag="offsetX" Text="0 px" Style="{StaticResource AdjustmentValue}" GotKeyboardFocus="ValueEditor_GotKeyboardFocus" LostKeyboardFocus="ValueEditor_LostKeyboardFocus" PreviewKeyDown="ValueEditor_PreviewKeyDown" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                    <TextBlock Text="垂直" Style="{StaticResource AdjustmentLabel}" />
                    <Slider x:Name="OffsetYSlider" Grid.Column="1" Style="{DynamicResource SettingsSlider}" Tag="offsetY" AutomationProperties.Name="图像垂直位置" Minimum="-200" Maximum="200" Value="0" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" />
                    <TextBox x:Name="OffsetYValue" Grid.Column="2" Tag="offsetY" Text="0 px" Style="{StaticResource AdjustmentValue}" GotKeyboardFocus="ValueEditor_GotKeyboardFocus" LostKeyboardFocus="ValueEditor_LostKeyboardFocus" PreviewKeyDown="ValueEditor_PreviewKeyDown" />
                </Grid>
                <TextBlock Text="位置是在主题原始裁切上追加偏移，不会改写主题文件。" Foreground="{DynamicResource MutedText}" FontSize="10" TextWrapping="Wrap" LineHeight="17" Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel x:Name="EffectsPanel" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock Text="灰度" Style="{StaticResource AdjustmentLabel}" />
                            <Slider x:Name="GrayscaleSlider" Grid.Column="1" Style="{DynamicResource SettingsSlider}" Tag="grayscale" AutomationProperties.Name="图像灰度" Minimum="0" Maximum="100" Value="0" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" />
                            <TextBox x:Name="GrayscaleValue" Grid.Column="2" Tag="grayscale" Text="0%" Style="{StaticResource AdjustmentValue}" GotKeyboardFocus="ValueEditor_GotKeyboardFocus" LostKeyboardFocus="ValueEditor_LostKeyboardFocus" PreviewKeyDown="ValueEditor_PreviewKeyDown" />
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock Text="色相" Style="{StaticResource AdjustmentLabel}" />
                            <Slider x:Name="HueRotationSlider" Grid.Column="1" Style="{DynamicResource SettingsSlider}" Tag="hueRotation" AutomationProperties.Name="图像色相旋转" Minimum="-180" Maximum="180" Value="0" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" />
                            <TextBox x:Name="HueRotationValue" Grid.Column="2" Tag="hueRotation" Text="0°" Style="{StaticResource AdjustmentValue}" GotKeyboardFocus="ValueEditor_GotKeyboardFocus" LostKeyboardFocus="ValueEditor_LostKeyboardFocus" PreviewKeyDown="ValueEditor_PreviewKeyDown" />
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock Text="柔化" Style="{StaticResource AdjustmentLabel}" />
                            <Slider x:Name="BlurSlider" Grid.Column="1" Style="{DynamicResource SettingsSlider}" Tag="blur" AutomationProperties.Name="图像模糊" Minimum="0" Maximum="20" Value="0" TickFrequency="0.5" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" />
                            <TextBox x:Name="BlurValue" Grid.Column="2" Tag="blur" Text="0 px" Style="{StaticResource AdjustmentValue}" GotKeyboardFocus="ValueEditor_GotKeyboardFocus" LostKeyboardFocus="ValueEditor_LostKeyboardFocus" PreviewKeyDown="ValueEditor_PreviewKeyDown" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock Text="叠色" Style="{StaticResource AdjustmentLabel}" />
                            <Slider x:Name="OverlayOpacitySlider" Grid.Column="1" Style="{DynamicResource SettingsSlider}" Tag="overlayOpacity" AutomationProperties.Name="背景叠色强度" Minimum="0" Maximum="100" Value="0" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" />
                            <TextBox x:Name="OverlayOpacityValue" Grid.Column="2" Tag="overlayOpacity" Text="0%" Style="{StaticResource AdjustmentValue}" GotKeyboardFocus="ValueEditor_GotKeyboardFocus" LostKeyboardFocus="ValueEditor_LostKeyboardFocus" PreviewKeyDown="ValueEditor_PreviewKeyDown" />
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock Text="渐变" Style="{StaticResource AdjustmentLabel}" />
                            <Slider x:Name="GradientStrengthSlider" Grid.Column="1" Style="{DynamicResource SettingsSlider}" Tag="gradientStrength" AutomationProperties.Name="渐变遮罩强度" Minimum="0" Maximum="100" Value="0" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" />
                            <TextBox x:Name="GradientStrengthValue" Grid.Column="2" Tag="gradientStrength" Text="0%" Style="{StaticResource AdjustmentValue}" GotKeyboardFocus="ValueEditor_GotKeyboardFocus" LostKeyboardFocus="ValueEditor_LostKeyboardFocus" PreviewKeyDown="ValueEditor_PreviewKeyDown" />
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock Text="暗角" Style="{StaticResource AdjustmentLabel}" />
                            <Slider x:Name="VignetteSlider" Grid.Column="1" Style="{DynamicResource SettingsSlider}" Tag="vignette" AutomationProperties.Name="暗角强度" Minimum="0" Maximum="100" Value="0" ValueChanged="Slider_ValueChanged" AutoToolTipPlacement="TopLeft" />
                            <TextBox x:Name="VignetteValue" Grid.Column="2" Tag="vignette" Text="0%" Style="{StaticResource AdjustmentValue}" GotKeyboardFocus="ValueEditor_GotKeyboardFocus" LostKeyboardFocus="ValueEditor_LostKeyboardFocus" PreviewKeyDown="ValueEditor_PreviewKeyDown" />
                        </Grid>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="124" /><ColumnDefinition Width="14" /><ColumnDefinition Width="42" /><ColumnDefinition Width="126" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="混合" Style="{StaticResource AdjustmentLabel}" />
                    <ComboBox x:Name="BlendModeComboBox" Grid.Column="1" Height="30" Style="{DynamicResource SettingsComboBox}" SelectedValuePath="Tag" SelectionChanged="BlendMode_SelectionChanged" AutomationProperties.Name="图像混合模式">
                        <ComboBoxItem Content="正常" Tag="normal" />
                        <ComboBoxItem Content="正片叠底" Tag="multiply" />
                        <ComboBoxItem Content="滤色" Tag="screen" />
                        <ComboBoxItem Content="叠加" Tag="overlay" />
                        <ComboBoxItem Content="柔光" Tag="soft-light" />
                        <ComboBoxItem Content="明度" Tag="luminosity" />
                    </ComboBox>
                    <TextBlock Grid.Column="3" Text="色值" Style="{StaticResource AdjustmentLabel}" />
                    <TextBox x:Name="OverlayColorTextBox" Grid.Column="4" Height="30" Text="#000000" Style="{StaticResource AdjustmentValue}" Margin="0" LostKeyboardFocus="OverlayColor_LostKeyboardFocus" PreviewKeyDown="OverlayColor_PreviewKeyDown" AutomationProperties.Name="叠色十六进制颜色" />
                    <CheckBox x:Name="ReadabilityCheckBox" Grid.Column="6" Style="{DynamicResource SettingsToggle}" Checked="Readability_Changed" Unchecked="Readability_Changed" AutomationProperties.Name="启用文字可读性保护" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="文字可读性保护" Foreground="{DynamicResource PrimaryText}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="叠色、渐变与暗角只作用于图片层；可读性保护会为文字增加局部阅读底层。" Foreground="{DynamicResource MutedText}" FontSize="9.5" TextWrapping="Wrap" LineHeight="16" Margin="0,5,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
