<UserControl x:Class="Tessalume.App.Controls.ThemeDetailPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        Focusable="True">
    <Grid Background="#96070A10">
        <Border Width="900" Height="610" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource HomeToolbarBorder}"
                BorderThickness="1" CornerRadius="22" Padding="24" Effect="{DynamicResource SelectedCardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="66" />
                    <RowDefinition Height="246" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="58" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="主题详情" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="8,3" Margin="9,0,0,0">
                                <TextBlock x:Name="ThemeTypeText" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <Border x:Name="AppliedBadge" Background="{DynamicResource TealSoft}" CornerRadius="7" Padding="8,3" Margin="7,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="当前已应用" Foreground="{DynamicResource Teal}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock x:Name="ThemeNameText" Foreground="{DynamicResource PrimaryText}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="650" />
                            <TextBlock x:Name="ThemeVersionText" Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Bottom" Margin="10,0,0,3" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Width="34" Height="34" Style="{DynamicResource QuietActionButton}" Content="×"
                            Padding="0" FontSize="16" ToolTip="关闭主题详情" AutomationProperties.Name="关闭主题详情"
                            Click="CloseButton_Click" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="17" ClipToBounds="True">
                        <Grid>
                            <Grid x:Name="LightFallback">
                                <Ellipse Width="270" Height="270" Fill="{DynamicResource Accent}" Opacity="0.12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-125,-45,0" />
                                <Border Width="270" Height="120" CornerRadius="14" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <Grid Margin="16"><Border Width="64" CornerRadius="10" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left" /><StackPanel Margin="82,12,0,0"><Rectangle Height="7" RadiusX="3" Fill="{DynamicResource Accent}" Opacity="0.55" /><Rectangle Height="6" RadiusX="3" Fill="{DynamicResource Accent}" Opacity="0.17" Margin="0,13,20,0" /><Rectangle Height="31" RadiusX="8" Fill="{DynamicResource SurfaceAlt}" Margin="0,14,0,0" /></StackPanel></Grid>
                                </Border>
                                <TextBlock x:Name="LightFallbackText" Text="未提供亮色预览" Foreground="{DynamicResource MutedText}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,23" />
                            </Grid>
                            <Rectangle x:Name="LightPreviewImage" />
                            <Border VerticalAlignment="Bottom" Height="64">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" /><GradientStop Color="#B9080B12" Offset="1" /></LinearGradientBrush></Border.Background>
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#C90A0D14" CornerRadius="8" Padding="10,5" Margin="13">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#FFD978" Margin="0,0,7,0" /><TextBlock Text="亮色预览" Foreground="White" FontSize="10" FontWeight="SemiBold" /></StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="#151B24" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="17" ClipToBounds="True">
                        <Grid>
                            <Grid x:Name="DarkFallback">
                                <Ellipse Width="270" Height="270" Fill="#967EFF" Opacity="0.18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-125,-45,0" />
                                <Border Width="270" Height="120" CornerRadius="14" Background="#202733" BorderBrush="#3B4658" BorderThickness="1">
                                    <Grid Margin="16"><Border Width="64" CornerRadius="10" Background="#332F58" HorizontalAlignment="Left" /><StackPanel Margin="82,12,0,0"><Rectangle Height="7" RadiusX="3" Fill="#978BFF" Opacity="0.7" /><Rectangle Height="6" RadiusX="3" Fill="#978BFF" Opacity="0.24" Margin="0,13,20,0" /><Rectangle Height="31" RadiusX="8" Fill="#2A323F" Margin="0,14,0,0" /></StackPanel></Grid>
                                </Border>
                                <TextBlock x:Name="DarkFallbackText" Text="未提供暗色预览" Foreground="#ADB6C6" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,23" />
                            </Grid>
                            <Rectangle x:Name="DarkPreviewImage" />
                            <Border VerticalAlignment="Bottom" Height="64">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" /><GradientStop Color="#C9080B12" Offset="1" /></LinearGradientBrush></Border.Background>
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#C90A0D14" CornerRadius="8" Padding="10,5" Margin="13">
                                <StackPanel Orientation="Horizontal"><Path Width="8" Height="8" Data="M 7,1 C 4,1.5 3,4 4,6 C 5,8 7,8.5 9,7 C 8,9 5.5,10 3.5,8.5 C 1.5,7 1,4.5 2,2.8 C 3,1.2 5,0.5 7,1 Z" Fill="#A68CFF" Margin="0,0,7,0" /><TextBlock Text="暗色预览" Foreground="White" FontSize="10" FontWeight="SemiBold" /></StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="主题说明" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock x:Name="ThemeDescriptionText" Foreground="{DynamicResource PrimaryText}" FontSize="12" TextWrapping="Wrap" LineHeight="20" MaxHeight="62" Margin="0,7,0,0" />
                        <WrapPanel Margin="0,14,0,0">
                            <Border Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="8" Padding="9,5" Margin="0,0,7,0"><TextBlock x:Name="CapabilityText" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" /></Border>
                            <Border Background="{DynamicResource HomeToolbarSurface}" BorderBrush="{DynamicResource HomeToolbarBorder}" BorderThickness="1" CornerRadius="8" Padding="9,5"><TextBlock x:Name="TemplateText" Foreground="{DynamicResource MutedText}" FontSize="10" FontWeight="SemiBold" /></Border>
                        </WrapPanel>
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="主题作者" Foreground="{DynamicResource SubtleText}" FontSize="10" /><TextBlock x:Name="AuthorText" Grid.Column="1" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></Grid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="包 ID" Foreground="{DynamicResource SubtleText}" FontSize="10" /><TextBlock x:Name="ThemeIdText" Grid.Column="1" Foreground="{DynamicResource PrimaryText}" FontFamily="Cascadia Mono" FontSize="10" TextTrimming="CharacterEllipsis" /></Grid>
                        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="本地文件" Foreground="{DynamicResource SubtleText}" FontSize="10" /><StackPanel Grid.Column="1"><TextBlock x:Name="StorageText" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="DirectoryText" Foreground="{DynamicResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel></Grid>
                    </Grid>
                </Grid>

                <Grid Grid.Row="4" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{DynamicResource SecondaryActionButton}" Content="打开主题目录" Click="OpenFolderButton_Click" MinWidth="116" Height="40" />
                        <Button x:Name="CompanionPetButton" Style="{DynamicResource SecondaryActionButton}" Content="查看配套宠物"
                                Click="CompanionPetButton_Click" MinWidth="124" Height="40" Margin="8,0,0,0"
                                Visibility="Collapsed" AutomationProperties.Name="查看主题的配套宠物" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{DynamicResource QuietActionButton}" Content="关闭" Click="CloseButton_Click" MinWidth="84" Height="40" />
                    <Button x:Name="ApplyButton" Grid.Column="4" Style="{DynamicResource PrimaryActionButton}" Content="应用到 Codex" Click="ApplyButton_Click" MinWidth="142" Height="42" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
