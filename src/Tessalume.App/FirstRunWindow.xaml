<Window x:Class="Tessalume.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tessalume.App"
        Width="760" Height="440" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="WelcomeSurface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WelcomeSurfaceAlt" Color="#F6F7FB" />
        <SolidColorBrush x:Key="WelcomeBorder" Color="#DDE2EC" />
        <SolidColorBrush x:Key="WelcomeText" Color="#171927" />
        <SolidColorBrush x:Key="WelcomeMuted" Color="#62697A" />
        <SolidColorBrush x:Key="WelcomeSubtle" Color="#9299AA" />
        <SolidColorBrush x:Key="WelcomeAccent" Color="#675CF0" />
        <SolidColorBrush x:Key="WelcomeAccentSoft" Color="#EFEDFF" />
        <SolidColorBrush x:Key="WelcomePositive" Color="#24B987" />
        <SolidColorBrush x:Key="WelcomePositiveSoft" Color="#EAF9F4" />
        <SolidColorBrush x:Key="WelcomeAmber" Color="#D88A24" />
        <SolidColorBrush x:Key="WelcomeAmberSoft" Color="#FFF5E7" />

        <Style x:Key="WelcomeButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{DynamicResource WelcomeSurfaceAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource WelcomeText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WelcomeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WelcomeAccent}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="{DynamicResource WelcomeSurface}" BorderBrush="{DynamicResource WelcomeBorder}"
            BorderThickness="1" CornerRadius="24" Padding="26,22,26,24">
        <Border.Effect><DropShadowEffect Color="#080B14" BlurRadius="38" ShadowDepth="12" Opacity="0.28" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                <Border Width="54" Height="54" CornerRadius="17" Background="{DynamicResource WelcomeAccentSoft}">
                    <Image Width="44" Height="44" Source="{x:Static local:BrandInfo.AppLogo}" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="欢迎使用 Tessalume" Foreground="{DynamicResource WelcomeText}" FontSize="23" FontWeight="Bold" />
                        <Border Background="{DynamicResource WelcomeAccentSoft}" CornerRadius="8" Padding="8,3" Margin="10,2,0,0" VerticalAlignment="Top">
                            <TextBlock Text="v1.2" Foreground="{DynamicResource WelcomeAccent}" FontSize="9" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="先了解三个关键动作，再开始选择你的第一套主题。" Foreground="{DynamicResource WelcomeMuted}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Width="30" Height="30" Content="×" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource WelcomeMuted}" FontSize="17" Cursor="Hand" ToolTip="退出" Click="Exit_Click" />
            </Grid>

            <UniformGrid Grid.Row="2" Columns="3">
                <Border Background="{DynamicResource WelcomeSurfaceAlt}" BorderBrush="{DynamicResource WelcomeBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,6,0">
                    <StackPanel><TextBlock Text="01" Foreground="{DynamicResource WelcomeAccent}" FontSize="10" FontWeight="Bold" /><TextBlock Text="选择喜欢的主题" Foreground="{DynamicResource WelcomeText}" FontSize="13" FontWeight="SemiBold" Margin="0,9,0,0" /><TextBlock Text="首次启动不会自动换肤，先浏览预览，再由你决定应用哪一套。" TextWrapping="Wrap" Foreground="{DynamicResource WelcomeMuted}" FontSize="9.5" LineHeight="16" Margin="0,6,0,0" /></StackPanel>
                </Border>
                <Border Background="{DynamicResource WelcomeSurfaceAlt}" BorderBrush="{DynamicResource WelcomeBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="6,0">
                    <StackPanel><TextBlock Text="02" Foreground="{DynamicResource WelcomeAmber}" FontSize="10" FontWeight="Bold" /><TextBlock Text="必要时重新连接" Foreground="{DynamicResource WelcomeText}" FontSize="13" FontWeight="SemiBold" Margin="0,9,0,0" /><TextBlock Text="若 Codex 需要重启，软件会先提醒你保存工作，确认后才会继续。" TextWrapping="Wrap" Foreground="{DynamicResource WelcomeMuted}" FontSize="9.5" LineHeight="16" Margin="0,6,0,0" /></StackPanel>
                </Border>
                <Border Background="{DynamicResource WelcomeSurfaceAlt}" BorderBrush="{DynamicResource WelcomeBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="6,0,0,0">
                    <StackPanel><TextBlock Text="03" Foreground="{DynamicResource WelcomePositive}" FontSize="10" FontWeight="Bold" /><TextBlock Text="随时恢复默认" Foreground="{DynamicResource WelcomeText}" FontSize="13" FontWeight="SemiBold" Margin="0,9,0,0" /><TextBlock Text="主题只作用于当前本机会话，可随时恢复 Codex 默认外观。" TextWrapping="Wrap" Foreground="{DynamicResource WelcomeMuted}" FontSize="9.5" LineHeight="16" Margin="0,6,0,0" /></StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="4" Background="{DynamicResource WelcomeAccentSoft}" BorderBrush="{DynamicResource WelcomeBorder}" BorderThickness="1" CornerRadius="16" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="30" Height="30"><Ellipse Fill="{DynamicResource WelcomeSurface}" /><Ellipse x:Name="CodexStatusDot" Width="9" Height="9" Fill="{DynamicResource WelcomePositive}" /></Grid>
                    <StackPanel Grid.Column="1" Margin="8,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CodexStatusText" Text="正在检查 Codex Desktop" Foreground="{DynamicResource WelcomeText}" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="CodexStatusHintText" Text="只检查本机安装状态，不会连接网络。" Foreground="{DynamicResource WelcomeMuted}" FontSize="9" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource WelcomeSurface}" CornerRadius="9" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="便携数据已准备" Foreground="{DynamicResource WelcomeAccent}" FontSize="9" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="以后启动时将直接显示顶部主题浮窗。" Foreground="{DynamicResource WelcomeSubtle}" FontSize="9.5" />
                    <TextBlock Text="你可以随时从浮窗打开完整主题库。" Foreground="{DynamicResource WelcomeSubtle}" FontSize="9.5" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WelcomeButton}" Content="退出" Click="Exit_Click" AutomationProperties.Name="退出 Tessalume" />
                    <Button x:Name="ContinueButton" Style="{StaticResource WelcomeButton}" Content="进入主题库" IsDefault="True" Margin="10,0,0,0"
                            Background="{DynamicResource WelcomeAccent}" Foreground="White" BorderBrush="Transparent" Click="Continue_Click" AutomationProperties.Name="进入主题库" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
