<Window x:Class="CodexThemeStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexThemeStudio.App"
        Title="{x:Static local:BrandInfo.WindowTitle}"
        Icon="{x:Static local:BrandInfo.AppIcon}"
        Width="1200" Height="780" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6D4EEA" Offset="0" />
            <GradientStop Color="#D84B9B" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AdvancedPreview" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#39215A" Offset="0" />
            <GradientStop Color="#8B3DCE" Offset="0.54" />
            <GradientStop Color="#EF70B2" Offset="1" />
        </LinearGradientBrush>
        <DropShadowEffect x:Key="CardShadow" Color="#1B1530" BlurRadius="22" ShadowDepth="5" Opacity="0.11" />
        <DropShadowEffect x:Key="SelectedCardShadow" Color="#7652D7" BlurRadius="26" ShadowDepth="5" Opacity="0.24" />

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverSurface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverSurface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FeatureButton" TargetType="Button">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="7,4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="23" Height="23" CornerRadius="8" Background="{DynamicResource PrimaryGradient}">
                                    <TextBlock Text="{TemplateBinding Tag}" Foreground="White" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverSurface}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Width="43" Height="43" Source="{x:Static local:BrandInfo.AppLogo}" Stretch="Uniform" />
                    <StackPanel Margin="11,1,0,0">
                        <TextBlock Text="{x:Static local:BrandInfo.ProductName}" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="17" />
                        <TextBlock Text="{x:Static local:BrandInfo.ChineseName}" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="主题空间" Foreground="{DynamicResource SubtleText}" FontSize="10" Margin="12,0,0,7" />
                    <Button x:Name="ThemesButton" Style="{StaticResource NavButton}" Click="ShowThemes_Click" Content="✦   主题画廊" />
                    <Button x:Name="FavoritesButton" Style="{StaticResource NavButton}" Click="ShowFavorites_Click" Content="♡   我的收藏" />
                    <Border Height="1" Background="{DynamicResource Border}" Margin="10,15,10,13" />
                    <Button Style="{StaticResource NavButton}" Click="RefreshThemes_Click" Content="↻   刷新本地库" />
                    <Button x:Name="DiagnosticsButton" Style="{StaticResource NavButton}" Click="Diagnostics_Click" Content="◎   运行与诊断" />
                    <Button Style="{StaticResource NavButton}" Click="RestoreTheme_Click" Content="↶   恢复 Codex 默认" />
                    <Border Height="1" Background="{DynamicResource Border}" Margin="10,15,10,13" />
                    <TextBlock Text="帮助与自定义" Foreground="{DynamicResource SubtleText}" FontSize="10" Margin="12,0,0,7" />
                    <Button x:Name="ImportGuideButton" Style="{StaticResource NavButton}" Click="ImportGuide_Click" Content="↓   导入说明" />
                    <Button x:Name="UsageGuideButton" Style="{StaticResource NavButton}" Click="UsageGuide_Click" Content="?   使用说明" />
                </StackPanel>

                <Border Grid.Row="4" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="13">
                    <StackPanel>
                        <TextBlock Text="本地主题引擎" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="不修改 Codex 安装文件，所有主题都可随时移除。" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="ThemeLibraryPage" Grid.Column="1" Margin="32,25,32,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="CategoryTitleText" Text="主题画廊" Foreground="{DynamicResource PrimaryText}" FontSize="28" FontWeight="Bold" />
                    <TextBlock x:Name="CategoryDescriptionText" Text="沉浸式角色主题、动态组件与完整交互，都集中在这里。" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="1,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Height="36" VerticalAlignment="Center" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="12,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#43C993" Margin="0,0,7,0" />
                        <TextBlock x:Name="EngineStateText" Text="引擎待启动" Foreground="{DynamicResource PrimaryText}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="QuickSwitchButton" Grid.Column="3" Style="{StaticResource FeatureButton}" Tag="◇" Click="QuickSwitchButton_Click" Content="主题浮窗" />
                <Button x:Name="StartupButton" Grid.Column="5" Style="{StaticResource FeatureButton}" Tag="↟" Click="StartupButton_Click" Content="开机启动" />
                <Border Grid.Column="7" Height="38" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LightModeButton" Width="48" Style="{StaticResource RoundButton}" BorderThickness="0" Padding="5,5" Tag="light" Click="StudioMode_Click" Content="☀ 亮" FontSize="11" />
                        <Button x:Name="DarkModeButton" Width="48" Style="{StaticResource RoundButton}" BorderThickness="0" Padding="5,5" Tag="dark" Click="StudioMode_Click" Content="☾ 暗" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Height="64" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="14" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource PrimaryGradient}" VerticalAlignment="Center">
                        <TextBlock x:Name="DeclarationIconText" Text="FX" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="ImportDeclarationTitleText" Text="导入主题" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="ImportDeclarationBodyText" Text="选择包含 manifest.json 与 theme.js 的完整主题文件夹；启用前会检查本地源码。" Foreground="{DynamicResource MutedText}" FontSize="10.5" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="ImportButton" Grid.Column="3" Height="38" Click="ImportTheme_Click" Style="{StaticResource RoundButton}" FontWeight="SemiBold" Content="＋ 选择文件夹" />
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ThemeItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="7,2,7,14">
                                <Button Tag="{Binding}" Click="ThemeCard_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
                                    <Border x:Name="CardShell" Height="238" CornerRadius="18" Background="{DynamicResource Border}" Effect="{StaticResource CardShadow}" CacheMode="BitmapCache">
                                        <Border x:Name="CardClip" Margin="1" CornerRadius="17" Background="{DynamicResource Surface}" ClipToBounds="True">
                                            <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="132" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid x:Name="PreviewArea" Background="{DynamicResource AdvancedPreview}">
                                                <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="UniformToFill" />
                                                <Border x:Name="PreviewShade">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#05000000" Offset="0" />
                                                            <GradientStop Color="#24000000" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Grid x:Name="FallbackPreview" Background="{Binding FallbackBackground}">
                                                    <Ellipse Width="118" Height="118" Fill="{Binding FallbackAccent}" Opacity="0.08" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-48,-26,0" />
                                                    <Ellipse Width="76" Height="76" Fill="{Binding FallbackAccent}" Opacity="0.06" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-20,0,0,-34" />
                                                    <Border Width="304" Height="104" CornerRadius="14" Background="{Binding FallbackPanel}" BorderBrush="#70FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#3D3342" BlurRadius="16" ShadowDepth="3" Opacity="0.12" />
                                                        </Border.Effect>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="74" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid>
                                                                <Border Background="{Binding FallbackAccent}" Opacity="0.11" CornerRadius="13,0,0,13" />
                                                                <StackPanel Margin="13,14,10,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Ellipse Width="14" Height="14" Fill="{Binding FallbackAccent}" />
                                                                        <Rectangle Width="31" Height="6" RadiusX="3" RadiusY="3" Fill="{Binding FallbackAccent}" Opacity="0.72" Margin="7,4,0,0" />
                                                                    </StackPanel>
                                                                    <Rectangle Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{Binding FallbackAccent}" Opacity="0.28" Margin="0,15,8,0" />
                                                                    <Rectangle Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{Binding FallbackAccent}" Opacity="0.20" Margin="0,8,18,0" />
                                                                    <Rectangle Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{Binding FallbackAccent}" Opacity="0.20" Margin="0,8,12,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <Grid Grid.Column="1" Margin="16,13,14,12">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="26" />
                                                                </Grid.RowDefinitions>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Rectangle Width="76" Height="7" RadiusX="3.5" RadiusY="3.5" Fill="{Binding FallbackAccent}" Opacity="0.72" />
                                                                    <Ellipse Width="7" Height="7" Fill="{Binding FallbackAccent}" Opacity="0.35" Margin="9,0,0,0" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                                                    <Rectangle Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{Binding FallbackAccent}" Opacity="0.22" Margin="0,0,34,0" />
                                                                    <Rectangle Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{Binding FallbackAccent}" Opacity="0.15" Margin="0,7,64,0" />
                                                                </StackPanel>
                                                                <Border Grid.Row="2" CornerRadius="8" Background="White" Opacity="0.72" BorderBrush="{Binding FallbackAccent}" BorderThickness="1">
                                                                    <Grid>
                                                                        <Rectangle Width="76" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{Binding FallbackAccent}" Opacity="0.18" HorizontalAlignment="Left" Margin="10,0,0,0" />
                                                                        <Ellipse Width="14" Height="14" Fill="{Binding FallbackAccent}" HorizontalAlignment="Right" Margin="0,0,7,0" />
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13" Background="#D9231730" CornerRadius="9" Padding="9,5">
                                                    <TextBlock Text="{Binding TypeLabel}" Foreground="White" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="13,13,54,0" Background="#EFFFFFFF" CornerRadius="9" Padding="8,5">
                                                    <TextBlock Text="{Binding Version, StringFormat=v{0}}" Foreground="#48245E" FontSize="9" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="16,12,14,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding Author}" Foreground="{DynamicResource Accent}" FontSize="9" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <Border x:Name="SelectedMark" Grid.Column="1" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryGradient}" Visibility="Collapsed" VerticalAlignment="Center">
                                                    <TextBlock Text="✓" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Button>
                                <Button x:Name="FavoriteButton" Tag="{Binding}" Click="FavoriteTheme_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Width="32" Height="32" Background="{DynamicResource Surface}" Foreground="{DynamicResource MutedText}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="0" Panel.ZIndex="1" ToolTip="收藏主题" Content="♡">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="FavoriteChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="FavoriteChrome" Property="Background" Value="{DynamicResource HoverSurface}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                        <Setter TargetName="PreviewImage" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="PreviewShade" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                        <Setter TargetName="FallbackPreview" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="CardShell" Property="Effect" Value="{StaticResource SelectedCardShadow}" />
                                        <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter TargetName="CardShell" Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter TargetName="FavoriteButton" Property="Background" Value="{DynamicResource InfoSurface}" />
                                        <Setter TargetName="FavoriteButton" Property="Content" Value="♥" />
                                        <Setter TargetName="FavoriteButton" Property="Foreground" Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="◇" Foreground="{DynamicResource SubtleText}" FontSize="38" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateTitleText" Text="这里还没有主题" Foreground="{DynamicResource PrimaryText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock x:Name="EmptyStateBodyText" Text="使用上方按钮导入一个本地主题文件夹。" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="6" Height="68" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="17,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedThemeText" Text="正在读取主题库…" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock x:Name="StatusText" Text="请稍候" Foreground="{DynamicResource MutedText}" FontSize="10.5" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="DeleteButton" Grid.Column="1" Style="{StaticResource RoundButton}" Width="90" Height="40" Foreground="{DynamicResource MutedText}" Content="删除主题" IsEnabled="False" Click="DeleteTheme_Click" />
                    <Button x:Name="RestoreButton" Grid.Column="3" Style="{StaticResource RoundButton}" Width="96" Height="40" FontWeight="SemiBold" Content="恢复默认" Click="RestoreTheme_Click" />
                    <Button x:Name="CodexModeButton" Grid.Column="5" Style="{StaticResource RoundButton}" Width="108" Height="40" FontWeight="SemiBold" Content="◐ 切换明暗" Click="CodexMode_Click" />
                    <Button x:Name="ActivateButton" Grid.Column="7" Width="158" Height="40" Background="{DynamicResource PrimaryGradient}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Content="启动 Codex 并应用" Click="ActivateButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="13" Padding="17,12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="InfoPage" Grid.Column="1" Margin="32,25,32,22" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel x:Name="ImportInfoPanel">
                        <TextBlock Text="导入说明" Foreground="{DynamicResource PrimaryText}" FontSize="27" FontWeight="Bold" />
                        <TextBlock Text="软件只接收完整的沉浸式主题包，让角色视觉、动效与交互保持一致。" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="1,6,0,20" />
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="22">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="沉浸式主题 · CSS + JS" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="角色视觉、组件、动画与交互一次完整交付" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="17" Margin="0,12,0,0" />
                                    <TextBlock Text="主题可使用 CSS、图片与 theme.js 构建完整体验。首次启用或源码变化时，软件都会再次请求信任确认。" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="11" LineHeight="19" Margin="0,8,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="14">
                                    <TextBlock Text="manifest.json&#10;theme.css（可选）&#10;theme.js&#10;assets/（可选）" FontFamily="Consolas" Foreground="{DynamicResource PrimaryText}" FontSize="11" LineHeight="19" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,18,0,0">
                            <StackPanel><TextBlock Text="导入步骤" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="1. 复制模板并完成设计  →  2. 返回主题画廊  →  3. 点击导入并选择主题文件夹  →  4. 选中卡片后应用" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="11" LineHeight="19" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="UsageInfoPanel" Visibility="Collapsed">
                        <TextBlock Text="使用说明" Foreground="{DynamicResource PrimaryText}" FontSize="27" FontWeight="Bold" />
                        <TextBlock Text="从模板开始设计，复制后即可修改并导入本地主题库。" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="1,6,0,20" />
                        <Border Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="14" Padding="18"><TextBlock Text="推荐顺序：先修改 manifest.json 中唯一的 id、名称和作者；再建立亮暗色 CSS 与资源；最后完善 theme.js 的组件、动画和自动清理。" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" FontSize="11" LineHeight="19" /></Border>
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="沉浸式主题模板" Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="从视觉到交互的完整起点" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,5,0,0" />
                                    <TextBlock Text="示范 registerTheme、mount/unmount 生命周期、配置读取与自动清理。请只加入自己信任的代码。" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="11" LineHeight="18" Margin="0,12,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Style="{StaticResource RoundButton}" Tag="advanced-theme" Click="OpenTemplate_Click" Content="打开模板文件夹" />
                                    <Button Style="{StaticResource RoundButton}" Tag="advanced-theme" Click="CopyTemplate_Click" Content="复制一份开始设计" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SettingsInfoPanel" Visibility="Collapsed">
                        <TextBlock Text="设置" Foreground="{DynamicResource PrimaryText}" FontSize="27" FontWeight="Bold" />
                        <TextBlock Text="{x:Static local:BrandInfo.RuntimeSettingsDescription}" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="1,6,0,20" />
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开机自动启动" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="{x:Static local:BrandInfo.StartupDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="11" LineHeight="18" Margin="0,7,18,0" /></StackPanel><CheckBox x:Name="StartupCheckBox" Grid.Column="1" VerticalAlignment="Center" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" Content="启用" Foreground="{DynamicResource PrimaryText}" FontSize="12" /></Grid></Border>
                        <Border Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,18,0,0"><TextBlock Text="{x:Static local:BrandInfo.PortableDataDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="11" LineHeight="19" /></Border>
                    </StackPanel>

                    <StackPanel x:Name="DiagnosticsInfoPanel" Visibility="Collapsed">
                        <TextBlock Text="运行与诊断" Foreground="{DynamicResource PrimaryText}" FontSize="27" FontWeight="Bold" />
                        <TextBlock Text="仅检查本机主题库、Codex 进程与本机回环端口，不访问互联网。" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="1,6,0,20" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="CODEX" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="DiagnosticCodexText" Text="正在检查…" Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border>
                            <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="本机端口" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="DiagnosticPortText" Text="正在检查…" Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border>
                            <Border Grid.Column="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="主题包" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="DiagnosticThemesText" Text="正在检查…" Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border>
                        </Grid>
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,18,0,0"><StackPanel><TextBlock Text="诊断详情" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold" /><TextBox x:Name="DiagnosticDetailsText" Margin="0,10,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MutedText}" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" AcceptsReturn="True" /></StackPanel></Border>
                        <Button Style="{StaticResource RoundButton}" Click="Diagnostics_Click" Content="↻ 刷新诊断" HorizontalAlignment="Left" Margin="0,18,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
