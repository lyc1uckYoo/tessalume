<Window x:Class="CodexThemeStudio.App.ThemeQuickSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexThemeStudio.App"
        Title="{x:Static local:BrandInfo.QuickSwitchTitle}" Width="648" Height="74" MinWidth="648" MinHeight="74"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <LinearGradientBrush x:Key="BarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#171A20" Offset="0" />
            <GradientStop Color="#20252D" Offset="0.52" />
            <GradientStop Color="#171B21" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CurrentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6577F0" Offset="0" />
            <GradientStop Color="#4BA8D5" Offset="1" />
        </LinearGradientBrush>
        <DropShadowEffect x:Key="BarShadow" Color="#120B18" BlurRadius="28" ShadowDepth="8" Opacity="0.44" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="#F8EFF8" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" /><Setter TargetName="Chrome" Property="BorderBrush" Value="#35FFFFFF" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#427E67D0" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="#13FFFFFF" /><Setter Property="BorderBrush" Value="#22FFFFFF" />
        </Style>
        <Style x:Key="AccentIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="#30566FE8" /><Setter Property="BorderBrush" Value="#4A7890F0" />
        </Style>
    </Window.Resources>

    <Border Margin="5" Background="{StaticResource BarGradient}" BorderBrush="#5B4C5562" BorderThickness="1"
            CornerRadius="20" Effect="{StaticResource BarShadow}" SnapsToDevicePixels="True">
        <Grid MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown">
            <Border Height="1" Margin="20,0" VerticalAlignment="Top" Background="#38FFFFFF" CornerRadius="1" />
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" /><ColumnDefinition Width="5" /><ColumnDefinition Width="40" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="34" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" /><ColumnDefinition Width="34" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="34" /><ColumnDefinition Width="4" /><ColumnDefinition Width="34" />
                    <ColumnDefinition Width="4" /><ColumnDefinition Width="34" /><ColumnDefinition Width="4" /><ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center" ToolTipService.InitialShowDelay="180">
                    <Grid.ToolTip>
                        <ToolTip x:Name="FiveHourUsageToolTip" Placement="Bottom" Background="#F4291F33" Foreground="#FFF7F2FA"
                                 BorderBrush="#685273" BorderThickness="1" Padding="11,8" FontFamily="Microsoft YaHei UI"
                                 Content="正在读取 Codex 5 小时额度…" />
                    </Grid.ToolTip>
                    <Ellipse Width="34" Height="34" Stroke="#30FFFFFF" StrokeThickness="3" />
                    <Path x:Name="FiveHourUsageArcPath" Stroke="#75E7C0" StrokeThickness="3" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Fill="Transparent" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="FiveHourUsagePercentText" Text="--" Foreground="White" FontWeight="Bold" FontSize="9.5"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="5H" Foreground="#A6DFD4E5" FontSize="6.2" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="2" Width="38" Height="38" VerticalAlignment="Center" ToolTipService.InitialShowDelay="180">
                    <Grid.ToolTip>
                        <ToolTip x:Name="LongUsageToolTip" Placement="Bottom" Background="#F4291F33" Foreground="#FFF7F2FA"
                                 BorderBrush="#685273" BorderThickness="1" Padding="11,8" FontFamily="Microsoft YaHei UI"
                                 Content="正在读取 Codex 长周期额度…" />
                    </Grid.ToolTip>
                    <Ellipse Width="34" Height="34" Stroke="#30FFFFFF" StrokeThickness="3" />
                    <Path x:Name="LongUsageArcPath" Stroke="#B6A0FF" StrokeThickness="3" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Fill="Transparent" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LongUsagePercentText" Text="--" Foreground="White" FontWeight="Bold" FontSize="9.5"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="LongUsageLabelText" Text="7D" Foreground="#A6DFD4E5" FontSize="6.2" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                    </StackPanel>
                </Grid>
                <Border Grid.Column="4" Width="1" Height="29" Background="#30FFFFFF" VerticalAlignment="Center" />

                <Button Grid.Column="6" Style="{StaticResource PlayerButton}" Click="Previous_Click" ToolTip="上一个收藏主题">
                    <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24">
                        <Rectangle Canvas.Left="4" Canvas.Top="6" Width="2.4" Height="12" RadiusX="1.2" Fill="#FFF7FA" />
                        <Path Data="M 19,6 L 9,12 L 19,18 Z" Fill="#FFF7FA" />
                    </Canvas></Viewbox>
                </Button>
                <Button Grid.Column="10" Style="{StaticResource PlayerButton}" Click="Next_Click" ToolTip="下一个收藏主题">
                    <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24">
                        <Path Data="M 5,6 L 15,12 L 5,18 Z" Fill="#FFF7FA" />
                        <Rectangle Canvas.Left="17.6" Canvas.Top="6" Width="2.4" Height="12" RadiusX="1.2" Fill="#FFF7FA" />
                    </Canvas></Viewbox>
                </Button>

                <Border Grid.Column="8" Height="40" Background="#17FFFFFF" BorderBrush="#2DFFFFFF" BorderThickness="1"
                        CornerRadius="13" Padding="11,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="19" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="14" Height="14" CornerRadius="7" Background="{StaticResource CurrentGradient}" VerticalAlignment="Center">
                            <TextBlock Text="✦" Foreground="White" FontSize="7.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="当前主题" Foreground="#A9F5E9F7" FontWeight="SemiBold" FontSize="7.5" />
                            <TextBlock x:Name="CurrentThemeText" Text="Codex 默认外观" Foreground="White" FontWeight="SemiBold"
                                       FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="174" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button x:Name="RestoreThemeButton" Grid.Column="12" Style="{StaticResource AccentIconButton}" Click="Restore_Click" ToolTip="恢复 Codex 默认外观">
                    <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                        <Path x:Name="RestoreIconPath" Data="M 7,8 L 3.5,8 L 3.5,4.5 M 4,8 C 6,4 10,2.5 14,3.5 C 18.5,4.5 21,9 20,13.5 C 19,18 14.5,21 10,20 C 7,19.4 4.8,17.5 3.7,15"
                              Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Canvas></Viewbox>
                </Button>
                <Button Grid.Column="14" Style="{StaticResource IconButton}" Click="ToggleColor_Click" ToolTip="切换 Codex 亮暗色">
                    <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                        <Path Data="M 15,3 C 9,4 7,9 8.5,13.5 C 10,18 14.5,19.5 19,17 C 17,20.5 12.5,22 8.5,20 C 4,17.8 2,12.5 4,8 C 6,3.8 11,1.7 15,3 Z" Fill="#FFF7FA" />
                    </Canvas></Viewbox>
                </Button>
                <Button Grid.Column="16" Style="{StaticResource IconButton}" Click="Home_Click" ToolTip="{x:Static local:BrandInfo.OpenMainWindowTooltip}">
                    <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                        <Path Data="M 4,11.5 L 12,4.5 L 20,11.5 M 6.5,10 L 6.5,20 L 17.5,20 L 17.5,10 M 10,20 L 10,14 L 14,14 L 14,20"
                              Stroke="#FFF7FA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Canvas></Viewbox>
                </Button>
                <Button Grid.Column="18" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="关闭浮窗并打开主页">
                    <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24">
                        <Path Data="M 6.5,6.5 L 17.5,17.5 M 17.5,6.5 L 6.5,17.5" Stroke="#F1D8EC" StrokeThickness="1.9" StrokeStartLineCap="Round" />
                    </Canvas></Viewbox>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
