{
  "$schema": "../../schemas/theme-manifest-v2.schema.json",
  "schemaVersion": 2,
  "id": "example.advanced-theme",
  "name": "沉浸式主题示例",
  "version": "1.0.0",
  "author": "Theme Author",
  "description": "使用完整 mount/unmount 生命周期创建自定义界面。",
  "engineVersion": 2,
  "type": "advanced",
  "capabilities": {
    "light": true,
    "dark": true
  },
  "entryPoints": {
    "css": "theme.css",
    "script": "theme.js"
  },
  "previews": {
    "light": "assets/emblem.jpg",
    "dark": "assets/emblem.jpg"
  },
  "assets": {
    "emblem": "assets/emblem.jpg"
  },
  "config": {
    "label": "My Open Theme",
    "message": "这个组件完全由主题创建"
  },
  "compatibility": {
    "petOverlay": false
  }
}
