{
  "$schema": "../schemas/theme-artwork-defaults-v1.schema.json",
  "schemaVersion": 1,
  "themeId": "example.template-v1",
  "defaultsVersion": "1.0.0",
  "slots": {
    "hero": {
      "light": {
        "asset": "hero-light",
        "placement": {
          "size": { "width": "cover", "height": "auto" },
          "position": { "x": "center", "y": "center" },
          "scale": 1,
          "origin": { "x": "50%", "y": "50%" },
          "mirrorX": false,
          "mirrorY": false
        },
        "effects": {
          "brightness": 100,
          "contrast": 100,
          "saturation": 100,
          "opacity": 100,
          "grayscale": 0,
          "hueRotate": 0,
          "blur": 0,
          "blendMode": "normal",
          "overlay": { "color": "#000000", "opacity": 0 },
          "gradientVeil": { "enabled": false, "strength": 0, "layers": [] },
          "vignette": 0,
          "readabilityVeil": {
            "enabled": false,
            "color": "#000000",
            "opacity": 0,
            "directionDeg": 90,
            "rangeStart": 0,
            "rangeEnd": 100
          }
        },
        "motion": { "mode": "none" }
      },
